  "uutf" {= "1.0.4"}
  "variantslib" {= "v0.17.0"}
  "yojson" {= "2.2.2"}
  "zarith" {= "1.14"}
  "zarith_stubs_js" {= "v0.17.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
  "dune"
  "build"
  "-p"
  name
  "-j"
  jobs
  "--promote-install-files=false"
  "@install"
  "@runtest" {with-test}
  "@doc" {with-doc}
]
  ["dune" "install" "-p" name "--create-install-files" name]
]
