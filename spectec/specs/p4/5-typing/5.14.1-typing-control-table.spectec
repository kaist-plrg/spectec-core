;;;;; DEFAULT
;;;;; `( DEFAULT )


rule TableEntry_keyset_ok/simple-noprilpm:
  TC TBLC |- DEFAULT : TBLS DEFAULT
  -- if TBLC.MODE = LPM n
  -- if TBLS = LPM n

rule TableEntry_keyset_ok/simple-non-noprilpm:
  TC TBLC |- DEFAULT : TBLS DEFAULT
  -- if TBLC.MODE = NONE \/ TBLC.MODE = PRI
  -- if TBLS = NON_LPM

rule TableEntry_keyset_ok/tuple-noprilpm:
  TC TBLC |- `( DEFAULT `) : TBLS (`( DEFAULT `))
  -- if TBLC.MODE = LPM n
  -- if TBLS = LPM n

rule TableEntry_keyset_ok/tuple-non-noprilpm:
  TC TBLC |- `( DEFAULT `) : TBLS (`( DEFAULT `))
  -- if TBLC.MODE = NONE \/ TBLC.MODE = PRI
  -- if TBLS = NON_LPM


;;;;; '_'
;;;;; `( '_' )


rule TableEntry_keyset_ok/simple-noprilpm:
  TC TBLC |- '_' : TBLS '_'
  -- if TBLC.MODE = LPM n
  -- if TBLS = LPM 0

rule TableEntry_keyset_ok/simple-non-noprilpm:
  TC TBLC |- '_' : TBLS '_'
  -- if TBLC.MODE = NONE \/ TBLC.MODE = PRI
  -- if TBLS = NON_LPM

rule TableEntry_keyset_ok/tuple-noprilpm:
  TC TBLC |- `( '_' `) : TBLS (`( '_' `))
  -- if TBLC.MODE = LPM n
  -- if TBLS = LPM 0

rule TableEntry_keyset_ok/tuple-non-noprilpm:
  TC TBLC |- `( '_' `) : TBLS (`( '_' `))
  -- if TBLC.MODE = NONE \/ TBLC.MODE = PRI
  -- if TBLS = NON_LPM


;;;;; `( simpleKeysetExpression ',' simpleKeysetExpressionList )

rule TableEntry_keyset_ok/list:
  TC TBLC |- `( simpleKeysetExpression_h ',' simpleKeysetExpressionList_t `)
           : TBLS (`( simpleKeysetExpressionIR* `))
  ---- ;; check arity
  -- if simpleKeysetExpression_t*
      = $flatten_simpleKeysetExpressionList(simpleKeysetExpressionList_t)
  -- if simpleKeysetExpression*
      = simpleKeysetExpression_h :: simpleKeysetExpression_t*
  -- if |TBLC.KEYS| = |simpleKeysetExpression*|
  ---- ;; check keysets pairwise
  -- TableEntry_keysets_simple_ok:
      TC TBLC NON_LPM |- TBLC.KEYS '@' simpleKeysetExpression*
                       : TBLS simpleKeysetExpressionIR*

;;
;;;; Table entry action reference typing
;;;;
;;;; syntax tableActionReference
;;

;;; prefixedNonTypeName
;;; prefixedNonTypeName `( argumentList )


rule TableEntry_action_ok/prefixedNonTypeName:
  TC TBLC |- prefixedNonTypeName : prefixedNameIR eps `( eps `)
  ---- ;; find matching action
  -- if prefixedNameIR = $prefixedNonTypeName(prefixedNonTypeName)
  -- if (eps, eps) = $find_action(TBLC, prefixedNameIR)

rule TableEntry_action_ok/prefixedNonTypeName-argumentList:
  TC TBLC |- (prefixedNonTypeName `( argumentList `))
           : prefixedNameIR eps `( argumentIR_cast* `)
  ---- ;; find matching action
  -- if prefixedNameIR = $prefixedNonTypeName(prefixedNonTypeName)
  -- if (parameterIR_action*, argumentIR_action*)
      = $find_action(TBLC, prefixedNameIR)
  ---- ;; check arguments
  -- ArgumentList_ok:
      LOCAL TC |- argumentList : argumentIR*
  ---- ;; check calling convention
  -- Call_action_default_ok:
      TC |- parameterIR_action* '@' argumentIR*
          : parameterIR_action_data* ',' parameterIR_action_control*
            '@' argumentIR_cast*
  ---- ;; arguments must be syntatcially equivalent to
  ---- ;; dataplane arguments specified in the actions list property
  -- if argumentIR_action_data*
      = argumentIR_action*[0 : |parameterIR_action_data*|]
  -- if argumentIR_cast_data*
      = argumentIR_cast*[0 : |parameterIR_action_data*|]
  -- if (argumentIR_action_data = argumentIR_cast_data)*


;;
;;;; Table entry priority typing
;;;;
;;;; syntax tableEntryPriority
;;

;;;;; PRIORITY '=' number ':'

rule TableEntry_priority_ok/number:
  TC |- PRIORITY '=' integerLiteral ':'
      : PRIORITY '=' integerLiteral ':'

;;;;; PRIORITY '=' `( expression ) ':'

rule TableEntry_priority_ok/expression:
  TC |- PRIORITY '=' `( expression `) ':'
      : PRIORITY '=' (D n) ':'
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- Expr_eval_lctk: LOCAL TC |- typedExpressionIR ~> integerValue
  -- if n = $nat_of_integerValue(integerValue)

;;; constOpt tableEntryPriority
;;;   keysetExpression ':' tableActionReference annotationList ';'
;;; constOpt keysetExpression ':' tableActionReference annotationList ';'


rule TableEntry_ok/priority:
  TC TBLC |- constOpt tableEntryPriority
                keysetExpression ':' tableActionReference annotationList ';'
           : TBLS tableEntryIR
  ---- ;; check entry key
  -- TableEntry_keyset_ok:
      TC TBLC |- keysetExpression : TBLS keysetExpressionIR
  ---- ;; check entry action
  -- TableEntry_action_ok:
      TC TBLC |- tableActionReference : tableActionReferenceIR
  ---- ;; check entry priority
  -- TableEntry_priority_ok:
      TC |- tableEntryPriority : tableEntryPriorityIR
  ---- ;; create IR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tableEntryIR
      = constOptIR tableEntryPriorityIR
          keysetExpressionIR ':' tableActionReferenceIR annotationList ';'

rule TableEntry_ok/non-priority:
  TC TBLC |- constOpt
                keysetExpression ':' tableActionReference annotationList ';'
           : TBLS tableEntryIR
  ---- ;; check entry key
  -- TableEntry_keyset_ok:
      TC TBLC |- keysetExpression : TBLS keysetExpressionIR
  ---- ;; check entry action
  -- TableEntry_action_ok:
      TC TBLC |- tableActionReference : tableActionReferenceIR
  ---- ;; check entry priority
  ---- ;; create IR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tableEntryPriorityOptIR = eps
  -- if tableEntryIR
      = constOptIR tableEntryPriorityOptIR
          keysetExpressionIR ':' tableActionReferenceIR annotationList ';'


;;
;; Table property typing
;;
;; syntax tableProperty
;;

;;; KEY '=' `{ tableKeyList }

rule TableProperty_ok/key:
  TC TBLC_0 |- KEY '=' `{ tableKeyList `}
             : TBLC_2 (KEY '=' `{ tableKeyIR* `})
  -- if tableKey* = $flatten_tableKeyList(tableKeyList)
  -- TableKeys_ok:
      TC TBLC_0 |- tableKey* : TBLC_1 tableKeyIR*
  -- if TBLC_2 = $update_mode_tbl(TBLC_1, tableKeyIR*)

;;; ACTIONS '=' `{ tableActionList }

rule TableProperty_ok/actions:
  TC TBLC_0 |- ACTIONS '=' `{ tableActionList `}
             : TBLC_1 (ACTIONS '=' `{ tableActionIR* `})
  -- if tableAction* = $flatten_tableActionList(tableActionList)
  -- TableActions_ok:
      TC TBLC_0 |- tableAction* : TBLC_1 tableActionIR*

;;; annotationList constOpt ENTRIES '=' `{ tableEntryList }

rule TableProperty_ok/entries:
  TC TBLC_0 |- annotationList constOpt ENTRIES '=' `{ tableEntryList `}
             : TBLC_2 (annotationList constOptIR ENTRIES '=' `{ tableEntryIR_pri* `})
  ---- ;; if the table key is empty, then the table entries must be empty
  -- if tableEntry* = $flatten_tableEntryList(tableEntryList)
  -- if $(|TBLC_0.KEYS| = 0) => $(|tableEntry*| = 0)
  ---- ;; set size of table entries
  -- if TBLC_1 = TBLC_0[ .ENTRIES.SIZE = |tableEntry*| ]
  ---- ;; set whether the table entries is constant
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if TBLC_2 = TBLC_1[ .ENTRIES.CONST = (constOptIR = CONST) ]
  ---- ;; check table entries
  -- (TableEntry_ok: TC TBLC_2 |- tableEntry : TBLS tableEntryIR)*
  ---- ;; set priorities of table entries
  -- if tableEntryIR_pri*
      = $set_priorities_of_tableEntryListIR(TBLC_2, TBLS*, tableEntryIR*)

;;; annotationList constOpt tableCustomName initializer ';'

rule TableProperty_ok/default-action:
  TC TBLC |- annotationList constOpt tableCustomName initializer ';'
           : TBLC tablePropertyIR
  ---- ;; check that the custom property is for default action
  -- if "default_action" = $tableCustomName(tableCustomName)
  ---- ;; check the initializer
  -- TableDefaultAction_ok:
      TC TBLC |- initializer : tableActionReferenceIR
  ---- ;; create IR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
      = annotationList constOptIR DEFAULT_ACTION '=' tableActionReferenceIR ';'


rule TableProperty_ok/largest-priority-wins:
  TC TBLC_0 |- annotationList constOpt tableCustomName ('=' expression) ';'
            : TBLC_1 tablePropertyIR
  ---- ;; check that the custom property is for largest_priority_wins
  -- if "largest_priority_wins" = $tableCustomName(tableCustomName)
  ---- ;; check initializer
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- if BOOL = $unroll_typeIR(typeIR)
  -- Expr_eval_lctk:
      LOCAL TC |- typedExpressionIR ~> _B b_lw
  ---- ;; update table context
  -- if TBLC_1
      = TBLC_0 [ .PRIORITIES.LARGEST_WINS = b_lw ]
  ---- ;; create IR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
      = annotationList constOptIR CUSTOM_CONST
          "largest_priority_wins" ('=' _VALUE (_B b_lw)) ';'

rule TableProperty_ok/priority-delta:
  TC TBLC_0 |- annotationList constOpt tableCustomName ('=' expression) ';'
             : TBLC_1 tablePropertyIR
  ---- ;; check that the custom property is for priority_delta
  -- if "priority_delta" = $tableCustomName(tableCustomName)
  ---- ;; check initializer
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if (typeIR_unroll <: integerTypeIR)
        /\ ~(typeIR_unroll <: varBitTypeIR)
  -- Expr_eval_lctk:
      LOCAL TC |- typedExpressionIR ~> integerValue
  -- if n_delta = $nat_of_integerValue(integerValue)
  -- if $(n_delta > 0)
  ---- ;; update table context
  -- if TBLC_1 = TBLC_0 [ .PRIORITIES.DELTA = n_delta ]
  ---- ;; create IR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
      = annotationList constOptIR CUSTOM_CONST
          "priority_delta" ('=' _VALUE (D n_delta)) ';'



rule TableProperty_ok/size:
  TC TBLC |- annotationList constOpt tableCustomName ('=' expression) ';'
           : TBLC tablePropertyIR
  ---- ;; check that the custom property is for size
  -- if "size" = $tableCustomName(tableCustomName)
  ---- ;; check initializer
  -- Expr_ok:
      LOCAL TC |- expression : typedExpressionIR
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if (typeIR_unroll <: integerTypeIR)
        /\ ~(typeIR_unroll <: varBitTypeIR)
  ---- ;; create IR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
      = annotationList constOptIR CUSTOM "size" ('=' typedExpressionIR) ';'

rule TableProperty_ok/others:
  TC TBLC |- annotationList constOpt tableCustomName ('=' expression) ';'
           : TBLC tablePropertyIR
  ---- ;; check that the custom property is not one of the predefined ones
  -- if nameIR = $tableCustomName(tableCustomName)
  -- if nameIR =/= "default_action"
        /\ nameIR =/= "size"
        /\ nameIR =/= "largest_priority_wins"
        /\ nameIR =/= "priority_delta"
  ---- ;; check initializer
  -- Expr_ok:
      LOCAL TC |- expression : typedExpressionIR
  ---- ;; create IR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
      = annotationList constOptIR CUSTOM nameIR ('=' typedExpressionIR) ';'


;;
;; Table property list typing
;;
;; syntax tablePropertyList
;;


rule TableProperties_ok/nil:
  TC TBLC |- eps : TBLC eps

rule TableProperties_ok/cons:
  TC TBLC_0 |- (tableProperty_h :: tableProperty_t*)
             : TBLC_2 (tablePropertyIR_h :: tablePropertyIR_t*)
  -- TableProperty_ok:
      TC TBLC_0 |- tableProperty_h : TBLC_1 tablePropertyIR_h
  -- TableProperties_ok:
      TC TBLC_1 |- tableProperty_t* : TBLC_2 tablePropertyIR_t*


;;
;; Table typing
;;
;; syntax table
;;

dec $is_tableKeysProperty(tableProperty) : bool
def $is_tableKeysProperty(KEY '=' `{ _ `}) = true
def $is_tableKeysProperty(_) = false
  -- otherwise

dec $is_tableActionsProperty(tableProperty) : bool
def $is_tableActionsProperty(ACTIONS '=' `{ _ `}) = true
def $is_tableActionsProperty(_) = false
  -- otherwise

dec $is_tableDefaultActionProperty(tableProperty) : bool
def $is_tableDefaultActionProperty(_ _ tableCustomName _ ';') = true
  -- if "default_action" = $tableCustomName(tableCustomName)
def $is_tableDefaultActionProperty(_) = false
  -- otherwise

dec $insert_NoAction_tablePropertyIR(
    tableContext,
    tablePropertyIR*)
  : (tableContext, tablePropertyIR*)

def $insert_NoAction_tablePropertyIR(TBLC, eps) = (TBLC, eps)
def $insert_NoAction_tablePropertyIR(
    TBLC_0,
    tablePropertyIR_h :: tablePropertyIR_t*)
  = (TBLC_1, tablePropertyIR_h_updated :: tablePropertyIR_t*)
  ---- ;; check that NoAction is not already present in actions
  -- if ACTIONS '=' `{ tableActionIR* `} = tablePropertyIR_h
  -- if (_ tableActionReferenceIR '#' `( _ ',' _ `) ';' = tableActionIR)*
  -- if tableActionReferenceIR_NoAction = ('.' "NoAction") eps `( eps `)
  -- if ~(tableActionReferenceIR_NoAction <- tableActionReferenceIR*)
  ---- ;; insert NoAction to table context and table properties
  -- if TBLC_1 = $add_action_tbl(TBLC_0, '.' "NoAction", eps, eps)
  -- if tableActionIR_NoAction
      = _EMPTY tableActionReferenceIR_NoAction '#' `( eps ',' eps `) ';'
  -- if tablePropertyIR_h_updated
      = ACTIONS '=' `{ tableActionIR* ++ [ tableActionIR_NoAction ] `}
def $insert_NoAction_tablePropertyIR(
    TBLC_0,
    tablePropertyIR_h :: tablePropertyIR_t*)
  = (TBLC_0, tablePropertyIR_h :: tablePropertyIR_t*)
  ---- ;; check that NoAction is already present in actions
  -- if ACTIONS '=' `{ tableActionIR* `} = tablePropertyIR_h
  -- if (_ tableActionReferenceIR '#' `( _ ',' _ `) ';' = tableActionIR)*
  -- if tableActionReferenceIR_NoAction = ('.' "NoAction") eps `( eps `)
  -- if (tableActionReferenceIR_NoAction <- tableActionReferenceIR*)
def $insert_NoAction_tablePropertyIR(
    TBLC_0,
    tablePropertyIR_h :: tablePropertyIR_t*)
  = (TBLC_1, tablePropertyIR_h :: tablePropertyIR_t_updated*)
  -- if ~(tablePropertyIR_h <: tableActionsPropertyIR)
  -- if (TBLC_1, tablePropertyIR_t_updated*)
      = $insert_NoAction_tablePropertyIR(
          TBLC_0, tablePropertyIR_t*)


rule Table_ok/zero-default-action:
  TC |- tableProperty*
      : TBLC_2 (tablePropertyIR_updated* ++ [ tablePropertyIR_default_action ])
  ---- ;; check that the table has at most one key property
  -- if $(|$filter_<tableProperty>(
            tableProperty*, $is_tableKeysProperty(tableProperty)*)| <= 1)
  ---- ;; check that the table has exactly one action property
  -- if |$filter_<tableProperty>(
            tableProperty*, $is_tableActionsProperty(tableProperty)*)| = 1
  ---- ;; check that the table no default action property
  -- if |$filter_<tableProperty>(
          tableProperty*, $is_tableDefaultActionProperty(tableProperty)*)| = 0
  ---- ;; check table properties
  -- if TBLC_0 = $empty_tableContext
  -- TableProperties_ok: TC TBLC_0 |- tableProperty* : TBLC_1 tablePropertyIR*
  ---- ;; insert NoAction as default_action
  -- if tablePropertyIR_default_action
      = _EMPTY eps DEFAULT_ACTION '=' ((_NAME "NoAction") eps `( eps `)) ';'
  -- if (TBLC_2, tablePropertyIR_updated*)
      = $insert_NoAction_tablePropertyIR(TBLC_1, tablePropertyIR*)

rule Table_ok/one-default-action:
  TC |- tableProperty* : TBLC_1 tablePropertyIR*
  ---- ;; check that the table has at most one key property
  -- if $(|$filter_<tableProperty>(
            tableProperty*, $is_tableKeysProperty(tableProperty)*)| <= 1)
  ---- ;; check that the table has exactly one action property
  -- if |$filter_<tableProperty>(
          tableProperty*, $is_tableActionsProperty(tableProperty)*)| = 1
  ---- ;; check that the table has one default action property
  -- if |$filter_<tableProperty>(
          tableProperty*, $is_tableDefaultActionProperty(tableProperty)*)| = 1
  ---- ;; check table properties
  -- if TBLC_0 = $empty_tableContext
  -- TableProperties_ok: TC TBLC_0 |- tableProperty* : TBLC_1 tablePropertyIR*


rule TableType_ok:
  TC_0 TBLC |- name : TC_1 typeIR_table
  -- if nameIR = $name(name)
  ---- ;; create table enum type
  -- if typeId_enum = "action_list(" ++ nameIR ++ ")"
  -- if (prefixedNameIR_action `(  _ '@'  _ `))* = TBLC.ACTIONS
  -- if (nameIR_enum_field = $flatten_prefixedNameIR(prefixedNameIR_action))*
  -- if tableMetadataEnumTypeIR = TABLE_ENUM typeId_enum `{ nameIR_enum_field* `}
  ---- ;; add enum fields to context
  -- if (value_enum_field = TABLE_ENUM typeId_enum '.' nameIR_enum_field)*
  -- if (varTypeIR_enum_field
        = _EMPTY tableMetadataEnumTypeIR LCTK value_enum_field)*
  -- if TC_1
      = $add_vars_t(
          BLOCK, TC_0,
          (typeId_enum ++ "." ++ nameIR_enum_field)*,
          varTypeIR_enum_field*)
  ---- ;; create table struct type
  -- if typeId_struct = "apply_result(" ++ nameIR ++ ")"
  -- if tableMetadataStructTypeIR
      = TABLE_STRUCT typeId_struct
          `{ HIT BOOL ';' MISS BOOL ';' ACTION_RUN tableMetadataEnumTypeIR ';' `}
  ---- ;; create table type
  -- if typeIR_table = TABLE nameIR `{ tableMetadataStructTypeIR `}
