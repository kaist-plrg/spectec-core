ifdef::backend-html5[]
.Click to view the specification source
[%collapsible]
====
----
rule Eval_command/skip:
  env |- SKIP -| env

rule Eval_command/decl:
  env |- (t x = e) -| (x -> v) :: env
 -- Eval_expr: env |- e ==> v

rule Eval_command/assign:
  env |- (x = e) -| (x -> v) :: env
 -- Eval_expr: env |- e ==> v

rule Eval_command/ite-true:
  env |- (IF e THEN c_1 ELSE c_2 END) -| env_1
 -- Eval_expr: env |- e ==> (_BOOL true)
 -- Eval_command: env |- c_1 -| env_1

rule Eval_command/ite-false:
  env |- (IF e THEN c_1 ELSE c_2 END) -| env_2
 -- Eval_expr: env |- e ==> (_BOOL false)
 -- Eval_command: env |- c_2 -| env_2

rule Eval_command/while-false:
  env |- (WHILE e DO c END) -| env
 -- Eval_expr: env |- e ==> (_BOOL false)

rule Eval_command/while-true:
  env |- (WHILE e DO c END) -| env_2
 -- Eval_expr: env |- e ==> (_BOOL true)
 -- Eval_command: env |- c -| env_1
 -- Eval_command: env_1 |- (WHILE e DO c END) -| env_2

rule Eval_command/seq:
  env |- (c_1 ; c_2) -| env_2
 -- Eval_command: env |- c_1 -| env_1
 -- Eval_command: env_1 |- c_2 -| env_2
----
====

[.empty]
--


--

endif::[]

****
. If ``command`` matches pattern ``+++SKIP+++``:
 .. Result in ``env``.
. Else if let ``t x +++=+++ e`` be ``command``:
 .. Let xref:Eval_expr[``env ⊢ e ⟹ v``].
 .. Result in ``x → v {two-colons} env``.
. Else if let ``x +++=+++ e`` be ``command``:
 .. Let xref:Eval_expr[``env ⊢ e ⟹ v``].
 .. Result in ``x → v {two-colons} env``.
. Else if let ``+++IF+++ e +++THEN+++ c~1~ +++ELSE+++ c~2~ +++END+++`` be ``command``:
 .. Let xref:Eval_expr[``env ⊢ e ⟹ value``].
 .. If ``value`` is equal to ``true``:
  ... Let xref:Eval_command[``env ⊢ c~1~ ⊣ env~1~``].
  ... Result in ``env~1~``.
 .. Else if ``value`` is equal to ``false``:
  ... Let xref:Eval_command[``env ⊢ c~2~ ⊣ env~2~``].
  ... Result in ``env~2~``.
. Else if let ``+++WHILE+++ e +++DO+++ c +++END+++`` be ``command``:
 .. Let xref:Eval_expr[``env ⊢ e ⟹ value``].
 .. If ``value`` is equal to ``false``:
  ... Result in ``env``.
 .. Else if ``value`` is equal to ``true``:
  ... Let xref:Eval_command[``env ⊢ c ⊣ env~1~``].
  ... Let xref:Eval_command[``env~1~ ⊢ +++WHILE+++ e +++DO+++ c +++END+++ ⊣ env~2~``].
  ... Result in ``env~2~``.
. Else if let ``c~1~ +++;+++ c~2~`` be ``command``:
 .. Let xref:Eval_command[``env ⊢ c~1~ ⊣ env~1~``].
 .. Let xref:Eval_command[``env~1~ ⊢ c~2~ ⊣ env~2~``].
 .. Result in ``env~2~``.
****
