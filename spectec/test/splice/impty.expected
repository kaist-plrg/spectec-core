def $lookup<K, V>((K_h -> V_h) :: (K_t -> V_t)*, K_query) = V_h
 -- if K_h = K_query

def $lookup<K, V>((K_h -> V_h) :: (K_t -> V_t)*, K_query) = $lookup<K, V>((K_t -> V_t)*, K_query)
 -- otherwise
