    6. (Let Ci_1 be $add_value_inst((block), Ci_0', nameIR, ((! oid) as value)))

    7. (Let constantDeclarationIR be (() const typeIR nameIR (= ((! oid) as value)) ;))

    8. Result in Ci_1, sto_1, ?((constantDeclarationIR as controlLocalDeclarationIR))

