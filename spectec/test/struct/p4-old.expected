;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:136:26-136:51:
syntax headerStackType = 
   | namedType [ expression ] (from headerStackType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:144:19-144:41:
syntax listType = 
   | list < typeArgument > (from listType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:150:20-150:47:
syntax tupleType = 
   | tuple < typeArgumentList > (from tupleType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:157:1-161:14:
syntax type = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
   | bit (from baseType)
   | bit < int > (from baseType)
   | bit < ( expression ) > (from baseType)
   | varbit < int > (from baseType)
   | varbit < ( expression ) > (from baseType)
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)
   | prefixedTypeName < typeArgumentList > (from specializedType)
   | namedType [ expression ] (from headerStackType)
   | list < typeArgument > (from listType)
   | tuple < typeArgumentList > (from tupleType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:164:1-166:15:
syntax typeOrVoid = 
   | bool (from baseType)
   | error (from baseType)
