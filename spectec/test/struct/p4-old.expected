;; ../../../../../spectec/specs/p4-old/0-aux.spectec:41:1-41:23:
dec $init_(nat')

1. If ((nat' = 0)), then

  1. Return []

2. Otherwise

  1. Return (nat' - 1) :: $init_((nat' - 1))

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:46:1-46:29:
dec $repeat_<X>(X, nat')

1. If ((nat' = 0)), then

  1. Return []

2. Otherwise

  1. Return [X] ++ $repeat_<X>(X, (nat' - 1))

