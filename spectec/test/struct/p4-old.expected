   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:80:1-81:22:
syntax nameList = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)
   | nameList , name (from nameList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:83:1-83:40:
dec $flatten_nameList(nameList'')

1. If ((nameList'' has type name)), then

  1. (Let name be (nameList'' as name))

  2. Return [name]

1. Else Phantom#0

2. If ((nameList'' matches pattern `% , %`)), then

  1. (Let (nameList , name) be nameList'')

  2. Return $flatten_nameList(nameList) ++ [name]

2. Else Phantom#1

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:88:17-88:21:
