              1. Case (% = [])

                1. (Let int be $to_number((number as value)))

                2. If ((int has type nat)), then

                  1. (Let n be (int as nat))

                  2. (Let TBLC_1 be TBLC'[priorities.init = true])

                  3. (Let TBLC_2 be $add_table_priority(TBLC_1, n))

