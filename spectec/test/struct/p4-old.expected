   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
   | bit (from baseType)
   | bit < int > (from baseType)
   | bit < ( expression ) > (from baseType)
   | varbit < int > (from baseType)
   | varbit < ( expression ) > (from baseType)
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)
   | prefixedTypeName < typeArgumentList > (from specializedType)
   | namedType [ expression ] (from headerStackType)
   | list < typeArgument > (from listType)
   | tuple < typeArgumentList > (from tupleType)
   | void (from typeOrVoid)
   | text (from identifier)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:172:24-172:28:
syntax typeParameter = name

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:175:1-176:40:
syntax typeParameterList = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)
   | typeParameterList , typeParameter (from typeParameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:178:1-178:67:
dec $flatten_typeParameterList(typeParameterList'')

1. If ((typeParameterList'' has type typeParameter)), then

  1. (Let typeParameter be (typeParameterList'' as typeParameter))

  2. Return [typeParameter]

1. Else Phantom#2

2. If ((typeParameterList'' matches pattern `% , %`)), then

  1. (Let (typeParameterList , typeParameter) be typeParameterList'')

  2. Return $flatten_typeParameterList(typeParameterList) ++ [typeParameter]

2. Else Phantom#3

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:184:1-185:27:
syntax typeParameterListOpt = 
   |  (from typeParameterListOpt)
   | < typeParameterList > (from typeParameterListOpt)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:187:1-187:73:
dec $flatten_typeParameterListOpt(typeParameterListOpt)

1. Case analysis on typeParameterListOpt

  1. Case (% matches pattern `_EMPTY`)

    1. Return []

  2. Case (% matches pattern `<%>`)

    1. (Let (< typeParameterList >) be typeParameterListOpt)

    2. Return $flatten_typeParameterList(typeParameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:199:3-199:52:
syntax parameter = 
   | annotationList direction type name initializerOpt (from parameter)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:202:1-203:40:
syntax nonEmptyParameterList = 
   | annotationList direction type name initializerOpt (from parameter)
   | nonEmptyParameterList , parameter (from nonEmptyParameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:206:1-207:26:
syntax parameterList = 
   |  (from parameterList)
   | annotationList direction type name initializerOpt (from parameter)
   | nonEmptyParameterList , parameter (from nonEmptyParameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:209:1-209:55:
dec $flatten_parameterList(parameterList)

1. If ((parameterList matches pattern `_EMPTY`)), then

  1. Return []

1. Else Phantom#4

2. If ((parameterList has type parameter)), then

  1. (Let parameter be (parameterList as parameter))

  2. Return [parameter]

2. Else Phantom#5

3. If ((parameterList has type nonEmptyParameterList)), then

  1. (Let nonEmptyParameterList' be (parameterList as nonEmptyParameterList))

  2. If ((nonEmptyParameterList' matches pattern `% , %`)), then

    1. (Let (nonEmptyParameterList , parameter) be nonEmptyParameterList')

    2. Return $flatten_parameterList((nonEmptyParameterList as parameterList)) ++ [parameter]

  2. Else Phantom#6

3. Else Phantom#7

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:219:31-219:40:
syntax constructorParameter = parameter

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:221:35-221:48:
syntax constructorParameterList = parameterList

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:224:1-225:23:
syntax constructorParameterListOpt = 
   |  (from constructorParameterListOpt)
   | ( parameterList ) (from constructorParameterListOpt)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:227:1-228:26:
dec $flatten_constructorParameterListOpt(constructorParameterListOpt)

1. Case analysis on constructorParameterListOpt

  1. Case (% matches pattern `_EMPTY`)

    1. Return []

  2. Case (% matches pattern `(%)`)

    1. (Let (( parameterList )) be constructorParameterListOpt)

    2. Return $flatten_parameterList(parameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:238:26-238:45:
syntax namedExpression = 
   | name = expression (from namedExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:241:1-242:44:
syntax namedExpressionList = 
   | name = expression (from namedExpression)
   | namedExpressionList , namedExpression (from namedExpressionList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:244:1-244:73:
dec $flatten_namedExpressionList(namedExpressionList'')

1. If ((namedExpressionList'' has type namedExpression)), then

  1. (Let namedExpression be (namedExpressionList'' as namedExpression))

  2. Return [namedExpression]

1. Else Phantom#8

2. If ((namedExpressionList'' matches pattern `% , %`)), then

  1. (Let (namedExpressionList , namedExpression) be namedExpressionList'')

  2. Return $flatten_namedExpressionList(namedExpressionList) ++ [namedExpression]

2. Else Phantom#9

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:258:1-260:18:
syntax literalExpression = 
   | true (from literalExpression)
   | false (from literalExpression)
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:267:1-268:9:
syntax referenceExpression = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)
   | this (from referenceExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:274:28-274:33:
syntax defaultExpression = 
   | ... (from defaultExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:282:15-282:36:
syntax unop = 
   | ! (from unop)
   | ~ (from unop)
   | - (from unop)
   | + (from unop)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:284:26-284:41:
syntax unaryExpression = 
   | unop expression (from unaryExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:287:1-289:41:
syntax binop = 
   | * (from binop)
   | / (from binop)
   | % (from binop)
   | + (from binop)
   | - (from binop)
   | |+| (from binop)
   | |-| (from binop)
   | << (from binop)
   | >> (from binop)
   | <= (from binop)
   | >= (from binop)
   | < (from binop)
   | > (from binop)
   | != (from binop)
   | == (from binop)
   | & (from binop)
   | ^ (from binop)
   | | (from binop)
   | ++ (from binop)
   | && (from binop)
   | || (from binop)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:291:27-291:54:
syntax binaryExpression = 
   | expression binop expression (from binaryExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:294:3-294:38:
syntax binaryExpressionNonBrace = 
   | expressionNonBrace binop expression (from binaryExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:297:3-297:43:
syntax ternaryExpression = 
   | expression ? expression : expression (from ternaryExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:300:3-300:51:
syntax ternaryExpressionNonBrace = 
   | expressionNonBrace ? expression : expression (from ternaryExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:306:25-306:45:
syntax castExpression = 
   | ( type ) expression (from castExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:315:1-316:48:
syntax dataExpression = 
