          2. (Let (typedExpressionIR, typedExpressionIR)'? be $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_satplusminus))

          3. If (((typedExpressionIR, typedExpressionIR)'? matches pattern (_))), then

