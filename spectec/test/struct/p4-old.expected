            1. (Let (known as typeIR_post) be infer'')

            2. If (Cast_impl: typeIR_pre -> typeIR_post holds), then

              1. (Let constraint_updated be $update_map<tid, infer>(constraint, tid_h, (known as typeIR_post)))

              2. Return $merge_constraint'(constraint_pre, constraint_post, tid_t*, constraint_updated)

            2. Else Phantom#1416

            3. If (Cast_impl: typeIR_pre -> typeIR_post does not hold), then

