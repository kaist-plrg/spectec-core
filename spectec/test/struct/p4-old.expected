    2. (Let TC_1 be TC_0[block.kind = (extern)])

    3. (Let TC_2 be TC_1[block.frame = frame])

    4. (Let typeParameter* be $flatten_typeParameterListOpt(typeParameterListOpt))

    5. (Let tid_expl be $name(typeParameter))*

