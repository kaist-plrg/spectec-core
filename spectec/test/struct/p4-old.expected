      3. If ((tid* matches pattern [])), then

        1. If (Type_wf: $bound((block), TC_0) |- typeIR holds), then

          1. If ($is_assignable_typeIR(typeIR)), then

            1. (Expr_ok: (block) TC_0 |- expression_init : typedExpressionIR_init)

