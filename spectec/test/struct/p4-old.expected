;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:325:3-325:19:
syntax errorAccessExpression = 
   | error . member (from errorAccessExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:328:3-328:30:
syntax memberAccessExpression = 
   | memberAccessBase . member (from memberAccessExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:331:1-332:46:
syntax indexAccessExpression = 
   | expression [ expression ] (from indexAccessExpression)
   | expression [ expression : expression ] (from indexAccessExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:335:1-337:26:
syntax accessExpression = 
   | error . member (from errorAccessExpression)
   | memberAccessBase . member (from memberAccessExpression)
   | expression [ expression ] (from indexAccessExpression)
   | expression [ expression : expression ] (from indexAccessExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:340:3-340:38:
syntax memberAccessExpressionNonBrace = 
   | memberAccessBaseNonBrace . member (from memberAccessExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:343:1-344:54:
syntax indexAccessExpressionNonBrace = 
   | expressionNonBrace [ expression ] (from indexAccessExpressionNonBrace)
   | expressionNonBrace [ expression : expression ] (from indexAccessExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:347:1-349:34:
syntax accessExpressionNonBrace = 
   | error . member (from errorAccessExpression)
   | memberAccessBaseNonBrace . member (from memberAccessExpressionNonBrace)
   | expressionNonBrace [ expression ] (from indexAccessExpressionNonBrace)
   | expressionNonBrace [ expression : expression ] (from indexAccessExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:363:1-364:62:
syntax callExpression = 
   | callTarget ( argumentList ) (from callExpression)
   | routineTarget < realTypeArgumentList > ( argumentList ) (from callExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:367:1-368:70:
syntax callExpressionNonBrace = 
   | callTargetNonBrace ( argumentList ) (from callExpressionNonBrace)
   | routineTargetNonBrace < realTypeArgumentList > ( argumentList ) (from callExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:374:34-374:49:
syntax parenthesizedExpression = 
   | ( expression ) (from parenthesizedExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:381:1-391:28:
syntax expression = 
   | true (from literalExpression)
   | false (from literalExpression)
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)
   | this (from referenceExpression)
   | ... (from defaultExpression)
   | unop expression (from unaryExpression)
   | expression binop expression (from binaryExpression)
   | expression ? expression : expression (from ternaryExpression)
   | ( type ) expression (from castExpression)
   | {#} (from dataExpression)
   | { dataElementExpression trailingCommaOpt } (from dataExpression)
   | error . member (from errorAccessExpression)
   | memberAccessBase . member (from memberAccessExpression)
   | expression [ expression ] (from indexAccessExpression)
   | expression [ expression : expression ] (from indexAccessExpression)
   | callTarget ( argumentList ) (from callExpression)
   | routineTarget < realTypeArgumentList > ( argumentList ) (from callExpression)
   | ( expression ) (from parenthesizedExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:395:1-397:34:
syntax expressionList = 
   |  (from expressionList)
   | true (from literalExpression)
   | false (from literalExpression)
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | text (from identifier)
