        2. If ((infer matches pattern `KNOWN AS %`)), then

          1. (Let (known as typeIR_post) be infer)

          2. (Let constraint_updated be $update_map<tid, infer>(constraint, tid_h, (known as typeIR_post)))

          3. Return $merge_constraint'(constraint_pre, constraint_post, tid_t*, constraint_updated)

