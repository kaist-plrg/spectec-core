;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:715:3-717:29:
syntax packageTypeDeclarationIR = 
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:724:1-728:29:
syntax typeDeclarationIR = 
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedExpressionListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)
   | annotationList typedef typedefTypeIR nameIR ; (from typedefDeclarationIR)
   | annotationList type typeIR nameIR ; (from typedefDeclarationIR)
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR)
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR)
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:735:1-744:22:
syntax declarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR prefixedNameIR < typeArgumentListIR > ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR)
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR)
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDeclarationIR)
   | error { nameListIR } (from errorDeclarationIR)
   | match_kind { nameListIR } (from matchKindDeclarationIR)
   | annotationList extern functionPrototypeIR ; (from externFunctionDeclarationIR)
   | annotationList extern nameIR < typeParameterListIR , typeParameterListIR > { methodPrototypeListIR } (from externObjectDeclarationIR)
   | annotationList parser nameIR < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserDeclarationIR)
   | annotationList control nameIR < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlDeclarationIR)
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedExpressionListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)
   | annotationList typedef typedefTypeIR nameIR ; (from typedefDeclarationIR)
   | annotationList type typeIR nameIR ; (from typedefDeclarationIR)
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR)
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR)
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:750:22-750:40:
syntax p4programIR = 
   | declarationIR* ; (from p4programIR)

;; ../../../../../spectec/specs/p4-old/5.0-flow.spectec:5:15-5:25:
syntax flow = 
   | cont (from flow)
   | ret (from flow)

;; ../../../../../spectec/specs/p4-old/5.0-flow.spectec:9:1-9:34:
dec $join_flow(flow'', flow''')

1. If ((flow'' matches pattern `RET`)), then

  1. If ((flow''' matches pattern `RET`)), then

    1. Return (ret)

2. Otherwise

  1. Return (cont)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:5:20-5:47:
syntax varTypeIR = 
   | direction typeIR ctk value? (from varTypeIR)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:12:16-12:34:
syntax frame = map<id, varTypeIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:14:1-14:27:
dec $empty_frame

1. Return $empty_map<id, varTypeIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:18:16-18:35:
syntax tdenv = map<tid, typeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:20:1-20:27:
dec $empty_tdenv

1. Return $empty_map<tid, typeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:24:16-24:42:
syntax rdenv = map<rid, routineTypeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:26:1-26:27:
dec $empty_rdenv

1. Return $empty_map<rid, routineTypeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:30:16-30:46:
syntax cdenv = map<cid, constructorTypeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:32:1-32:27:
dec $empty_cdenv

1. Return $empty_map<cid, constructorTypeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:39:1-39:39:
dec $check_routine_name(id_l, id_r)

1. Return (id_l = id_r)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:42:1-42:37:
dec $check_arity(id_arg?*, id_param*)

1. Return (|id_arg?*| = |id_param*|)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:45:1-45:42:
dec $check_arity_more(id_arg?*, id_param*)

1. Return (|id_arg?*| > |id_param*|)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:48:1-48:42:
dec $check_arity_less(id_arg?*, id_param*)

1. Return (|id_arg?*| < |id_param*|)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:51:1-51:44:
dec $get_missing_parameters(id*, id_arg*)

1. Case analysis on id*

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let id_param_h :: id_param_t* be id*)

    2. If (~$in_set<id>(id_param_h, ({ id_arg* }))), then

      1. Return id_param_h :: $get_missing_parameters(id_param_t*, id_arg*)

2. Otherwise

  1. If ((id* matches pattern _ :: _)), then

    1. (Let id_param_h :: id_param_t* be id*)

    2. Return $get_missing_parameters(id_param_t*, id_arg*)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:68:1-68:61:
dec $find_match_named<V>(rid, V, id_arg*, pid'*)

1. (Let (id_param # bool_param) be pid')*

2. If ($eq_set<id>(({ id_arg* }), ({ id_param* }))), then

  1. Return ?((rid, V, []))

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:77:1-77:69:
dec $find_match_named_default<V>(rid, V, id_arg*, pid'*)

1. (Let (id_param # bool_param) be pid')*

2. (Let id_default* be $get_missing_parameters(id_param*, id_arg*))

3. If (($find_match_named<V>(rid, V, id_arg* ++ id_default*, (id_param # bool_param)*) =/= ?())), then

  1. Return ?((rid, V, id_default*))

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:91:1-91:74:
dec $find_match_unnamed_default<V>(rid, V, id_arg?*, pid*)

1. (Let (_pid*, (id_default # bool)*) be $partition_<pid>(pid*, |id_arg?*|))

2. If ((bool = true))*, then

  1. Return ?((rid, V, id_default*))

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:100:1-100:64:
dec $find_matching<V>(id_r, id_arg?*, id_arg''*, (id_r' ( pid_r''* )), V)

1. If (~$check_routine_name(id_r, id_r')), then

  1. Return ?()

1. Else Phantom#409

2. (Let (id_param' # bool_param') be pid_r'')*

3. If ($check_routine_name(id_r, id_r')), then

  1. If ($check_arity_more(id_arg?*, id_param'*)), then

    1. Return ?()

  1. Else Phantom#410

3. Else Phantom#411

4. If ((|id_arg''*| > 0)), then

  1. If ($check_routine_name(id_r, id_r')), then

    1. If ($check_arity(id_arg?*, id_param'*)), then

      1. Return $find_match_named<V>((id_r' ( (id_param' # bool_param')* )), V, id_arg''*, (id_param' # bool_param')*)

    1. Else Phantom#412

    2. If ($check_arity_less(id_arg?*, id_param'*)), then

      1. Return $find_match_named_default<V>((id_r' ( (id_param' # bool_param')* )), V, id_arg''*, (id_param' # bool_param')*)

    2. Else Phantom#413

  1. Else Phantom#414

4. Else Phantom#415

5. If ((id_arg''* matches pattern [])), then

  1. If ($check_routine_name(id_r, id_r')), then

    1. If ($check_arity(id_arg?*, id_param'*)), then

      1. Return ?(((id_r' ( (id_param' # bool_param')* )), V, []))

    1. Else Phantom#416

    2. If ($check_arity_less(id_arg?*, id_param'*)), then

      1. Return $find_match_unnamed_default<V>((id_r' ( (id_param' # bool_param')* )), V, id_arg?*, (id_param' # bool_param')*)

    2. Else Phantom#417

  1. Else Phantom#418

5. Else Phantom#419

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:159:1-159:67:
dec $find_matchings<V>(id_r, id_arg?*, id_arg'*, rid''*, V''*)

1. Case analysis on rid''*

  1. Case (% matches pattern [])

    1. If ((V''* matches pattern [])), then

      1. Return []

    1. Else Phantom#420

  2. Case (% matches pattern _ :: _)

    1. (Let rid_h :: rid_t* be rid''*)

    2. If ((V''* matches pattern _ :: _)), then

      1. (Let V_h :: V_t* be V''*)

      2. If (($find_matching<V>(id_r, id_arg?*, id_arg'*, rid_h, V_h) = ?())), then

        1. Return $find_matchings<V>(id_r, id_arg?*, id_arg'*, rid_t*, V_t*)

      2. Else Phantom#421

      3. (Let (rid, V, id*)? be $find_matching<V>(id_r, id_arg?*, id_arg'*, rid_h, V_h))

      4. If (((rid, V, id*)? matches pattern (_))), then

        1. (Let ?((rid, V, id_default*)) be (rid, V, id*)?)

        2. Return (rid, V, id_default*) :: $find_matchings<V>(id_r, id_arg?*, id_arg'*, rid_t*, V_t*)

      4. Else Phantom#422

    2. Else Phantom#423

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:181:1-181:66:
dec $find_overloaded<V>(({ (rid : V)* }), id_r, id_arg?*)

1. If ((|id_arg?*| > 0)), then

  1. (Let id? be id_arg?)*

  2. If ((id? matches pattern (_)))*, then

    1. (Let ?(id_arg') be id?)*

    2. If (($find_matchings<V>(id_r, id_arg?*, id_arg'*, rid*, V*) = [])), then

      1. Return ?()

    2. Else Phantom#424

    3. (Let (rid, V, id*)* be $find_matchings<V>(id_r, id_arg?*, id_arg'*, rid*, V*))

    4. If (((rid, V, id*)* matches pattern [ _/1 ])), then

      1. (Let [(rid', V', id_default*)] be (rid, V, id*)*)

      2. Return ?((rid', V', id_default*))

    4. Else Phantom#425

  2. Else Phantom#426

1. Else Phantom#427

2. If ((id_arg? = ?()))*, then

  1. If (($find_matchings<V>(id_r, id_arg?*, [], rid*, V*) = [])), then

    1. Return ?()

  1. Else Phantom#428

  2. (Let (rid, V, id*)* be $find_matchings<V>(id_r, id_arg?*, [], rid*, V*))

  3. If (((rid, V, id*)* matches pattern [ _/1 ])), then

    1. (Let [(rid', V', id_default*)] be (rid, V, id*)*)

    2. Return ?((rid', V', id_default*))

  3. Else Phantom#429

2. Else Phantom#430

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:218:1-218:50:
dec $find_non_overloaded<V>(({ (rid : V)* }), id)

1. (Let V''* be $find_non_overloaded'<V>(({ (rid : V)* }), id))

2. If ((V''* matches pattern [ _/1 ])), then

  1. (Let [V'] be V''*)

  2. Return ?(V')

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:219:1-219:51:
dec $find_non_overloaded'<V>(set<pair<rid, V>>', id)

1. If ((set<pair<rid, V>>' = ({ [] }))), then

  1. Return []

1. Else Phantom#431

2. (Let ({ pair<rid, V>* }) be set<pair<rid, V>>')

3. If ((pair<rid, V>* matches pattern _ :: _)), then

  1. (Let (rid_h : V_h) :: (rid_t : V_t)* be pair<rid, V>*)

  2. (Let (id' ( _pid* )) be rid_h)

  3. Case analysis on id'

    1. Case (% = id)

      1. (Let V_t_found* be $find_non_overloaded'<V>(({ (rid_t : V_t)* }), id))

      2. Return V_h :: V_t_found*

    2. Case (% =/= id)

      1. (Let V_t_found* be $find_non_overloaded'<V>(({ (rid_t : V_t)* }), id))

      2. Return V_t_found*

3. Else Phantom#432

