    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return ($is_parser_blockKind(TC.block.kind) \/ $is_control_blockKind(TC.block.kind))

  3. Case (% matches pattern `LOCAL`)

    1. Return true

