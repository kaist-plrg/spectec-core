;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:5:1-5:27:
dec $empty_theta

1. Return $empty_map<tid, typeIR>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:9:15-9:29:
syntax venv = map<id, value>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:11:1-11:25:
dec $empty_venv

1. Return $empty_map<id, value>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:15:19-15:41:
syntax stateDyn = parserBlockStatementIR

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:18:15-18:36:
syntax senv = map<nameIR, stateDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:20:1-20:25:
dec $empty_senv

1. Return $empty_map<nameIR, stateDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:28:1-31:35:
syntax lvalueDyn = 
   | nameIR (from prefixedNameIR)
   | . nameIR (from prefixedNameIR)
   | lvalueDyn . nameIR (from lvalueDyn)
   | lvalueDyn [ value ] (from lvalueDyn)
   | lvalueDyn [ value : value ] (from lvalueDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:40:1-43:96:
syntax funcDyn = 
   | builtin_function < typeParameterListIR > ( parameterListIR ) { blockElementStatementListIR } (from funcDyn)
   | function < typeParameterListIR > ( parameterListIR ) blockStatementIR (from funcDyn)
   | action ( parameterListIR ) { blockStatementIR } (from funcDyn)
   | extern_function < typeParameterListIR > ( parameterListIR ) { blockElementStatementIR? } (from funcDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:46:1-51:41:
syntax methodDyn = 
   | builtin_method ( parameterListIR ) # lvalueDyn (from methodDyn)
   | extern_method < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from methodDyn)
   | extern_method abstract < typeParameterListIR > ( parameterListIR ) (from methodDyn)
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; senv } (from methodDyn)
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; renv ; blockElementStatementListIR } (from methodDyn)
   | table_apply { tablePropertyListIR } (from methodDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:54:1-55:14:
syntax routineDyn = 
   | builtin_function < typeParameterListIR > ( parameterListIR ) { blockElementStatementListIR } (from funcDyn)
   | function < typeParameterListIR > ( parameterListIR ) blockStatementIR (from funcDyn)
   | action ( parameterListIR ) { blockStatementIR } (from funcDyn)
   | extern_function < typeParameterListIR > ( parameterListIR ) { blockElementStatementIR? } (from funcDyn)
   | builtin_method ( parameterListIR ) # lvalueDyn (from methodDyn)
   | extern_method < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from methodDyn)
   | extern_method abstract < typeParameterListIR > ( parameterListIR ) (from methodDyn)
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; senv } (from methodDyn)
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; renv ; blockElementStatementListIR } (from methodDyn)
   | table_apply { tablePropertyListIR } (from methodDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:58:15-58:35:
syntax renv = map<rid, routineDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:60:1-60:25:
dec $empty_renv

1. Return $empty_map<rid, routineDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:68:1-72:42:
syntax consDyn = 
   | extern nameIR < typeParameterListIR > ( constructorParameterListIR ) { methodPrototypeListIR } (from consDyn)
   | parser < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from consDyn)
   | control < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from consDyn)
   | package < typeParameterListIR > ( constructorParameterListIR ) (from consDyn)
   | table nameIR { tablePropertyListIR } (from consDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:75:15-75:32:
syntax cenv = map<cid, consDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:77:1-77:25:
dec $empty_cenv

1. Return $empty_map<cid, consDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:85:1-89:44:
syntax objDyn = 
   | extern { tid theta venv renv } (from objDyn)
   | parser { venv parameterListIR parserLocalDeclarationListIR senv } (from objDyn)
   | control { venv parameterListIR controlLocalDeclarationListIR renv controlBodyIR } (from objDyn)
   | package { theta venv } (from objDyn)
   | table { tid venv tablePropertyListIR } (from objDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:92:14-92:30:
syntax sto = map<oid, objDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:94:1-94:23:
dec $empty_sto

1. Return $empty_map<oid, objDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:98:1-98:37:
dec $add_sto(sto, oid, objDyn)

1. Return $add_map<oid, objDyn>(sto, oid, objDyn)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:8:3-11:16:
syntax globalInstantiationLayer = {cenv cenv, tdenv tdenv, renv renv, venv venv}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:16:3-19:16:
syntax blockInstantiationLayer = {theta theta, renv renv, senv senv, venv venv}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:24:3-25:18:
syntax localInstantiationLayer = {theta theta, venvs venv*}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:32:3-35:36:
syntax contextInst = {path oid, global globalInstantiationLayer, block blockInstantiationLayer, local localInstantiationLayer}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:43:1-43:45:
dec $empty_block

1. Return {theta $empty_theta, renv $empty_renv, senv $empty_senv, venv $empty_venv}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:51:1-51:45:
dec $empty_local

1. Return {theta $empty_theta, venvs []}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:57:1-57:40:
dec $empty_context_inst

1. (Let globalInstantiationLayer be {cenv $empty_cenv, tdenv $empty_tdenv, renv $empty_renv, venv $empty_venv})

2. (Let blockInstantiationLayer be $empty_block)

3. (Let localInstantiationLayer be $empty_local)

4. (Let Ci be {path [], global globalInstantiationLayer, block blockInstantiationLayer, local localInstantiationLayer})

5. Return Ci

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:78:1-78:43:
dec $enter_inst(Ci)

1. Return Ci[local.venvs = $empty_venv :: Ci.local.venvs]

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:82:1-82:42:
dec $exit_inst(Ci)

1. (Let venv* be Ci.local.venvs)

2. If ((venv* matches pattern _ :: _)), then

  1. (Let venv_h :: venv_t* be venv*)

  2. Return Ci[local.venvs = venv_t*]

2. Else Phantom#1431

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:91:1-91:47:
dec $enter_path(Ci, id)

1. Return Ci[path = Ci.path ++ [id]]

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:99:1-99:58:
dec $copy_context_inst(cursor, Ci)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return Ci[block = $empty_block][local = $empty_local]

  2. Case (% matches pattern `BLOCK`)

    1. Return Ci[local = $empty_local]

  3. Case (% matches pattern `LOCAL`)

    1. Return Ci

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:111:1-111:65:
dec $add_value_inst(cursor, Ci, id, value)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(Ci.global.venv))), then

      1. (Let venv be $add_map<id, value>(Ci.global.venv, id, value))

      2. Return Ci[global.venv = venv]

    1. Else Phantom#1432

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(Ci.block.venv))), then

      1. (Let venv be $add_map<id, value>(Ci.block.venv, id, value))

      2. Return Ci[block.venv = venv]

    1. Else Phantom#1433

  3. Case (% matches pattern `LOCAL`)

    1. (Let venv* be Ci.local.venvs)

    2. If ((venv* matches pattern _ :: _)), then

      1. (Let venv_h :: venv_t* be venv*)

      2. If (~$in_set<id>(id, $dom_map<id, value>(venv_h))), then

        1. (Let venv_h' be $add_map<id, value>(venv_h, id, value))

        2. Return Ci[local.venvs = venv_h' :: venv_t*]

      2. Else Phantom#1434

    2. Else Phantom#1435

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:112:1-112:68:
dec $add_values_inst(p, Ci, id*, value*)

1. Case analysis on id*

  1. Case (% matches pattern [])

    1. If ((value* matches pattern [])), then

      1. Return Ci

    1. Else Phantom#1436

  2. Case (% matches pattern _ :: _)

    1. (Let id_h :: id_t* be id*)

    2. If ((value* matches pattern _ :: _)), then

      1. (Let value_h :: value_t* be value*)

      2. (Let Ci' be $add_value_inst(p, Ci, id_h, value_h))

      3. (Let Ci'' be $add_values_inst(p, Ci', id_t*, value_t*))

      4. Return Ci''

    2. Else Phantom#1437

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:132:1-132:73:
dec $add_typedef_inst(cursor, Ci, tid, typeDefIR)

1. If ((cursor matches pattern `GLOBAL`)), then

  1. (Let tdenv be $add_map<tid, typeDefIR>(Ci.global.tdenv, tid, typeDefIR))

  2. Return Ci[global.tdenv = tdenv]

1. Else Phantom#1438

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:139:1-139:73:
dec $add_state_inst(cursor, Ci, nameIR, stateDyn)

1. If ((cursor matches pattern `BLOCK`)), then

  1. If (~$in_set<nameIR>(nameIR, $dom_map<nameIR, stateDyn>(Ci.block.senv))), then

    1. (Let senv be $add_map<nameIR, stateDyn>(Ci.block.senv, nameIR, stateDyn))

    2. Return Ci[block.senv = senv]

  1. Else Phantom#1439

1. Else Phantom#1440

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:147:1-147:70:
dec $add_types_inst(p, Ci, tid*, typeIR*)

1. Case analysis on tid*

  1. Case (% matches pattern [])

    1. If ((typeIR* matches pattern [])), then

      1. Return Ci

    1. Else Phantom#1441

  2. Case (% matches pattern _ :: _)

    1. (Let tid_h :: tid_t* be tid*)

    2. If ((typeIR* matches pattern _ :: _)), then

      1. (Let typeIR_h :: typeIR_t* be typeIR*)

      2. (Let Ci' be $add_type_inst(p, Ci, tid_h, typeIR_h))

      3. Return $add_types_inst(p, Ci', tid_t*, typeIR_t*)

    2. Else Phantom#1442

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:148:1-148:67:
dec $add_type_inst(cursor, Ci, tid, typeIR)

1. Case analysis on cursor

  1. Case (% matches pattern `BLOCK`)

    1. (Let theta be $add_map<tid, typeIR>(Ci.block.theta, tid, typeIR))

    2. Return Ci[block.theta = theta]

  2. Case (% matches pattern `LOCAL`)

    1. (Let theta be $add_map<tid, typeIR>(Ci.local.theta, tid, typeIR))

    2. Return Ci[local.theta = theta]

1. Else Phantom#1443

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:162:1-162:83:
dec $add_routine_overload_inst(cursor, Ci, rid, routineDyn)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<rid>(rid, $dom_map<rid, routineDyn>(Ci.global.renv))), then

      1. (Let renv be $add_map<rid, routineDyn>(Ci.global.renv, rid, routineDyn))

      2. Return Ci[global.renv = renv]

    1. Else Phantom#1444

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<rid>(rid, $dom_map<rid, routineDyn>(Ci.block.renv))), then

      1. (Let renv be $add_map<rid, routineDyn>(Ci.block.renv, rid, routineDyn))

      2. Return Ci[block.renv = renv]

    1. Else Phantom#1445

1. Else Phantom#1446

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:171:1-171:87:
dec $add_routine_non_overload_inst(cursor, Ci, rid, routineDyn)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. (Let (id ( _pid* )) be rid)

    2. (Let ({ (id_k ( _pid'* ))* }) be $dom_map<rid, routineDyn>(Ci.global.renv))

    3. If (~$in_set<id>(id, ({ id_k* }))), then

      1. (Let renv be $add_map<rid, routineDyn>(Ci.global.renv, rid, routineDyn))

      2. Return Ci[global.renv = renv]

    3. Else Phantom#1447

  2. Case (% matches pattern `BLOCK`)

    1. (Let (id ( _pid* )) be rid)

    2. (Let ({ (id_k ( _pid'* ))* }) be $dom_map<rid, routineDyn>(Ci.block.renv))

    3. If (~$in_set<id>(id, ({ id_k* }))), then

      1. (Let renv be $add_map<rid, routineDyn>(Ci.block.renv, rid, routineDyn))

      2. Return Ci[block.renv = renv]

    3. Else Phantom#1448

1. Else Phantom#1449

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:186:1-186:75:
dec $add_constructor_inst(cursor, Ci, cid, consDyn)

1. If ((cursor matches pattern `GLOBAL`)), then

  1. (Let cenv be $add_map<cid, consDyn>(Ci.global.cenv, cid, consDyn))

  2. Return Ci[global.cenv = cenv]

1. Else Phantom#1450

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:197:1-197:66:
dec $find_value_inst(p', Ci, prefixedNameIR)

1. If ((prefixedNameIR matches pattern `. %`)), then

  1. (Let (. id) be prefixedNameIR)

  2. (Let value'? be $find_map<id, value>(Ci.global.venv, id))

  3. If ((value'? matches pattern (_))), then

    1. (Let ?(value) be value'?)

    2. Return value

  3. Else Phantom#1451

1. Else Phantom#1452

2. Case analysis on p'

  1. Case (% matches pattern `GLOBAL`)

    1. If ((prefixedNameIR matches pattern `_NAME %`)), then

      1. (Let (id) be prefixedNameIR)

      2. (Let value'? be $find_map<id, value>(Ci.global.venv, id))

      3. If ((value'? matches pattern (_))), then

        1. (Let ?(value) be value'?)

        2. Return value

      3. Else Phantom#1453

    1. Else Phantom#1454

  2. Case (% matches pattern `BLOCK`)

    1. If ((prefixedNameIR matches pattern `_NAME %`)), then

      1. (Let (id) be prefixedNameIR)

      2. (Let value'? be $find_map<id, value>(Ci.block.venv, id))

      3. If ((value'? matches pattern (_))), then

        1. (Let ?(value) be value'?)

        2. Return value

      3. Else Phantom#1455

      4. If (($find_map<id, value>(Ci.block.venv, id) = ?())), then

        1. Return $find_value_inst((global), Ci, (id))

      4. Else Phantom#1456

    1. Else Phantom#1457

  3. Case (% matches pattern `LOCAL`)

    1. If ((prefixedNameIR matches pattern `_NAME %`)), then

      1. (Let (id) be prefixedNameIR)

      2. (Let venv* be Ci.local.venvs)

      3. (Let value'? be $find_maps<id, value>(venv*, id))

      4. If ((value'? matches pattern (_))), then

        1. (Let ?(value) be value'?)

        2. Return value

      4. Else Phantom#1458

      5. If (($find_maps<id, value>(Ci.local.venvs, id) = ?())), then

        1. Return $find_value_inst((block), Ci, (id))

      5. Else Phantom#1459

    1. Else Phantom#1460

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:219:1-219:73:
dec $find_typedef_inst(_cursor, Ci, prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern `_NAME %`)

    1. (Let (nameIR) be prefixedNameIR)

    2. Return $find_map<tid, typeDefIR>(Ci.global.tdenv, nameIR)

  2. Case (% matches pattern `. %`)

    1. (Let (. nameIR) be prefixedNameIR)

    2. Return $find_map<tid, typeDefIR>(Ci.global.tdenv, nameIR)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:228:1-228:44:
dec $ids_arguments_IR(argumentIR*)

1. Return $id_argument_IR(argumentIR)*

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:229:1-229:38:
dec $id_argument_IR(argumentIR)

1. If ((argumentIR has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

  2. Return ?()

1. Else Phantom#1461

2. Case analysis on argumentIR

  1. Case (% matches pattern `% = %`)

    1. (Let (nameIR = _typedExpressionIR) be argumentIR)

    2. Return ?(nameIR)

  2. Case (% matches pattern `% = _`)

    1. (Let (nameIR = _) be argumentIR)

    2. Return ?(nameIR)

  3. Case (% matches pattern `_`)

    1. Return ?()

2. Else Phantom#1462

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:237:1-237:103:
dec $find_constructor_overloaded_inst(Ci, prefixedNameIR, argumentIR*)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern `_NAME %`)

    1. (Let (id) be prefixedNameIR)

    2. (Let id_arg?* be $ids_arguments_IR(argumentIR*))

    3. Return $find_overloaded<consDyn>(Ci.global.cenv, id, id_arg?*)

  2. Case (% matches pattern `. %`)

    1. (Let (. id) be prefixedNameIR)

    2. (Let id_arg?* be $ids_arguments_IR(argumentIR*))

    3. Return $find_overloaded<consDyn>(Ci.global.cenv, id, id_arg?*)

;; ../../../../../spectec/specs/p4-old/6.03-instantiation-relation.spectec:6:1-8:35:
relation Constructor_inst: p, Ci, sto_0', consDyn, typeArgumentIR*, argumentIR*, id_default*

1. Case analysis on consDyn

  1. Case (% matches pattern `EXTERN % <%> (%) {%}`)

    1. (Let (extern nameIR < typeParameterIR* > ( constructorParameterIR* ) { methodPrototypeIR* }) be consDyn)

    2. (Let p_callee be (block))

    3. (Let Ci_callee_0 be $copy_context_inst((global), Ci))

    4. (Let Ci_callee_1 be $add_types_inst(p_callee, Ci_callee_0, typeParameterIR*, typeArgumentIR*))

    5. (Let (constructorParameterIR_aligned*, argumentIR_aligned*, constructorParameterIR_default*, value_default*) be $align_cparams_with_args(constructorParameterIR*, argumentIR*, id_default*))

    6. (Let (_annotationList _direction _typeIR id_aligned _constantInitializerOptIR) be constructorParameterIR_aligned)*

    7. (Bind_args: p Ci ; p_callee Ci_callee_1 sto_0' |- id_aligned* argumentIR_aligned* ==> Ci_callee_2 sto_1)

    8. (Let (_annotationList' _direction' _typeIR' id_cparam_default _constantInitializerOptIR') be constructorParameterIR_default)*

    9. (Let Ci_callee_3 be $add_values_inst(p_callee, Ci_callee_2, id_cparam_default*, value_default*))

    10. (ExternMethods_inst: Ci_callee_3 |- methodPrototypeIR* ==> Ci_callee_4)

    11. (Let objDyn be (extern { nameIR Ci_callee_4.block.theta Ci_callee_4.block.venv Ci_callee_4.block.renv }))

    12. Result in sto_1, objDyn

