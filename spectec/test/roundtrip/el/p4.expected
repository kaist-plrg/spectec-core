  | LOOP
  | NOLOOP

var l : loopctxt

relation Stmt_ok:
  cursor typingContext flow loopctxt
    |- statement
    : typingContext flow statementIR
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "typing" %4#", under context" %1#", abstract control flow" %2#", and loop context"
                %3
                "at"
                %0)
  hint(prose_out "context" %5#", abstract control flow" %6#", and" %7)

