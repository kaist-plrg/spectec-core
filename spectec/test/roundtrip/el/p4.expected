rule TableEntry_action_ok/prefixedNonTypeName:
  TC TBLC |- prefixedNonTypeName : prefixedNameIR eps `(eps)
  -- if prefixedNameIR = $prefixedNonTypeName(prefixedNonTypeName)
  -- if (eps, eps) = $find_action(TBLC, prefixedNameIR)

rule TableEntry_action_ok/prefixedNonTypeName-argumentList:
  TC TBLC
    |- (prefixedNonTypeName `(argumentList))
    : prefixedNameIR eps `(argumentIR_cast*)
  -- if prefixedNameIR = $prefixedNonTypeName(prefixedNonTypeName)
  -- if (parameterIR_action*, argumentIR_action*)
        = $find_action(TBLC, prefixedNameIR)
  -- ArgumentList_ok: LOCAL TC |- argumentList : argumentIR*
  -- Call_action_default_ok:
       TC
         |- parameterIR_action* '@' argumentIR*
         : parameterIR_action_data*
           ','
           parameterIR_action_control*
           '@'
           argumentIR_cast*
  -- if argumentIR_action_data*
        = argumentIR_action*[0 : |parameterIR_action_data*|]
  -- if argumentIR_cast_data* = argumentIR_cast*[0 : |parameterIR_action_data*|]
  -- (if (argumentIR_action_data = argumentIR_cast_data))*

rule TableEntry_priority_ok/number:
  TC |- PRIORITY '=' integerLiteral ':' : PRIORITY '=' integerLiteral ':'

rule TableEntry_priority_ok/expression:
  TC |- PRIORITY '=' `(expression) ':' : PRIORITY '=' (D n) ':'
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- Expr_eval_lctk: LOCAL TC |- typedExpressionIR ~> integerValue
  -- if n = $nat_of_integerValue(integerValue)

rule TableEntry_ok/priority:
  TC TBLC
    |- constOpt
       tableEntryPriority
       keysetExpression
       ':'
       tableActionReference
       annotationList
       ';'
    : TBLS tableEntryIR
  -- TableEntry_keyset_ok: TC TBLC |- keysetExpression : TBLS keysetExpressionIR
  -- TableEntry_action_ok:
       TC TBLC |- tableActionReference : tableActionReferenceIR
  -- TableEntry_priority_ok: TC |- tableEntryPriority : tableEntryPriorityIR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tableEntryIR
        = constOptIR
          tableEntryPriorityIR
          keysetExpressionIR
          ':'
          tableActionReferenceIR
          annotationList
          ';'

rule TableEntry_ok/non-priority:
  TC TBLC
    |- constOpt keysetExpression ':' tableActionReference annotationList ';'
    : TBLS tableEntryIR
  -- TableEntry_keyset_ok: TC TBLC |- keysetExpression : TBLS keysetExpressionIR
  -- TableEntry_action_ok:
       TC TBLC |- tableActionReference : tableActionReferenceIR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tableEntryPriorityOptIR = eps
  -- if tableEntryIR
        = constOptIR
          tableEntryPriorityOptIR
          keysetExpressionIR
          ':'
          tableActionReferenceIR
          annotationList
          ';'

rule TableProperty_ok/key:
  TC TBLC_0 |- KEY '=' `{tableKeyList} : TBLC_2 (KEY '=' `{tableKeyIR*})
  -- if tableKey* = $flatten_tableKeyList(tableKeyList)
  -- TableKeys_ok: TC TBLC_0 |- tableKey* : TBLC_1 tableKeyIR*
  -- if TBLC_2 = $update_mode_tbl(TBLC_1, tableKeyIR*)

rule TableProperty_ok/actions:
  TC TBLC_0
    |- ACTIONS '=' `{tableActionList}
    : TBLC_1 (ACTIONS '=' `{tableActionIR*})
  -- if tableAction* = $flatten_tableActionList(tableActionList)
  -- TableActions_ok: TC TBLC_0 |- tableAction* : TBLC_1 tableActionIR*

rule TableProperty_ok/entries:
  TC TBLC_0
    |- annotationList constOpt ENTRIES '=' `{tableEntryList}
    : TBLC_2 (annotationList constOptIR ENTRIES '=' `{tableEntryIR_pri*})
  -- if tableEntry* = $flatten_tableEntryList(tableEntryList)
  -- if |TBLC_0.KEYS| = 0 => |tableEntry*| = 0
  -- if TBLC_1 = TBLC_0[.ENTRIES.SIZE = |tableEntry*|]
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if TBLC_2 = TBLC_1[.ENTRIES.CONST = (constOptIR = CONST)]
  -- (TableEntry_ok: TC TBLC_2 |- tableEntry : TBLS tableEntryIR)*
  -- if tableEntryIR_pri*
        = $set_priorities_of_tableEntryListIR(TBLC_2, TBLS*, tableEntryIR*)

rule TableProperty_ok/default-action:
  TC TBLC
    |- annotationList constOpt tableCustomName initializer ';'
    : TBLC tablePropertyIR
  -- if "default_action" = $tableCustomName(tableCustomName)
  -- TableDefaultAction_ok: TC TBLC |- initializer : tableActionReferenceIR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
        = annotationList
          constOptIR
          DEFAULT_ACTION
          '='
          tableActionReferenceIR
          ';'

rule TableProperty_ok/largest-priority-wins:
  TC TBLC_0
    |- annotationList constOpt tableCustomName ('=' expression) ';'
    : TBLC_1 tablePropertyIR
  -- if "largest_priority_wins" = $tableCustomName(tableCustomName)
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- if BOOL = $unroll_typeIR(typeIR)
  -- Expr_eval_lctk: LOCAL TC |- typedExpressionIR ~> _B b_lw
  -- if TBLC_1 = TBLC_0[.PRIORITIES.LARGEST_WINS = b_lw]
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
        = annotationList
          constOptIR
          CUSTOM_CONST
          "largest_priority_wins"
          ('=' _VALUE (_B b_lw))
          ';'

rule TableProperty_ok/priority-delta:
  TC TBLC_0
    |- annotationList constOpt tableCustomName ('=' expression) ';'
    : TBLC_1 tablePropertyIR
  -- if "priority_delta" = $tableCustomName(tableCustomName)
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if (typeIR_unroll <: integerTypeIR) /\ ~(typeIR_unroll <: varBitTypeIR)
  -- Expr_eval_lctk: LOCAL TC |- typedExpressionIR ~> integerValue
  -- if n_delta = $nat_of_integerValue(integerValue)
  -- if $(n_delta > 0)
  -- if TBLC_1 = TBLC_0[.PRIORITIES.DELTA = n_delta]
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
        = annotationList
          constOptIR
          CUSTOM_CONST
          "priority_delta"
          ('=' _VALUE (D n_delta))
          ';'

rule TableProperty_ok/size:
  TC TBLC
    |- annotationList constOpt tableCustomName ('=' expression) ';'
    : TBLC tablePropertyIR
  -- if "size" = $tableCustomName(tableCustomName)
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if (typeIR_unroll <: integerTypeIR) /\ ~(typeIR_unroll <: varBitTypeIR)
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
        = annotationList constOptIR CUSTOM "size" ('=' typedExpressionIR) ';'

rule TableProperty_ok/others:
  TC TBLC
    |- annotationList constOpt tableCustomName ('=' expression) ';'
    : TBLC tablePropertyIR
  -- if nameIR = $tableCustomName(tableCustomName)
  -- if nameIR =/= "default_action" /\ nameIR =/= "size"
        /\ nameIR =/= "largest_priority_wins"
        /\ nameIR =/= "priority_delta"
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if constOptIR = $flatten_constOpt(constOpt)
  -- if tablePropertyIR
        = annotationList constOptIR CUSTOM nameIR ('=' typedExpressionIR) ';'

rule TableProperties_ok/nil:
  TC TBLC |- eps : TBLC eps

rule TableProperties_ok/cons:
  TC TBLC_0
    |- (tableProperty_h :: tableProperty_t*)
    : TBLC_2 (tablePropertyIR_h :: tablePropertyIR_t*)
  -- TableProperty_ok: TC TBLC_0 |- tableProperty_h : TBLC_1 tablePropertyIR_h
  -- TableProperties_ok:
       TC TBLC_1 |- tableProperty_t* : TBLC_2 tablePropertyIR_t*

dec $is_tableKeysProperty(tableProperty) : bool

def $is_tableKeysProperty(KEY '=' `{_}) = true

def $is_tableKeysProperty(_) = false
  -- otherwise

dec $is_tableActionsProperty(tableProperty) : bool

def $is_tableActionsProperty(ACTIONS '=' `{_}) = true

def $is_tableActionsProperty(_) = false
  -- otherwise

dec $is_tableDefaultActionProperty(tableProperty) : bool

def $is_tableDefaultActionProperty(_ _ tableCustomName _ ';') = true
  -- if "default_action" = $tableCustomName(tableCustomName)

def $is_tableDefaultActionProperty(_) = false
  -- otherwise

dec $insert_NoAction_tablePropertyIR(tableContext, tablePropertyIR*)
  : (tableContext, tablePropertyIR*)

def $insert_NoAction_tablePropertyIR(TBLC, eps) = (TBLC, eps)

def $insert_NoAction_tablePropertyIR(TBLC_0,
                                     tablePropertyIR_h :: tablePropertyIR_t*)
  = (TBLC_1, tablePropertyIR_h_updated :: tablePropertyIR_t*)
  -- if ACTIONS '=' `{tableActionIR*} = tablePropertyIR_h
  -- (if (_ tableActionReferenceIR '#' `(_ ',' _) ';' = tableActionIR))*
  -- if tableActionReferenceIR_NoAction = ('.' "NoAction") eps `(eps)
  -- if ~(tableActionReferenceIR_NoAction <- tableActionReferenceIR*)
  -- if TBLC_1 = $add_action_tbl(TBLC_0, '.' "NoAction", eps, eps)
  -- if tableActionIR_NoAction
        = _EMPTY tableActionReferenceIR_NoAction '#' `(eps ',' eps) ';'
  -- if tablePropertyIR_h_updated
        = ACTIONS '=' `{tableActionIR* ++ [tableActionIR_NoAction]}

def $insert_NoAction_tablePropertyIR(TBLC_0,
                                     tablePropertyIR_h :: tablePropertyIR_t*)
  = (TBLC_0, tablePropertyIR_h :: tablePropertyIR_t*)
  -- if ACTIONS '=' `{tableActionIR*} = tablePropertyIR_h
  -- (if (_ tableActionReferenceIR '#' `(_ ',' _) ';' = tableActionIR))*
  -- if tableActionReferenceIR_NoAction = ('.' "NoAction") eps `(eps)
  -- if (tableActionReferenceIR_NoAction <- tableActionReferenceIR*)

def $insert_NoAction_tablePropertyIR(TBLC_0,
                                     tablePropertyIR_h :: tablePropertyIR_t*)
  = (TBLC_1, tablePropertyIR_h :: tablePropertyIR_t_updated*)
  -- if ~(tablePropertyIR_h <: tableActionsPropertyIR)
  -- if (TBLC_1, tablePropertyIR_t_updated*)
        = $insert_NoAction_tablePropertyIR(TBLC_0, tablePropertyIR_t*)

rule Table_ok/zero-default-action:
  TC
    |- tableProperty*
    : TBLC_2 (tablePropertyIR_updated* ++ [tablePropertyIR_default_action])
  -- if $(|$filter_<tableProperty>(tableProperty*,
                                   $is_tableKeysProperty(tableProperty)*)|
        <= 1)
  -- if |$filter_<tableProperty>(tableProperty*,
                                 $is_tableActionsProperty(tableProperty)*)|
        = 1
  -- if |$filter_<tableProperty>(tableProperty*,
                                 $is_tableDefaultActionProperty(tableProperty)*)|
        = 0
  -- if TBLC_0 = $empty_tableContext
  -- TableProperties_ok: TC TBLC_0 |- tableProperty* : TBLC_1 tablePropertyIR*
  -- if tablePropertyIR_default_action
        = _EMPTY eps DEFAULT_ACTION '=' ((_NAME "NoAction") eps `(eps)) ';'
  -- if (TBLC_2, tablePropertyIR_updated*)
        = $insert_NoAction_tablePropertyIR(TBLC_1, tablePropertyIR*)

rule Table_ok/one-default-action:
  TC |- tableProperty* : TBLC_1 tablePropertyIR*
  -- if $(|$filter_<tableProperty>(tableProperty*,
                                   $is_tableKeysProperty(tableProperty)*)|
        <= 1)
  -- if |$filter_<tableProperty>(tableProperty*,
                                 $is_tableActionsProperty(tableProperty)*)|
        = 1
  -- if |$filter_<tableProperty>(tableProperty*,
                                 $is_tableDefaultActionProperty(tableProperty)*)|
        = 1
  -- if TBLC_0 = $empty_tableContext
  -- TableProperties_ok: TC TBLC_0 |- tableProperty* : TBLC_1 tablePropertyIR*

rule TableType_ok:
  TC_0 TBLC |- name : TC_1 typeIR_table
  -- if nameIR = $name(name)
  -- if typeId_enum = "action_list(" ++ nameIR ++ ")"
  -- if (prefixedNameIR_action `(_ '@' _))* = TBLC.ACTIONS
  -- (if (nameIR_enum_field = $flatten_prefixedNameIR(prefixedNameIR_action)))*
  -- if tableMetadataEnumTypeIR = TABLE_ENUM typeId_enum `{nameIR_enum_field*}
  -- (if (value_enum_field = TABLE_ENUM typeId_enum '.' nameIR_enum_field))*
  -- (if (varTypeIR_enum_field
         = _EMPTY tableMetadataEnumTypeIR LCTK value_enum_field))*
  -- if TC_1
        = $add_vars_t(BLOCK,
                      TC_0,
                      (typeId_enum ++ "." ++ nameIR_enum_field)*,
                      varTypeIR_enum_field*)
  -- if typeId_struct = "apply_result(" ++ nameIR ++ ")"
  -- if tableMetadataStructTypeIR
        = TABLE_STRUCT
          typeId_struct
          `{HIT BOOL ';' MISS BOOL ';' ACTION_RUN tableMetadataEnumTypeIR ';'}
  -- if typeIR_table = TABLE nameIR `{tableMetadataStructTypeIR}
;; === 5-typing/5.14.2-typing-control-declaration.spectec ===
rule ControlLocalDecl_ok/constantDeclaration:
  TC_0 |- constantDeclaration : TC_1 constantDeclarationIR
  -- ConstDecl_ok:
       BLOCK TC_0 |- constantDeclaration : TC_1 constantDeclarationIR

rule ControlLocalDecl_ok/instantiation:
  TC_0 |- instantiation : TC_1 instantiationIR
  -- InstDecl_ok: BLOCK TC_0 |- instantiation : TC_1 instantiationIR

rule ControlLocalDecl_ok/variableDeclaration:
  TC_0 |- variableDeclaration : TC_1 variableDeclarationIR
  -- VarDecl_ok: BLOCK TC_0 |- variableDeclaration : TC_1 variableDeclarationIR

rule ControlLocalDecl_ok/actionDeclaration:
  TC_0 |- actionDeclaration : TC_1 actionDeclarationIR
  -- ActionDecl_ok: BLOCK TC_0 |- actionDeclaration : TC_1 actionDeclarationIR

rule ControlLocalDecl_ok/tableDeclaration:
  TC_0
    |- annotationList TABLE name `{tablePropertyList}
    : TC_3 tableDeclarationIR
  -- if TC_1 = TC_0[.LOCAL.KIND = TABLE_APPLY_METHOD]
  -- if tableProperty* = $flatten_tablePropertyList(tablePropertyList)
  -- Table_ok: TC_1 |- tableProperty* : TBLC tablePropertyIR*
  -- if nameIR = $name(name)
  -- TableType_ok: TC_1 TBLC |- name : TC_2 typeIR_table
  -- if varTypeIR = _EMPTY typeIR_table DYN eps
  -- if TC_3 = $add_var_t(BLOCK, TC_2, nameIR, varTypeIR)
  -- if tableDeclarationIR
        = annotationList TABLE typeIR_table nameIR `{tablePropertyIR*}

relation ControlLocalDecls_ok:
  typingContext
    |- controlLocalDeclaration*
    : typingContext controlLocalDeclarationIR*
  hint(input %0 %1)
  hint(prose_in "typing" %1#", under context" %0)
  hint(prose_out "the updated context"
                 %2
                 "and the typed control local declarations"
                 %3)

rule ControlLocalDecls_ok/nil:
  TC |- eps : TC eps

rule ControlLocalDecls_ok/cons:
  TC_0
    |- controlLocalDeclaration_h :: controlLocalDeclaration_t*
    : TC_2 (controlLocalDeclarationIR_h :: controlLocalDeclarationIR_t*)
  -- ControlLocalDecl_ok:
       TC_0 |- controlLocalDeclaration_h : TC_1 controlLocalDeclarationIR_h
  -- ControlLocalDecls_ok:
       TC_1 |- controlLocalDeclaration_t* : TC_2 controlLocalDeclarationIR_t*

rule ControlLocalDeclList_ok:
  TC_0 |- controlLocalDeclarationList : TC_1 controlLocalDeclarationIR*
  -- if controlLocalDeclaration*
        = $flatten_controlLocalDeclarationList(controlLocalDeclarationList)
  -- ControlLocalDecls_ok:
       TC_0 |- controlLocalDeclaration* : TC_1 controlLocalDeclarationIR*
;; === 5-typing/5.15.1-typing-call-convention.spectec ===
rule Call_convention_expr_ok/in:
  p TC actctxt
    |- (_ IN typeIR_param _ _) '@' typedExpressionIR_arg
    : typedExpressionIR_arg_cast
  -- if typedExpressionIR_arg_cast
        = $cast_unary(typedExpressionIR_arg, typeIR_param)

relation Expr_lvalue_ok: cursor typingContext |- typedExpressionIR
  hint(input %0 %1 %2)
  hint(prose_in %2 "is a valid l-value, under context" %1 "at" %0)

rule Expr_lvalue_ok/referenceExpressionIR:
  p TC |- prefixedNameIR '#' `(_ _)
  -- if direction _ DYN _ = $find_var_t(prefixedNameIR, p, TC)
  -- if direction = OUT \/ direction = INOUT

rule Expr_lvalue_ok/headerstack-next-last:
  p TC |- (typedExpressionIR_base '.' nameIR) '#' `(_ _)
  -- Expr_lvalue_ok: p TC |- typedExpressionIR_base
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if typeIR `[_] = $unroll_typeIR(typeIR_base)
  -- if nameIR = "next" \/ nameIR = "last"
  -- if (p = BLOCK /\ TC.BLOCK.KIND = PARSER)
        \/ (p = LOCAL /\ TC.LOCAL.KIND = PARSER_STATE)

rule Expr_lvalue_ok/non-headerstack:
  p TC |- (typedExpressionIR_base '.' nameIR) '#' `(_ _)
  -- Expr_lvalue_ok: p TC |- typedExpressionIR_base
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if typeIR_unroll = $unroll_typeIR(typeIR_base)
  -- if ~(typeIR_unroll <: headerStackTypeIR)

rule Expr_lvalue_ok/accessExpressionIR-indexAccessExpressionIR:
  p TC |- (typedExpressionIR_base `[typedExpressionIR_index]) '#' `(_ _)
  -- Expr_lvalue_ok: p TC |- typedExpressionIR_base

rule Expr_lvalue_ok/accessExpressionIR-sliceAccessExpressionIR-range:
  p TC
    |- (typedExpressionIR_base `[typedExpressionIR_hi ':' typedExpressionIR_lo])
       '#'
       `(_ _)
  -- Expr_lvalue_ok: p TC |- typedExpressionIR_base

rule Expr_lvalue_ok/accessExpressionIR-sliceAccessExpressionIR-offset:
  p TC
    |- (typedExpressionIR_base `[typedExpressionIR_l '+' : typedExpressionIR_w])
       '#'
       `(_ _)
  -- Expr_lvalue_ok: p TC |- typedExpressionIR_base

rule Call_convention_expr_ok/out-inout:
  p TC actctxt
    |- (_ direction typeIR_param _ _) '@' typedExpressionIR_arg
    : typedExpressionIR_arg
  -- if direction = OUT \/ direction = INOUT
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR_arg)
  -- Type_alpha: typeIR_param ~~ typeIR_arg
  -- Expr_lvalue_ok: p TC |- typedExpressionIR_arg

rule Call_convention_expr_ok/action:
  p TC ACTION
    |- (_ _EMPTY typeIR_param _ _) '@' typedExpressionIR_arg
    : typedExpressionIR_arg_cast
  -- if typedExpressionIR_arg_cast
        = $cast_unary(typedExpressionIR_arg, typeIR_param)

rule Call_convention_expr_ok/non-action:
  p TC NOACTION
    |- (_ _EMPTY typeIR_param _ _) '@' typedExpressionIR_arg
    : typedExpressionIR_arg_cast
  -- if typedExpressionIR_arg_cast
        = $cast_unary(typedExpressionIR_arg, typeIR_param)
  -- if DYN =/= $ctk_of_typedExpressionIR(typedExpressionIR_arg)

rule Call_convention_argument_ok/typedExpression:
  p TC actctxt |- parameterIR '@' typedExpressionIR : typedExpressionIR_cast
  -- Call_convention_expr_ok:
       p TC actctxt
         |- parameterIR '@' typedExpressionIR
         : typedExpressionIR_cast

rule Call_convention_argument_ok/nameIR-typedExpression:
  p TC actctxt
    |- parameterIR '@' (nameIR '=' typedExpressionIR)
    : (nameIR '=' typedExpressionIR_cast)
  -- Call_convention_expr_ok:
       p TC actctxt
         |- parameterIR '@' typedExpressionIR
         : typedExpressionIR_cast

rule Call_convention_argument_ok/nameIR-dontcare:
  p TC actctxt |- parameterIR '@' (nameIR '=' '_') : (nameIR '=' '_')
  -- if _ OUT _ _ _ = parameterIR

rule Call_convention_argument_ok/dontcare:
  p TC actctxt |- parameterIR '@' '_' : '_'
  -- if _ OUT _ _ _ = parameterIR

rule Call_convention_ok/nil:
  p TC actctxt |- eps '@' eps : eps

rule Call_convention_ok/cons:
  p TC actctxt
    |- (parameterIR_h :: parameterIR_t*) '@' (argumentIR_h :: argumentIR_t*)
    : (argumentIR_h_cast :: argumentIR_t_cast*)
  -- Call_convention_argument_ok:
       p TC actctxt |- parameterIR_h '@' argumentIR_h : argumentIR_h_cast
  -- Call_convention_ok:
       p TC actctxt |- parameterIR_t* '@' argumentIR_t* : argumentIR_t_cast*
;; === 5-typing/5.15.2-typing-call-inference.spectec ===
syntax infer =
  | KNOWN AS typeIR
  | UNKNOWN

syntax constraint = map<typeId, infer>

dec $empty_constraint(typeId*) : constraint

def $empty_constraint(typeId*) = `{(typeId ':' UNKNOWN)*}

syntax inference = map<typeId, typeIR>

dec $infer(typeId*, parameterIR*, argumentIR*) : inference

dec $infer'(constraint, parameterIR, argumentIR) : constraint

dec $resolve_inference(inference) : inference

dec $resolve_inference'(typeIR) : typeIR

dec $gen_constraint(constraint, typeIR, typeIR) : constraint

dec $gen_constraints(constraint, typeIR*, typeIR*) : constraint

dec $merge_constraint(constraint, constraint) : constraint

dec $merge_constraint'(constraint, constraint, typeId*, constraint) : constraint

dec $merge_constraints(constraint, constraint*) : constraint

dec $resolve_constraint(constraint) : inference

def $infer(eps, parameterIR*, argumentIR*) = $empty_map<typeId, typeIR>

def $infer(typeId_infer*, parameterIR*, argumentIR*) = inference_resolved
  -- if typeId_infer* =/= eps
  -- if constraint_init = $empty_constraint(typeId_infer*)
  -- (if (constraint_pair = $infer'(constraint_init, parameterIR, argumentIR)))*
  -- if constraint_inferred
        = $merge_constraints(constraint_init, constraint_pair*)
  -- if inference = $resolve_constraint(constraint_inferred)
  -- if inference_resolved = $resolve_inference(inference)

def $infer'(constraint, parameterIR, typedExpressionIR)
  = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if _ _ typeIR_param _ _ = parameterIR
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

def $infer'(constraint, parameterIR, nameIR '=' typedExpressionIR)
  = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if _ _ typeIR_param _ _ = parameterIR
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

def $infer'(constraint, parameterIR, nameIR '=' '_') = constraint

def $infer'(constraint, parameterIR, '_') = constraint

def $resolve_inference(`{(typeId ':' typeIR)*})
  = `{(typeId ':' typeIR_resolved)*}
  -- (if (typeIR_resolved = $resolve_inference'(typeIR)))*

def $resolve_inference'(typeIR) = typeIR_resolved
  -- if SEQ `<typeIR_arg*> = $unroll_typeIR(typeIR)
  -- if typeIR_resolved = TUPLE `<typeIR_arg*>

def $resolve_inference'(typeIR) = typeIR
  -- otherwise

def $gen_constraint(constraint, _NAME typeId_param, typeIR_arg)
  = $update_map<typeId, infer>(constraint, typeId_param, KNOWN AS typeIR_arg)
  -- if $in_set<typeId>(typeId_param, $dom_map<typeId, infer>(constraint))

def $gen_constraint(constraint, TYPEDEF _ typeIR_param, typeIR_arg)
  = $gen_constraint(constraint, typeIR_param, typeIR_arg)

def $gen_constraint(constraint, typeIR_param, TYPEDEF _ typeIR_arg)
  = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if ~(typeIR_param <: nameTypeIR)
  -- if ~(typeIR_param <: typedefTypeIR)

def $gen_constraint(constraint, TYPE typeId typeIR_param, TYPE typeId typeIR_arg)
  = $gen_constraint(constraint, typeIR_param, typeIR_arg)

def $gen_constraint(constraint, LIST `<typeIR_param>, LIST `<typeIR_arg>)
  = $gen_constraint(constraint, typeIR_param, typeIR_arg)

def $gen_constraint(constraint, TUPLE `<typeIR_param*>, TUPLE `<typeIR_arg*>)
  = $gen_constraints(constraint, typeIR_param*, typeIR_arg*)

def $gen_constraint(constraint, typeIR_param `[n_size], typeIR_arg `[n_size])
  = $gen_constraint(constraint, typeIR_param, typeIR_arg)

def $gen_constraint(constraint,
                    STRUCT typeId `<typeIR_arg_a*> `{_},
                    STRUCT typeId `<typeIR_arg_b*> `{_})
  = $gen_constraints(constraint, typeIR_arg_a*, typeIR_arg_b*)

def $gen_constraint(constraint,
                    HEADER typeId `<typeIR_arg_a*> `{_},
                    HEADER typeId `<typeIR_arg_b*> `{_})
  = $gen_constraints(constraint, typeIR_arg_a*, typeIR_arg_b*)

def $gen_constraint(constraint,
                    HEADER_UNION typeId `<typeIR_arg_a*> `{_},
                    HEADER_UNION typeId `<typeIR_arg_b*> `{_})
  = $gen_constraints(constraint, typeIR_arg_a*, typeIR_arg_b*)

def $gen_constraint(constraint,
                    EXTERN typeId `<typeIR_arg_a*> `{_},
                    EXTERN typeId `<typeIR_arg_b*> `{_})
  = $gen_constraints(constraint, typeIR_arg_a*, typeIR_arg_b*)

def $gen_constraint(constraint,
                    PARSER _ `<_> `(parameterIR_param*),
                    PARSER _ `<_> `(parameterIR_arg*))
  = $gen_constraints(constraint, typeIR_param*, typeIR_arg*)
  -- (if (_ direction typeIR_param _ _ = parameterIR_param))*
  -- (if (_ direction typeIR_arg _ _ = parameterIR_arg))*

def $gen_constraint(constraint,
                    CONTROL _ `<_> `(parameterIR_param*),
                    CONTROL _ `<_> `(parameterIR_arg*))
  = $gen_constraints(constraint, typeIR_param*, typeIR_arg*)
  -- (if (_ direction typeIR_param _ _ = parameterIR_param))*
  -- (if (_ direction typeIR_arg _ _ = parameterIR_arg))*

def $gen_constraint(constraint,
                    PACKAGE _ `<_> `{typeIR_param*},
                    PACKAGE _ `<_> `{typeIR_arg*})
  = $gen_constraints(constraint, typeIR_param*, typeIR_arg*)

def $gen_constraint(constraint, typeIR_param, typeIR_arg) = constraint
  -- otherwise

def $gen_constraints(constraint, typeIR_param*, typeIR_arg*)
  = $merge_constraints(constraint, constraint_pair*)
  -- (if (constraint_pair
         = $gen_constraint(constraint, typeIR_param, typeIR_arg)))*

def $merge_constraint(constraint_pre, constraint_post)
  = $merge_constraint'(constraint_pre, constraint_post, typeId_pre*, `{eps})
  -- if `{typeId_pre*} = $dom_map<typeId, infer>(constraint_pre)
  -- if `{typeId_post*} = $dom_map<typeId, infer>(constraint_post)
  -- if $eq_set<typeId>(`{typeId_pre*}, `{typeId_post*})

def $merge_constraint'(constraint_pre, constraint_post, eps, constraint)
  = constraint

def $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_h :: typeId_t*,
                       constraint)
  = $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_t*,
                       constraint_updated)
  -- if UNKNOWN = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if UNKNOWN = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if constraint_updated
        = $update_map<typeId, infer>(constraint, typeId_h, UNKNOWN)

def $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_h :: typeId_t*,
                       constraint)
  = $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_t*,
                       constraint_updated)
  -- if UNKNOWN = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if KNOWN AS typeIR_post
        = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if constraint_updated
        = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_post)

def $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_h :: typeId_t*,
                       constraint)
  = $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_t*,
                       constraint_updated)
  -- if KNOWN AS typeIR_pre = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if UNKNOWN = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if constraint_updated
        = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_pre)

def $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_h :: typeId_t*,
                       constraint)
  = $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_t*,
                       constraint_updated)
  -- if KNOWN AS typeIR_pre = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if KNOWN AS typeIR_post
        = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- Cast_impl: typeIR_pre -> typeIR_post
  -- if constraint_updated
        = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_post)

def $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_h :: typeId_t*,
                       constraint)
  = $merge_constraint'(constraint_pre,
                       constraint_post,
                       typeId_t*,
                       constraint_updated)
  -- if KNOWN AS typeIR_pre = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if KNOWN AS typeIR_post
        = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- Cast_impl:/ typeIR_pre -> typeIR_post
  -- Cast_impl: typeIR_post -> typeIR_pre
  -- if constraint_updated
        = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_pre)

def $merge_constraints(constraint_pre, eps) = constraint_pre

def $merge_constraints(constraint_pre_0, constraint_post_h :: constraint_post_t*)
  = constraint_pre_2
  -- if constraint_pre_1
        = $merge_constraint(constraint_pre_0, constraint_post_h)
  -- if constraint_pre_2
        = $merge_constraints(constraint_pre_1, constraint_post_t*)

def $resolve_constraint(`{(typeId ':' infer)*}) = `{(typeId ':' typeIR)*}
  -- (if (KNOWN AS typeIR = infer))*
;; === 5-typing/5.15.3-typing-constructor-call.spectec ===
dec $resolve_type_alias(typeIR) : (nameIR, typeIR*)
  hint(prose_in "type alias in" %0 "resolved to aliased name and type arguments")

def $resolve_type_alias(TYPEDEF nameIR_alias typeIR_alias)
  = $resolve_type_alias(typeIR_alias)

def $resolve_type_alias(EXTERN nameIR_alias `<typeIR_arg*> _)
  = (nameIR_alias, typeIR_arg*)

def $resolve_type_alias(PACKAGE nameIR_alias `<typeIR_arg*> `{_})
  = (nameIR_alias, typeIR_arg*)

rule ConstructorType_ok/non-aliased-none-type:
  p TC
    |- (prefixedNameIR `<typeArgumentIR*>) `(argumentIR*)
    : constructorTypeIR `<'#' typeId_impl*> `('#' id_default* '#' id_optional*)
  -- if eps = $find_typeDef_t(p, TC, prefixedNameIR)
  -- if callableId ':' constructorTypeDefIR '#' id_default* '#' id_optional*
        = $find_constructorDef_overloaded_t(TC, prefixedNameIR, argumentIR*)
  -- if (constructorTypeIR, typeId_impl*)
        = $specialize_constructorTypeDefIR(constructorTypeDefIR, typeArgumentIR*)
  -- if B = $union_set<typeId>($bound(p, TC), `{typeId_impl*})
  -- ConstructorType_wf: B |- constructorTypeIR

rule ConstructorType_ok/non-aliased-some-type:
  p TC
    |- (prefixedNameIR `<typeArgumentIR*>) `(argumentIR*)
    : constructorTypeIR `<'#' typeId_impl*> `('#' id_default* '#' id_optional*)
  -- if typeDefIR = $find_typeDef_t(p, TC, prefixedNameIR)
  -- if ~(typeDefIR <: typedefTypeIR)
  -- if callableId ':' constructorTypeDefIR '#' id_default* '#' id_optional*
        = $find_constructorDef_overloaded_t(TC, prefixedNameIR, argumentIR*)
  -- if (constructorTypeIR, typeId_impl*)
        = $specialize_constructorTypeDefIR(constructorTypeDefIR, typeArgumentIR*)
  -- if B = $union_set<typeId>($bound(p, TC), `{typeId_impl*})
  -- ConstructorType_wf: B |- constructorTypeIR

rule ConstructorType_ok/aliased:
  p TC
    |- (prefixedNameIR `<eps>) `(argumentIR*)
    : constructorTypeIR `<'#' typeId_impl*> `('#' id_default* '#' id_optional*)
  -- if TYPEDEF nameIR_alias typeIR_alias
        = $find_typeDef_t(p, TC, prefixedNameIR)
  -- if (nameIR, typeArgumentIR*) = $resolve_type_alias(typeIR_alias)
  -- if callableId ':' constructorTypeDefIR '#' id_default* '#' id_optional*
        = $find_constructorDef_overloaded_t(TC, _NAME nameIR, argumentIR*)
  -- if (constructorTypeIR, typeId_impl*)
        = $specialize_constructorTypeDefIR(constructorTypeDefIR, typeArgumentIR*)
  -- if B = $union_set<typeId>($bound(p, TC), `{typeId_impl*})
  -- ConstructorType_wf: B |- constructorTypeIR

dec $instantiable_extern(cursor, typingContext, instctxt) : bool

def $instantiable_extern(GLOBAL, TC, instctxt) = true

def $instantiable_extern(BLOCK, TC, instctxt) = true

def $instantiable_extern(LOCAL, TC, instctxt) = true

dec $instantiable_parser(cursor, typingContext, instctxt) : bool

def $instantiable_parser(GLOBAL, TC, instctxt) = instctxt = ANON

def $instantiable_parser(BLOCK, TC, instctxt)
  = blockKind = PARSER \/ blockKind = PACKAGE
  -- if blockKind = TC.BLOCK.KIND

def $instantiable_parser(LOCAL, TC, instctxt) = localKind = PARSER_STATE
  -- if localKind = TC.LOCAL.KIND

dec $instantiable_control(cursor, typingContext, instctxt) : bool

def $instantiable_control(GLOBAL, TC, instctxt) = instctxt = ANON

def $instantiable_control(BLOCK, TC, instctxt)
  = blockKind = CONTROL \/ blockKind = PACKAGE
  -- if blockKind = TC.BLOCK.KIND

def $instantiable_control(LOCAL, TC, instctxt)
  = localKind = CONTROL_APPLY_METHOD
  -- if localKind = TC.LOCAL.KIND

dec $instantiable_package(cursor, typingContext, instctxt) : bool

def $instantiable_package(GLOBAL, TC, instctxt) = true

def $instantiable_package(BLOCK, TC, instctxt) = blockKind = PACKAGE
  -- if blockKind = TC.BLOCK.KIND

def $instantiable_package(LOCAL, TC, instctxt) = false

dec $instantiable_table(cursor, typingContext, instctxt) : bool

def $instantiable_table(GLOBAL, TC, instctxt) = false

def $instantiable_table(BLOCK, TC, instctxt) = blockKind = CONTROL
  -- if blockKind = TC.BLOCK.KIND

def $instantiable_table(LOCAL, TC, instctxt) = false

dec $instantiable(cursor, typingContext, instctxt, typeIR) : bool

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_extern(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: externObjectTypeIR

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_parser(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: parserObjectTypeIR

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_control(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: controlObjectTypeIR

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_package(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: packageObjectTypeIR

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_table(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: tableObjectTypeIR

rule Inst_ok/package:
  GLOBAL TC instctxt
    |- constructorTypeIR
       `<typeArgumentIR* '#' typeId_infer*>
       `(argumentIR* '#' id_default* '#' id_optional*)
    : typeIR_object_inferred `<typeArgumentIR_inferred*> `(argumentIR_cast*)
  -- if CONSTRUCTOR `(parameterIR*) ':' typeIR_object = constructorTypeIR
  -- if PACKAGE _ `<_> `{_} = $unroll_typeIR(typeIR_object)
  -- if GIVEN parameterIR_aligned* DEFAULT _
        = $align_parameterListIR(parameterIR*,
                                 argumentIR*,
                                 id_default*,
                                 id_optional*)
  -- if inference = $infer(typeId_infer*, parameterIR_aligned*, argumentIR*)
  -- (if (typeIR_inferred = $find_map<typeId, typeIR>(inference, typeId_infer)))*
  -- if typeArgumentIR_inferred* = typeArgumentIR* ++ typeIR_inferred*
  -- (if (parameterIR_aligned_inferred
         = $subst_parameterIR(inference, parameterIR_aligned)))*
  -- if typeIR_object_inferred = $subst_typeIR(inference, typeIR_object)
  -- if constructorTypeIR_inferred
        = CONSTRUCTOR
          `(parameterIR_aligned_inferred*)
          ':'
          typeIR_object_inferred
  -- ConstructorType_wf: $bound(GLOBAL, TC) |- constructorTypeIR_inferred
  -- if $instantiable(GLOBAL, TC, instctxt, typeIR_object_inferred)
  -- Call_convention_ok:
       BLOCK TC NOACTION
         |- parameterIR_aligned_inferred* '@' argumentIR*
         : argumentIR_cast*

rule Inst_ok/non-package:
  p TC instctxt
    |- constructorTypeIR
       `<typeArgumentIR* '#' typeId_infer*>
       `(argumentIR* '#' id_default* '#' id_optional*)
    : typeIR_object_inferred `<typeArgumentIR_inferred*> `(argumentIR_cast*)
  -- if CONSTRUCTOR `(parameterIR*) ':' typeIR_object = constructorTypeIR
  -- if typeIR_object_unroll = $unroll_typeIR(typeIR_object)
  -- if ~(typeIR_object_unroll <: packageObjectTypeIR)
  -- if GIVEN parameterIR_aligned* DEFAULT _
        = $align_parameterListIR(parameterIR*,
                                 argumentIR*,
                                 id_default*,
                                 id_optional*)
  -- if inference = $infer(typeId_infer*, parameterIR_aligned*, argumentIR*)
  -- (if (typeIR_inferred = $find_map<typeId, typeIR>(inference, typeId_infer)))*
  -- if typeArgumentIR_inferred* = typeArgumentIR* ++ typeIR_inferred*
  -- (if (parameterIR_aligned_inferred
         = $subst_parameterIR(inference, parameterIR_aligned)))*
  -- if typeIR_object_inferred = $subst_typeIR(inference, typeIR_object)
  -- if constructorTypeIR_inferred
        = CONSTRUCTOR
          `(parameterIR_aligned_inferred*)
          ':'
          typeIR_object_inferred
  -- ConstructorType_wf: $bound(p, TC) |- constructorTypeIR_inferred
  -- if $instantiable(p, TC, instctxt, typeIR_object_inferred)
  -- Call_convention_ok:
       p TC NOACTION
         |- parameterIR_aligned_inferred* '@' argumentIR*
         : argumentIR_cast*
;; === 5-typing/5.15.4-typing-callable-call.spectec ===
rule CallableTarget_ok/prefixedNonTypeName:
  p TC |- prefixedNonTypeName : prefixedNameIR
  -- if prefixedNameIR = $prefixedNonTypeName(prefixedNonTypeName)

rule CallableTarget_ok/this:
  p TC |- THIS : (_NAME "this")

rule CallableTarget_ok/memberAccessExpression-prefixedTypeName:
  p TC |- prefixedTypeName '.' member : TYPE prefixedNameIR '.' nameIR
  -- if prefixedNameIR = $prefixedTypeName(prefixedTypeName)
  -- if nameIR = $name(member)

rule CallableTarget_ok/memberAccessExpression-expression:
  p TC |- expression_base '.' member : typedExpressionIR_base '.' nameIR
  -- if nameIR = $name(member)
  -- Expr_ok: p TC |- expression_base : typedExpressionIR_base

rule CallableTarget_ok/parenthesizedExpression:
  p TC |- `(expression) : `(callableTargetIR)
  -- CallableTarget_ok: p TC |- expression : callableTargetIR

rule CallableTarget_lvalue_ok:
  p TC |- lvalue : callableTargetIR
  -- if expression = $lvalue_as_expression(lvalue)
  -- CallableTarget_ok: p TC |- expression : callableTargetIR

rule CallableType_ok/actionTypeIR:
  p TC
    |- prefixedNameIR `<eps> `(argumentIR*)
    : actionTypeIR `<'#' eps> `('#' id_default* '#' id_optional*)
  -- if callableId ':' actionTypeIR '#' id_default* '#' id_optional*
        = $find_callableDef_overloaded_t(p, TC, prefixedNameIR, argumentIR*)
  -- CallableType_wf: $bound(p, TC) |- actionTypeIR

rule CallableType_ok/functionTypeIR:
  p TC
    |- prefixedNameIR `<typeArgumentIR*> `(argumentIR*)
    : functionTypeIR `<'#' typeId_impl*> `('#' id_default* '#' id_optional*)
  -- if callableId ':' functionTypeDefIR '#' id_default* '#' id_optional*
        = $find_callableDef_overloaded_t(p, TC, prefixedNameIR, argumentIR*)
  -- if (functionTypeIR, typeId_impl*)
        = $specialize_callableTypeDefIR(functionTypeDefIR, typeArgumentIR*)
  -- if bound = $union_set<typeId>($bound(p, TC), `{typeId_impl*})
  -- CallableType_wf: bound |- functionTypeIR

rule CallableType_ok/minmax-SizeIn-BitsBytes:
  p TC
    |- (typedExpressionIR_base '.' nameIR) `<eps> `(eps)
    : methodTypeIR `<'#' eps> `('#' eps '#' eps)
  -- if nameIR <- ["minSizeInBits",
                   "minSizeInBytes",
                   "maxSizeInBits",
                   "maxSizeInBytes"]
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if typeIR_base_unroll = $unroll_typeIR(typeIR_base)
  -- if ~(typeIR_base_unroll <: objectTypeIR)
  -- if ~(typeIR_base_unroll <: synthesizedTypeIR)
  -- if methodTypeIR = BUILTIN_METHOD nameIR `(eps) ':' INT

rule CallableType_ok/stack-push-pop-front:
  p TC
    |- (typedExpressionIR_base '.' nameIR) `<eps> `(argumentIR)
    : methodTypeIR `<'#' eps> `('#' eps '#' eps)
  -- if nameIR <- ["push_front", "pop_front"]
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if typeIR `[_] = $unroll_typeIR(typeIR_base)
  -- if parameterIR = _EMPTY _EMPTY INT "count" eps
  -- if methodTypeIR = BUILTIN_METHOD nameIR `(parameterIR) ':' INT

rule CallableType_ok/header-isValid:
  p TC
    |- (typedExpressionIR_base '.' nameIR) `<eps> `(eps)
    : methodTypeIR `<'#' eps> `('#' eps '#' eps)
  -- if nameIR <- ["isValid"]
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if HEADER _ `<_> `{_} = $unroll_typeIR(typeIR_base)
  -- if methodTypeIR = BUILTIN_METHOD nameIR `(eps) ':' BOOL

rule CallableType_ok/header-union-isValid:
