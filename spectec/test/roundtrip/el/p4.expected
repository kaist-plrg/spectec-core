rule TableEntry_keyset_simple_ok/lpm:
  TC TBLC
    |- (typeIR_key ':' "lpm") '@' expression
    : (LPM n) typedExpressionIR_set
  -- if TBLC.MODE = LPM n
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if ctk = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- Cast_impl: typeIR -> typeIR_key
  -- if typeIR_set = SET `<typeIR_key>
  -- if typedExpressionIR_set
        = (`(typeIR_set) typedExpressionIR) '#' `(typeIR_set ctk)

rule TableEntry_keyset_simple_ok/non-lpm-singleton-seq:
  TC TBLC
    |- (typeIR_key ':' nameIR_matchkind) '@' expression
    : NON_LPM typedExpressionIR_set
  -- if nameIR_matchkind =/= "lpm"
  -- if $is_singleton_list_expression(expression)
  -- if `{expression_elem _EMPTY} = expression
  -- Expr_ok: LOCAL TC |- expression_elem : typedExpressionIR
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if ctk = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- Cast_impl: typeIR -> typeIR_key
  -- if typeIR_set = SET `<typeIR_key>
  -- if typedExpressionIR_set
        = (`(typeIR_set) typedExpressionIR) '#' `(typeIR_set ctk)

rule TableEntry_keyset_simple_ok/non-lpm-non-singleton-seq:
  TC TBLC
    |- (typeIR_key ':' nameIR_matchkind) '@' expression
    : NON_LPM typedExpressionIR_set
  -- if nameIR_matchkind =/= "lpm"
  -- if ~$is_singleton_list_expression(expression)
  -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if ctk = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- Cast_impl: typeIR -> typeIR_key
  -- if typeIR_set = SET `<typeIR_key>
  -- if typedExpressionIR_set
        = (`(typeIR_set) typedExpressionIR) '#' `(typeIR_set ctk)

rule TableEntry_keyset_simple_ok/lpm:
  TC TBLC
    |- (typeIR_key ':' "lpm") '@' (expression_l '&&&' expression_r)
    : (LPM n_prefix)
      (typedExpressionIR_l_reduced '&&&' typedExpressionIR_r_reduced)
  -- if TBLC.MODE = LPM n
  -- Expr_ok: LOCAL TC |- expression_l : typedExpressionIR_l
  -- Expr_ok: LOCAL TC |- expression_r : typedExpressionIR_r
  -- if typedExpressionIR_l_cast = $cast_unary(typedExpressionIR_l, typeIR_key)
  -- if typedExpressionIR_r_cast = $cast_unary(typedExpressionIR_r, typeIR_key)
  -- if (typedExpressionIR_l_reduced, typedExpressionIR_r_reduced)
        = $reduce_serenum_binary(typedExpressionIR_l_cast,
                                 typedExpressionIR_r_cast,
                                 def $compat_mask)
  -- if ctk_r_reduced = $ctk_of_typedExpressionIR(typedExpressionIR_r_reduced)
  -- if ctk_r_reduced = LCTK
  -- Expr_eval_lctk: LOCAL TC |- typedExpressionIR_r_reduced ~> integerValue_r
  -- if n_r = $nat_of_integerValue(integerValue_r)
  -- if n_prefix = $tableEntry_lpm_prefix(n W $int_to_bitstr(n, n_r))

rule TableEntry_keyset_simple_ok/ternary:
  TC TBLC
    |- (typeIR_key ':' "ternary") '@' (expression_l '&&&' expression_r)
    : NON_LPM (typedExpressionIR_l_reduced '&&&' typedExpressionIR_r_reduced)
  -- Expr_ok: LOCAL TC |- expression_l : typedExpressionIR_l
  -- Expr_ok: LOCAL TC |- expression_r : typedExpressionIR_r
  -- if typedExpressionIR_l_cast = $cast_unary(typedExpressionIR_l, typeIR_key)
  -- if typedExpressionIR_r_cast = $cast_unary(typedExpressionIR_r, typeIR_key)
  -- if (typedExpressionIR_l_reduced, typedExpressionIR_r_reduced)
        = $reduce_serenum_binary(typedExpressionIR_l_cast,
                                 typedExpressionIR_r_cast,
                                 def $compat_mask)

rule TableEntry_keyset_simple_ok/range:
  TC TBLC
    |- (typeIR_key ':' "range") '@' (expression_l '..' expression_r)
    : NON_LPM (typedExpressionIR_l_reduced '..' typedExpressionIR_r_reduced)
  -- Expr_ok: LOCAL TC |- expression_l : typedExpressionIR_l
  -- Expr_ok: LOCAL TC |- expression_r : typedExpressionIR_r
  -- if typedExpressionIR_l_cast = $cast_unary(typedExpressionIR_l, typeIR_key)
  -- if typedExpressionIR_r_cast = $cast_unary(typedExpressionIR_r, typeIR_key)
  -- if (typedExpressionIR_l_reduced, typedExpressionIR_r_reduced)
        = $reduce_serenum_binary(typedExpressionIR_l_cast,
                                 typedExpressionIR_r_cast,
                                 def $compat_range)

rule TableEntry_keyset_simple_ok/lpm:
  TC TBLC |- (typeIR_key ':' "lpm") '@' DEFAULT : (LPM n) DEFAULT
  -- if TBLC.MODE = LPM n

rule TableEntry_keyset_simple_ok/non-lpm:
  TC TBLC |- (typeIR_key ':' nameIR_matchkind) '@' DEFAULT : NON_LPM DEFAULT
  -- if nameIR_matchkind =/= "lpm"
  -- if nameIR_matchkind =/= "exact"

rule TableEntry_keyset_simple_ok/lpm:
  TC TBLC |- (typeIR_key ':' "lpm") '@' '_' : (LPM 0) '_'
  -- if TBLC.MODE = LPM _

rule TableEntry_keyset_simple_ok/non-lpm:
  TC TBLC |- (typeIR_key ':' nameIR_matchkind) '@' '_' : NON_LPM '_'
  -- if nameIR_matchkind =/= "lpm"
  -- if nameIR_matchkind =/= "exact"

relation TableEntry_keysets_simple_ok:
  typingContext tableContext tableEntryState
    |- matchKey* '@' simpleKeysetExpression*
    : tableEntryState simpleKeysetExpressionIR*
  hint(input %0 %1 %2 %3 %4)

rule TableEntry_keysets_simple_ok/nil:
  TC TBLC TBLS |- eps '@' eps : TBLS eps

rule TableEntry_keysets_simple_ok/cons:
  TC TBLC TBLS_0
    |- (matchKey_h :: matchKey_t*)
       '@'
       (simpleKeysetExpression_h :: simpleKeysetExpression_t*)
    : TBLS_3 (simpleKeysetExpressionIR_h :: simpleKeysetExpressionIR_t*)
  -- TableEntry_keyset_simple_ok:
       TC TBLC
         |- matchKey_h '@' simpleKeysetExpression_h
         : TBLS_1 simpleKeysetExpressionIR_h
  -- if TBLS_2 = $join_tableEntryState(TBLS_0, TBLS_1)
  -- TableEntry_keysets_simple_ok:
       TC TBLC TBLS_2
         |- matchKey_t* '@' simpleKeysetExpression_t*
         : TBLS_3 simpleKeysetExpressionIR_t*

rule TableEntry_keyset_ok/expression:
  TC TBLC |- expression : TBLS simpleKeysetExpressionIR
  -- if |TBLC.KEYS| = 1
  -- TableEntry_keysets_simple_ok:
       TC TBLC NON_LPM
         |- TBLC.KEYS '@' expression
         : TBLS simpleKeysetExpressionIR

rule TableEntry_keyset_ok/simple:
  TC TBLC |- expression_l '&&&' expression_r : TBLS simpleKeysetExpressionIR
  -- if |TBLC.KEYS| = 1
  -- TableEntry_keysets_simple_ok:
       TC TBLC NON_LPM
         |- TBLC.KEYS '@' (expression_l '&&&' expression_r)
         : TBLS simpleKeysetExpressionIR

rule TableEntry_keyset_ok/tuple:
  TC TBLC
    |- `(expression_l '&&&' expression_r)
    : TBLS (`(simpleKeysetExpressionIR))
  -- if |TBLC.KEYS| = 1
  -- TableEntry_keysets_simple_ok:
       TC TBLC NON_LPM
         |- TBLC.KEYS '@' (expression_l '&&&' expression_r)
         : TBLS simpleKeysetExpressionIR

rule TableEntry_keyset_ok/simple:
  TC TBLC |- expression_l '..' expression_r : TBLS simpleKeysetExpressionIR
  -- if |TBLC.KEYS| = 1
  -- TableEntry_keysets_simple_ok:
       TC TBLC NON_LPM
         |- TBLC.KEYS '@' (expression_l '..' expression_r)
         : TBLS simpleKeysetExpressionIR

rule TableEntry_keyset_ok/tuple:
  TC TBLC
    |- `(expression_l '..' expression_r)
    : TBLS (`(simpleKeysetExpressionIR))
  -- if |TBLC.KEYS| = 1
  -- TableEntry_keysets_simple_ok:
       TC TBLC NON_LPM
         |- TBLC.KEYS '@' (expression_l '..' expression_r)
         : TBLS simpleKeysetExpressionIR

