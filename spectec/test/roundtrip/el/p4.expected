  : constructorId
  hint(prose_in "constructor id of " %0)

def $constructorId_of_externConstructorPrototype(_
                                                 typeIdentifier
                                                 `(parameterList)
                                                 ';')
  = $callableId(typeIdentifier, parameterList)

