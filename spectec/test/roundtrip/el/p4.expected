;; === 5-typing/5.04-typing-relation.spectec ===
relation ExternFunctionCall_eval_lctk:
  typingContext |- nameIR `(nameIR*) ~> value
  hint(input %0 %1 %2)
  hint(testgen_ignore)
  hint(prose_in "calling an extern function" %1#"("#%2#")" "under context" %0)
  hint(prose_out %3)

relation Expr_eval_lctk: cursor typingContext |- typedExpressionIR ~> value
  hint(input %0 %1 %2)
  hint(testgen_ignore)
  hint(prose_in "local compile-time evaluation of" %2#", under context"
                %1
                "at"
                %0)
  hint(prose_out %3)

relation Argument_eval_lctk: cursor typingContext |- argumentIR ~> value
  hint(input %0 %1 %2)
  hint(testgen_ignore)
  hint(prose_in "local compile-time evaluation of" %2#", under context"
                %1
                "at"
                %0)
  hint(prose_out %3)

relation Type_ok: cursor typingContext |- typeOrVoid : typeIR '#' typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under context" %1 "at" %0)
  hint(prose_out %3 "and fresh type variables" %4)

relation TypeParameterListOpt_ok:
  cursor typingContext |- typeParameterListOpt : typingContext typeId*
