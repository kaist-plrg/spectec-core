  = $result_concat(typeIR_l, typeIR_r)

def $result_concat(typeIR_l, TYPEDEF _ typeIR_r)
  = $result_concat(typeIR_l, typeIR_r)
  -- if ~(typeIR_l <: typedefTypeIR)

