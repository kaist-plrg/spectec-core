        = $add_constructorDef_non_overload_t(TC_4,
                                             constructorId,
                                             constructorTypeDefIR)
  -- if packageTypeDeclarationIR
        = annotationList
          PACKAGE
          nameIR
          `<typeId_expl* ',' typeId_impl*>
          `(constructorParameterIR*)
          ';'

rule Decls_ok/nil:
