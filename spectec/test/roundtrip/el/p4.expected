  | '<'
  | '>'
  | '!'
  | ':'
  | ','
  | '?'
  | '.'
  | '='
  | ';'
  | '@'

syntax annotationBody =
  | _EMPTY
  | annotationBody `(annotationBody)
  | annotationBody annotationToken

syntax structuredAnnotationBody =
  | sequenceOrRecordElementExpression trailingCommaOpt

syntax annotation =
  | '@' name hint(print "@"#%0)
  | '@' name `(annotationBody) hint(print "@"#%0#"("#%1#")")
  | '@' name `[structuredAnnotationBody] hint(print "@"#%0#"["#%1#"]")
  | '@' PRAGMA name annotationBody hint(print "@pragma" %0 %1)

