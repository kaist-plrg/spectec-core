def $compat_bitwise(INT `<w_l>, INT `<w_r>) = w_l = w_r

def $compat_bitwise(BIT `<w_l>, BIT `<w_r>) = w_l = w_r

def $compat_bitwise(TYPEDEF _ typeIR_l, typeIR_r)
  = $compat_bitwise(typeIR_l, typeIR_r)

def $compat_bitwise(typeIR_l, TYPEDEF _ typeIR_r)
