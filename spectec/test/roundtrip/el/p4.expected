  = (localKind = CONTROL_APPLY_METHOD) \/ (localKind = TABLE_APPLY_METHOD)
  -- if localKind = TC.LOCAL.KIND

rule Call_ok/tableApplyMethodTypeIR:
  p TC
    |- tableApplyMethodTypeIR `<eps '#' eps> `(eps '#' eps '#' eps)
    : tableMetadataStructTypeIR `<eps> `(eps)
  -- if TABLE_APPLY ':' tableMetadataStructTypeIR = tableApplyMethodTypeIR
  -- if $callable_tableApplyMethod(p, TC)
;; === 6-dynamic-runtime/6.0-domain.spectec ===
dec $callableId_IR(nameIR, parameterListIR) : callableId
  hint(prose_in "the callable identifier for" %0 `(%1))

def $callableId_IR(nameIR, parameterIR*) = nameIR `(id*)
  -- (if (_ _ _ id _ = parameterIR))*
;; === 6-dynamic-runtime/6.1-storage-reference.spectec ===
syntax storageReference =
  | referenceExpressionIR
  | storageReference '.' nameIR
  | storageReference `[value]
  | storageReference `[value ':' value]
  | storageReference `[value '+' : value]
;; === 6-dynamic-runtime/6.2.1-callable-def.spectec ===
syntax stateEnv, actionDefEnv, frame, tableObjectProperty

syntax actionDef =
  | annotationList ACTION nameIR `(parameterListIR) blockStatementIR

syntax definedFunctionDef =
  | FUNCTION nameIR `<typeParameterListIR> `(parameterListIR) blockStatementIR

syntax externFunctionDef =
  | EXTERN_FUNCTION nameIR `<typeParameterListIR> `(parameterListIR)

syntax functionDef =
  | definedFunctionDef
  | externFunctionDef

syntax externMethodDef =
  | EXTERN_METHOD
    nameIR
    `<typeParameterListIR>
    `(parameterListIR)
    blockStatementIR?
  | EXTERN_METHOD ABSTRACT nameIR `<typeParameterListIR> `(parameterListIR)

syntax parserApplyMethodDef =
  | PARSER_APPLY `(parameterListIR) `{parserLocalDeclarationListIR ';' stateEnv}

syntax controlApplyMethodDef =
  | CONTROL_APPLY
    `(parameterListIR)
    `{controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR}

syntax tableApplyMethodDef =
  | TABLE_APPLY `{tablePropertyListIR}

syntax methodDef =
  | externMethodDef
  | parserApplyMethodDef
  | controlApplyMethodDef
  | tableApplyMethodDef

syntax callableDef =
  | actionDef
  | functionDef
  | methodDef
;; === 6-dynamic-runtime/6.2.2-callable-def-aux.spectec ===
dec $parameterListIR_of_callableDef(callableDef) : parameterIR*

dec $parameterListIR_of_actionDef(actionDef) : parameterIR*

def $parameterListIR_of_actionDef(annotationList ACTION _ `(parameterListIR) _)
  = parameterListIR

def $parameterListIR_of_callableDef(actionDef)
  = $parameterListIR_of_actionDef(actionDef)

dec $parameterListIR_of_functionDef(functionDef) : parameterIR*

dec $parameterListIR_of_definedFunctionDef(definedFunctionDef) : parameterIR*

def $parameterListIR_of_definedFunctionDef(FUNCTION _ `<_> `(parameterListIR) _)
  = parameterListIR

dec $parameterListIR_of_externFunctionDef(externFunctionDef) : parameterIR*

def $parameterListIR_of_externFunctionDef(EXTERN_FUNCTION
                                          _
                                          `<_>
                                          `(parameterListIR))
  = parameterListIR

def $parameterListIR_of_functionDef(definedFunctionDef)
  = $parameterListIR_of_definedFunctionDef(definedFunctionDef)

def $parameterListIR_of_functionDef(externFunctionDef)
  = $parameterListIR_of_externFunctionDef(externFunctionDef)

def $parameterListIR_of_callableDef(functionDef)
  = $parameterListIR_of_functionDef(functionDef)

dec $parameterListIR_of_methodDef(methodDef) : parameterIR*

dec $parameterListIR_of_externMethodDef(externMethodDef) : parameterIR*

def $parameterListIR_of_externMethodDef(EXTERN_METHOD
                                        _
                                        `<_>
                                        `(parameterListIR)
                                        _)
  = parameterListIR

dec $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)
  : parameterIR*

def $parameterListIR_of_parserApplyMethodDef(PARSER_APPLY
                                             `(parameterListIR)
                                             `{_ ';' _})
  = parameterListIR

dec $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)
  : parameterIR*

def $parameterListIR_of_controlApplyMethodDef(CONTROL_APPLY
                                              `(parameterListIR)
                                              `{_ ';' _ ';' _})
  = parameterListIR

dec $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef) : parameterIR*

def $parameterListIR_of_tableApplyMethodDef(TABLE_APPLY `{_}) = eps

def $parameterListIR_of_methodDef(externMethodDef)
  = $parameterListIR_of_externMethodDef(externMethodDef)

def $parameterListIR_of_methodDef(parserApplyMethodDef)
  = $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)

def $parameterListIR_of_methodDef(controlApplyMethodDef)
  = $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)

def $parameterListIR_of_methodDef(tableApplyMethodDef)
  = $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef)

def $parameterListIR_of_callableDef(methodDef)
  = $parameterListIR_of_methodDef(methodDef)
;; === 6-dynamic-runtime/6.2.3-callable-callee.spectec ===
syntax actionCallee =
  | ACTION cursor '.' nameIR `(parameterListIR '#' id*) blockStatementIR

syntax definedFunctionCallee =
  | FUNCTION
    nameIR
    `<typeParameterListIR>
    `(parameterListIR '#' id*)
    blockStatementIR

syntax externFunctionCallee =
  | EXTERN_FUNCTION
    nameIR
    `<typeParameterListIR>
    `(parameterListIR '#' id* '#' id*)

syntax functionCallee =
  | definedFunctionCallee
  | externFunctionCallee

syntax builtinMethodCallee =
  | BUILTIN_METHOD
    storageReference
    '.'
    nameIR
    `<typeArgumentListIR>
    `(parameterListIR)

syntax externMethodCallee =
  | EXTERN_METHOD
    objectId
    '.'
    nameIR
    `<typeParameterListIR>
    `(parameterListIR '#' id* '#' id*)
    `{theta ';' frame ';' blockStatementIR?}

syntax parserApplyMethodCallee =
  | PARSER
    objectId
    '.'
    APPLY
    `(parameterListIR '#' id*)
    `{theta ';' frame ';' parserLocalDeclarationListIR ';' stateEnv}

syntax controlApplyMethodCallee =
  | CONTROL
    objectId
    '.'
    APPLY
    `(parameterListIR '#' id*)
    `{theta
      ';'
      frame
      ';'
      controlLocalDeclarationListIR
      ';'
      actionDefEnv
      ';'
      controlBodyIR}

syntax tableApplyMethodCallee =
  | TABLE objectId '.' APPLY `{frame ';' tableObjectProperty}

syntax methodCallee =
  | builtinMethodCallee
  | externMethodCallee
  | parserApplyMethodCallee
  | controlApplyMethodCallee
  | tableApplyMethodCallee

syntax callee =
  | actionCallee
  | functionCallee
  | methodCallee
;; === 6-dynamic-runtime/6.3.1-constructor-def.spectec ===
syntax externObjectConstructorDef =
  | EXTERN
    nameIR
    `<typeParameterListIR>
    `(constructorParameterListIR)
    `{externMethodPrototypeListIR}

syntax parserObjectConstructorDef =
  | PARSER
    `<typeParameterListIR>
    `(parameterListIR)
    `(constructorParameterListIR)
    `{parserLocalDeclarationListIR parserStateListIR}

syntax controlObjectConstructorDef =
  | CONTROL
    `<typeParameterListIR>
    `(parameterListIR)
    `(constructorParameterListIR)
    `{controlLocalDeclarationListIR APPLY controlBodyIR}

syntax packageObjectConstructorDef =
  | PACKAGE `<typeParameterListIR> `(constructorParameterListIR)

syntax constructorDef =
  | externObjectConstructorDef
  | parserObjectConstructorDef
  | controlObjectConstructorDef
  | packageObjectConstructorDef
;; === 6-dynamic-runtime/6.3.2-constructor-def-aux.spectec ===
dec $parameterListIR_of_constructorDef(constructorDef) : parameterIR*

def $parameterListIR_of_constructorDef(EXTERN
                                       _
                                       `<_>
                                       `(constructorParameterListIR)
                                       `{_})
  = constructorParameterListIR

def $parameterListIR_of_constructorDef(PARSER
                                       `<_>
                                       `(_)
                                       `(constructorParameterListIR)
                                       `{_ _})
  = constructorParameterListIR

def $parameterListIR_of_constructorDef(CONTROL
                                       `<_>
                                       `(_)
                                       `(constructorParameterListIR)
                                       `{_ APPLY _})
  = constructorParameterListIR

def $parameterListIR_of_constructorDef(PACKAGE
                                       `<_>
                                       `(constructorParameterListIR))
  = constructorParameterListIR
;; === 6-dynamic-runtime/6.4.1-object.spectec ===
syntax objectState

syntax externMethodDefEnv = map<callableId, externMethodDef>

dec $init_objectState(nameIR, typeIR*, value*) : objectState
  hint(prose_in "initialization of" %0#`<%1>#`(%2) "in the target")

syntax externObject =
  | EXTERN typeId `<theta> `{objectState frame externMethodDefEnv}

syntax parserObject =
  | PARSER
    `<theta>
    `(parameterListIR)
    `{frame parserLocalDeclarationListIR stateEnv}

syntax actionDefEnv = map<callableId, actionDef>

syntax controlObject =
  | CONTROL
    `<theta>
    `(parameterListIR)
    `{frame controlLocalDeclarationListIR actionDefEnv controlBodyIR}

syntax packageObject =
  | PACKAGE `<theta> `{frame}

syntax tableObjectProperty =
  {KEYS tableKeysPropertyIR,
   ACTIONS tableActionsPropertyIR,
   DEFAULT_ACTION tableDefaultActionPropertyIR,
   ENTRIES tableEntriesPropertyIR,
   CUSTOMS tableCustomPropertyIR*}

var TBL : tableObjectProperty

syntax tableObject =
  | TABLE typeId `{frame tableObjectProperty}

syntax valueSetObject =
  | VALUE_SET `{value* `(nat)}

syntax object =
  | externObject
  | parserObject
  | controlObject
  | packageObject
  | tableObject
  | valueSetObject
;; === 7-instantiation/7.01.1-dynamic-env.spectec ===
syntax frame = map<id, value>

dec $empty_frame : frame

def $empty_frame = $empty_map<id, value>

syntax stateEnv = map<id, parserStateIR>

dec $empty_stateEnv : stateEnv

def $empty_stateEnv = $empty_map<id, parserStateIR>

syntax callableDefEnv = map<callableId, callableDef>

dec $empty_callableDefEnv : callableDefEnv

def $empty_callableDefEnv = $empty_map<callableId, callableDef>

syntax constructorDefEnv = map<callableId, constructorDef>

dec $empty_constructorDefEnv : constructorDefEnv

def $empty_constructorDefEnv = $empty_map<callableId, constructorDef>
;; === 7-instantiation/7.01.2-dynamic-store.spectec ===
syntax store = map<objectId, object>

var STO : store

dec $empty_store : store
  hint(prose_in "an empty store")

def $empty_store = store
  -- if store = $empty_map<objectId, object>

dec $add_store(store, objectId, object) : store
  hint(prose_in %0 "where" %1 "to" %2 "is added")

def $add_store(store, objectId, object) = store'
  -- if store' = $add_map<objectId, object>(store, objectId, object)

dec $find_store(store, objectId) : object
  hint(prose_in "the object" %1 "in" %0)

def $find_store(store, objectId) = object
  -- if object = $find_map<objectId, object>(store, objectId)
;; === 7-instantiation/7.02-inst-context.spectec ===
syntax globalInstLayer =
  {CONSTRUCTOR constructorDefEnv,
   TYPE typeDefEnv,
   CALLABLE callableDefEnv,
   FRAME frame}

syntax blockInstLayer =
  {TYPE theta, CALLABLE callableDefEnv, STATE stateEnv, FRAME frame}

syntax localInstLayer = {TYPE theta, FRAMES frame*}

syntax instContext =
  {PATH objectId,
   GLOBAL globalInstLayer,
   BLOCK blockInstLayer,
   LOCAL localInstLayer}

var IC : instContext

dec $empty_instContext : instContext
  hint(prose_in "an empty instantiation context")

def $empty_instContext = IC
  -- if globalInstLayer
        = {CONSTRUCTOR $empty_constructorDefEnv,
           TYPE $empty_typeDefEnv,
           CALLABLE $empty_callableDefEnv,
           FRAME $empty_frame}
  -- if blockInstLayer
        = {TYPE $empty_theta,
           CALLABLE $empty_callableDefEnv,
           STATE $empty_stateEnv,
           FRAME $empty_frame}
  -- if localInstLayer = {TYPE $empty_theta, FRAMES ([$empty_frame])}
  -- if IC
        = {PATH ([]),
           GLOBAL globalInstLayer,
           BLOCK blockInstLayer,
           LOCAL localInstLayer}

dec $enter_i(instContext) : instContext
  hint(prose_in %0 "with a new local frame")

def $enter_i(IC) = IC[.LOCAL.FRAMES = $empty_frame :: IC.LOCAL.FRAMES]

dec $exit_i(instContext) : instContext
  hint(prose_in %0 "with the innermost frame removed")

def $exit_i(IC) = IC[.LOCAL.FRAMES = frame_t*]
  -- if IC.LOCAL.FRAMES = frame_h :: frame_t*

dec $enter_path_i(instContext, id) : instContext
  hint(prose_in %0 "with" %1 "added to the path")

def $enter_path_i(IC, id) = IC[.PATH = IC.PATH ++ id]

dec $inherit_i(cursor, instContext) : instContext
  hint(prose_in "an instantiation context same as" %1 "up to the" %0 "layer")

def $inherit_i(GLOBAL, IC)
  = IC[.BLOCK = blockInstLayer][.LOCAL = localInstLayer]
  -- if blockInstLayer
        = {TYPE $empty_theta,
           CALLABLE $empty_callableDefEnv,
           STATE $empty_stateEnv,
           FRAME $empty_frame}
  -- if localInstLayer = {TYPE $empty_theta, FRAMES ([$empty_frame])}

def $inherit_i(BLOCK, IC) = IC[.LOCAL = localInstLayer]
  -- if localInstLayer = {TYPE $empty_theta, FRAMES ([$empty_frame])}

def $inherit_i(LOCAL, IC) = IC

dec $add_var_i(cursor, instContext, id, value) : instContext
  hint(prose_in %1 "where" %2 "to" %3 "is added to the" %0 "layer")

dec $add_vars_i(cursor, instContext, id*, value*) : instContext
  hint(prose_in %1
                "where each of"
                %2
                "to each of"
                %3
                "are added to the"
                %0
                "layer")

def $add_var_i(GLOBAL, IC, id, value) = IC[.GLOBAL.FRAME = frame]
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.GLOBAL.FRAME))
  -- if frame = $add_map<id, value>(IC.GLOBAL.FRAME, id, value)

def $add_var_i(BLOCK, IC, id, value) = IC[.BLOCK.FRAME = frame]
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.BLOCK.FRAME))
  -- if frame = $add_map<id, value>(IC.BLOCK.FRAME, id, value)

def $add_var_i(LOCAL, IC, id, value) = IC[.LOCAL.FRAMES = frame_h' :: frame_t*]
  -- if IC.LOCAL.FRAMES = frame_h :: frame_t*
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
  -- if frame_h' = $add_map<id, value>(frame_h, id, value)

def $add_vars_i(p, IC, eps, eps) = IC

def $add_vars_i(p, IC, id_h :: id_t*, value_h :: value_t*) = IC''
  -- if IC' = $add_var_i(p, IC, id_h, value_h)
  -- if IC'' = $add_vars_i(p, IC', id_t*, value_t*)

dec $add_typeDef_i(cursor, instContext, typeId, typeDefIR) : instContext
  hint(prose_in %1 "where" %2 "to" %3 "is added to the" %0 "layer")

def $add_typeDef_i(GLOBAL, IC, typeId, typeDefIR)
  = IC[.GLOBAL.TYPE = typeDefEnv]
  -- if typeDefEnv
        = $add_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, typeId, typeDefIR)

dec $add_parserState_i(instContext, nameIR, parserStateIR) : instContext
  hint(prose_in %0 "where" %1 "to" %2 "is added")

def $add_parserState_i(IC, nameIR, parserStateIR) = IC[.BLOCK.STATE = stateEnv]
  -- if ~$in_set<nameIR>(nameIR, $dom_map<nameIR, parserStateIR>(IC.BLOCK.STATE))
  -- if stateEnv
        = $add_map<nameIR, parserStateIR>(IC.BLOCK.STATE, nameIR, parserStateIR)

dec $add_type_i(cursor, instContext, typeId, typeIR) : instContext

dec $add_types_i(cursor, instContext, typeId*, typeIR*) : instContext

def $add_type_i(BLOCK, IC, typeId, typeIR) = IC[.BLOCK.TYPE = theta]
  -- if theta = $add_map<typeId, typeIR>(IC.BLOCK.TYPE, typeId, typeIR)

def $add_type_i(LOCAL, IC, typeId, typeIR) = IC[.LOCAL.TYPE = theta]
  -- if theta = $add_map<typeId, typeIR>(IC.LOCAL.TYPE, typeId, typeIR)

def $add_types_i(p, IC, eps, eps) = IC

def $add_types_i(p, IC, typeId_h :: typeId_t*, typeIR_h :: typeIR_t*)
  = $add_types_i(p, IC', typeId_t*, typeIR_t*)
  -- if IC' = $add_type_i(p, IC, typeId_h, typeIR_h)

dec $add_callableDef_overload_i(cursor, instContext, callableId, callableDef)
  : instContext
  hint(prose_in %1
                "where"
                %2
                "to"
                %3
                "is added as an overloaded callable to the"
                %0
                "layer")

def $add_callableDef_overload_i(GLOBAL, IC, callableId, callableDef)
  = IC[.GLOBAL.CALLABLE = callableDefEnv]
  -- if ~$in_set<callableId>(callableId,
                             $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE))
  -- if callableDefEnv
        = $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE,
                                            callableId,
                                            callableDef)

def $add_callableDef_overload_i(BLOCK, IC, callableId, callableDef)
  = IC[.BLOCK.CALLABLE = callableDefEnv]
  -- if ~$in_set<callableId>(callableId,
                             $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE))
  -- if callableDefEnv
        = $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE,
                                            callableId,
                                            callableDef)

dec $add_callableDef_non_overload_i(cursor, instContext, callableId, callableDef)
  : instContext
  hint(prose_in %1
                "where"
                %2
                "to"
                %3
                "is added as a non-overloaded callable to the"
                %0
                "layer")

def $add_callableDef_non_overload_i(GLOBAL, IC, callableId, callableDef)
  = IC[.GLOBAL.CALLABLE = callableDefEnv]
  -- if id `(_) = callableId
  -- if `{(id_k `(_))*} = $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE)
  -- if ~$in_set<id>(id, `{id_k*})
  -- if callableDefEnv
        = $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE,
                                            callableId,
                                            callableDef)

def $add_callableDef_non_overload_i(BLOCK, IC, callableId, callableDef)
  = IC[.BLOCK.CALLABLE = callableDefEnv]
  -- if id `(_) = callableId
  -- if `{(id_k `(_))*} = $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE)
  -- if ~$in_set<id>(id, `{id_k*})
  -- if callableDefEnv
        = $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE,
                                            callableId,
                                            callableDef)

dec $find_callableDef_non_overload_i(cursor, instContext, prefixedNameIR)
  : (cursor, callableId, callableDef)?
  hint(prose_in "the non-overloaded callable definition of"
                %2
                "from the"
                %0
                "layer of"
                %1)

def $find_callableDef_non_overload_i(p, IC, '.' nameIR) = eps
  -- if eps = $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR)

def $find_callableDef_non_overload_i(p, IC, '.' nameIR)
  = (GLOBAL, callableId, callableDef)
  -- if (callableId, callableDef)
        = $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR)

def $find_callableDef_non_overload_i(GLOBAL, IC, _NAME nameIR)
  = $find_callableDef_non_overload_i(GLOBAL, IC, '.' nameIR)

def $find_callableDef_non_overload_i(BLOCK, IC, _NAME nameIR)
  = (BLOCK, callableId, callableDef)
  -- if (callableId, callableDef)
        = $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR)

def $find_callableDef_non_overload_i(BLOCK, IC, _NAME nameIR)
  = $find_callableDef_non_overload_i(GLOBAL, IC, _NAME nameIR)
  -- if eps = $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR)

def $find_callableDef_non_overload_i(LOCAL, IC, _NAME nameIR)
  = $find_callableDef_non_overload_i(BLOCK, IC, _NAME nameIR)

dec $add_constructorDef_i(instContext, callableId, constructorDef) : instContext
  hint(prose_in "where" %1 "to" %2 "is added to" %0)

dec $add_constructorDefs_i(instContext, callableId*, constructorDef*)
  : instContext
  hint(prose_in "where each of" %1 "to each of" %2 "are added to" %0)

def $add_constructorDef_i(IC, callableId, constructorDef)
  = IC[.GLOBAL.CONSTRUCTOR = constructorDefEnv]
  -- if constructorDefEnv
        = $add_map<callableId, constructorDef>(IC.GLOBAL.CONSTRUCTOR,
                                               callableId,
                                               constructorDef)

def $add_constructorDefs_i(IC, eps, eps) = IC

def $add_constructorDefs_i(IC,
                           callableId_h :: callableId_t*,
                           constructorDef_h :: constructorDef_t*)
  = IC''
  -- if IC' = $add_constructorDef_i(IC, callableId_h, constructorDef_h)
  -- if IC'' = $add_constructorDefs_i(IC', callableId_t*, constructorDef_t*)

dec $find_var_i(prefixedNameIR, cursor, instContext) : value
  hint(prose_in "the value of" %0 "from the" %1 "layer of" %2)

def $find_var_i('.' id, p, IC) = value
  -- if value = $find_map<id, value>(IC.GLOBAL.FRAME, id)

def $find_var_i(_NAME id, GLOBAL, IC) = value
  -- if value = $find_map<id, value>(IC.GLOBAL.FRAME, id)

def $find_var_i(_NAME id, BLOCK, IC) = value
  -- if value = $find_map<id, value>(IC.BLOCK.FRAME, id)

def $find_var_i(_NAME id, BLOCK, IC) = $find_var_i(_NAME id, GLOBAL, IC)
  -- if eps = $find_map<id, value>(IC.BLOCK.FRAME, id)

def $find_var_i(_NAME id, LOCAL, IC) = value
  -- if value = $find_maps<id, value>(IC.LOCAL.FRAMES, id)

def $find_var_i(_NAME id, LOCAL, IC) = $find_var_i(_NAME id, BLOCK, IC)
  -- if eps = $find_maps<id, value>(IC.LOCAL.FRAMES, id)

dec $find_typeDef_i(cursor, instContext, prefixedNameIR) : typeDefIR?
  hint(prose_in "the type definition of" %2 "from the" %0 "layer of" %1)

def $find_typeDef_i(_, IC, _NAME nameIR)
  = $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)

def $find_typeDef_i(_, IC, '.' nameIR)
  = $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)

dec $find_constructorDef_i(instContext, prefixedNameIR, argumentIR*)
  : callResolution<constructorDef>?
  hint(prose_in "the overloaded constructor definition of" %1 `(%2) "in" %0)

def $find_constructorDef_i(IC, _NAME nameIR, argumentIR*)
  = $find_overloaded<constructorDef>(IC.GLOBAL.CONSTRUCTOR,
                                     callTargetKey,
                                     def $parameterListIR_of_constructorDef)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)

def $find_constructorDef_i(IC, '.' nameIR, argumentIR*)
  = $find_overloaded<constructorDef>(IC.GLOBAL.CONSTRUCTOR,
                                     callTargetKey,
                                     def $parameterListIR_of_constructorDef)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)

dec $subst_type_i(cursor, instContext, typeIR) : typeIR
  hint(prose_in %2
                "substituted by bound type variables in"
                %1
                "from the"
                %0
                "layer")

def $subst_type_i(GLOBAL, IC, typeIR) = typeIR

def $subst_type_i(BLOCK, IC, typeIR) = typeIR_subst
  -- if theta = IC.BLOCK.TYPE
  -- if typeIR_subst = $subst_typeIR(theta, typeIR)

def $subst_type_i(LOCAL, IC, typeIR) = typeIR_subst
  -- if theta_block = IC.BLOCK.TYPE
  -- if theta_local = IC.LOCAL.TYPE
  -- if theta = $extend_map<typeId, typeIR>(theta_block, theta_local)
  -- if typeIR_subst = $subst_typeIR(theta, typeIR)
;; === 7-instantiation/7.03-inst-relation.spectec ===
relation Expr_inst: cursor instContext store |- typedExpressionIR : store value
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %4 "and" %5)

relation Exprs_inst:
  cursor instContext store |- typedExpressionIR* : store value*
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %4 "and" %5)

relation Argument_inst: cursor instContext store |- argumentIR : store value
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %4 "and" %5)

relation DirectApplicationStmt_inst:
  cursor instContext store
    |- directApplicationStatementIR
    : store constantDeclarationIR callStatementIR
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %4 "and desugared" %5#"," %6)

relation Stmt_inst:
  cursor instContext store |- statementIR : instContext store statementIR
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "context" %4#", store" %5#", and" %6)

relation BlockElementStmt_inst:
  instContext store
    |- blockElementStatementIR
    : instContext store blockElementStatementIR
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#", and store"
                %1)
  hint(prose_out "context" %3#", store" %4#", and" %5)

relation BlockElementStmtList_inst:
  instContext store
    |- blockElementStatementListIR
    : instContext store blockElementStatementIR*
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#", and store"
                %1)
  hint(prose_out "context" %3#", store" %4#", and" %5)

relation Block_inst:
  instContext store |- blockStatementIR : instContext store blockStatementIR
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#", and store"
                %1)
  hint(prose_out "context" %3#", store" %4#", and" %5)

relation ExternMethod_inst: instContext |- externMethodPrototypeIR : instContext
  hint(input %0 %1)

relation ExternMethods_inst:
  instContext |- externMethodPrototypeIR* : instContext
  hint(input %0 %1)
  hint(prose_in "compile-time evaluation of" %1#", under context" %0)
  hint(prose_out "context" %2)

relation ParserStmt_inst:
  instContext store |- parserStatementIR : instContext store parserStatementIR
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context"
                %0
                "and store"
                %1)
  hint(prose_out "context" %3 "and store" %4)

relation ParserStmts_inst:
  instContext store |- parserStatementIR* : instContext store parserStatementIR*
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context"
                %0
                "and store"
                %1)
  hint(prose_out "context" %3 "and store" %4)

relation ParserState_inst:
  instContext store |- parserStateIR : instContext store
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context"
                %0
                "and store"
                %1)
  hint(prose_out "context" %3 "and store" %4)

relation ParserStates_inst:
  instContext store |- parserStateIR* : instContext store
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context"
                %0
                "and store"
                %1)
  hint(prose_out "context" %3 "and store" %4)

relation ParserLocalDecl_inst:
  instContext store
    |- parserLocalDeclarationIR
    : instContext store parserLocalDeclarationIR
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context"
                %0
                "and store"
                %1)
  hint(prose_out "context" %3#", store" %4#", and" %5)

relation ParserLocalDecls_inst:
  instContext store
    |- parserLocalDeclarationIR*
    : instContext store parserLocalDeclarationIR*
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context"
                %0
                "and store"
                %1)
  hint(prose_out "context" %3#", store" %4#", and" %5)

relation TableAction_inst:
  instContext store |- tableActionIR : store tableActionIR
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#"and store"
                %1)
  hint(prose_out "store" %3 "and" %4)

relation TableActions_inst:
  instContext store |- tableActionIR* : store tableActionIR*
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#"and store"
                %1)
  hint(prose_out "store" %3 "and" %4)

relation TableProperty_inst:
  instContext store |- tablePropertyIR : store tablePropertyIR
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#"and store"
                %1)
  hint(prose_out "store" %3 "and" %4)

relation TableProperties_inst:
  instContext store |- tablePropertyIR* : store tablePropertyIR*
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#"and store"
                %1)
  hint(prose_out "store" %3 "and" %4)

relation ControlLocalDecl_inst:
  instContext store
    |- controlLocalDeclarationIR
    : instContext store controlLocalDeclarationIR?
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#"and store"
                %1)
  hint(prose_out "context" %3#", store" %4#", and" %5)

relation ControlLocalDecls_inst:
  instContext store
    |- controlLocalDeclarationIR*
    : instContext store controlLocalDeclarationIR*
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#"and store"
                %1)
  hint(prose_out "context" %3#", store" %4#", and" %5)

relation ConstDecl_inst:
  cursor instContext |- constantDeclarationIR : instContext
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %1 "at" %0)
  hint(prose_out "context" %3)

relation InstDecl_inst:
  cursor instContext store
    |- instantiationIR
    : instContext store constantDeclarationIR
  hint(input %0 %1 %2 %3)
  hint(prose_in "loading" %3#", under context" %1 "and store" %2 "at" %0)
  hint(prose_out "context" %4#", store" %5#"," "and reference to object" %6)

relation FuncDecl_inst:
  cursor instContext |- functionDeclarationIR : instContext
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %1 "at" %0)
  hint(prose_out "context" %3)

relation ActionDecl_inst:
  cursor instContext |- actionDeclarationIR : instContext
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %1 "at" %0)
  hint(prose_out "context" %3)

relation Decl_inst: instContext store |- declarationIR : instContext store
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %0#", and store" %1)
  hint(prose_out "context" %4 "and store" %5)

relation Decls_inst: instContext store |- declarationIR* : instContext store
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %0#", and store" %1)
  hint(prose_out "context" %4 "and store" %5)

relation Program_inst: |- p4program : globalInstLayer store
  hint(input %0)
  hint(prose_in "loading" %0)
  hint(prose_out "global instantiation layer" %1 "and store" %2)

relation Copy_in_argument_inst:
  store cursor instContext argumentIR '@' cursor instContext id
    ~> store instContext
  hint(input %0 %1 %2 %3 %4 %5 %6)

relation Copy_in_inst:
  store cursor instContext argumentIR* '@' cursor instContext id*
    ~> store instContext
  hint(input %0 %1 %2 %3 %4 %5 %6)
  hint(prose_in "copy-in from" %2 "at" %1 "with" %3 "to" %5 "at" %4 "with" %6#", under store"
                %0)
  hint(prose_out "store" %7 "and context" %8)

relation Copy_in_argument_inst_default:
  store cursor instContext '@' cursor instContext parameterIR
    ~> store instContext
  hint(input %0 %1 %2 %3 %4 %5)

relation Copy_in_inst_default:
  store cursor instContext '@' cursor instContext parameterIR*
    ~> store instContext
  hint(input %0 %1 %2 %3 %4 %5)
  hint(prose_in "copying defaults" %5 "from" %1 "at" %2 "to" %4 "at" %3#", under store"
                %0)
  hint(prose_out "store" %6 "and context" %7)

relation Constructor_inst:
  cursor instContext
    |- prefixedNameIR `<typeArgumentListIR> `(argumentListIR)
    : constructorDef `<typeArgumentListIR> `('#' id* '#' id*)
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "finding constructor for"
                %2
                `<%3>
                `(%4)
                "under context"
                %1
                "at"
                %0)
  hint(prose_out "constructor" %5 `<%6> "with defaults" %7 "and optionals" %8)

relation Constructor_call:
  cursor instContext store
    |- constructorDef `<typeArgumentListIR> `(argumentListIR '#' id* '#' id*)
    : store object
  hint(input %0 %1 %2 %3 %4 %5 %6 %7)
  hint(prose_in "instantiating"
                %3
                `<%4>
                `(%5)
                "with defaults"
                %6
                "and optionals"
                %7#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %8 "and instantiated" %9)
;; === 7-instantiation/7.04-inst-expression.spectec ===
rule Expr_inst/booleanLiteral:
  p IC STO |- booleanLiteral '#' _ : STO boolValue
  -- if boolValue = $ite<boolValue>(booleanLiteral = TRUE, _B true, _B false)

rule Expr_inst/integerLiteral:
  p IC STO |- integerLiteral '#' _ : STO integerLiteral

rule Expr_inst/stringLiteral:
  p IC STO |- stringLiteral '#' _ : STO stringLiteral

rule Expr_inst/referenceExpressionIR:
  p IC STO |- prefixedNameIR '#' _ : STO value
  -- if value = $find_var_i(prefixedNameIR, p, IC)

rule Expr_inst/defaultExpressionIR:
  p IC STO |- '...' '#' _ : STO DEFAULT

rule Expr_inst/unaryExpressionIR:
  p IC STO_0 |- (unop typedExpressionIR) '#' _ : STO_1 $un_op(unop, value)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value

rule Expr_inst/non-short-circuit:
  p IC STO_0
    |- (typedExpressionIR_l binop typedExpressionIR_r) '#' _
    : STO_2 $bin_op(binop, value_l, value_r)
  -- if ~(binop <- ['&&', '||'])
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value_l
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

rule Expr_inst/land-false:
  p IC STO_0
    |- (typedExpressionIR_l '&&' typedExpressionIR_r) '#' _
    : STO_1 (_B false)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B false)

rule Expr_inst/land-true:
  p IC STO_0
    |- (typedExpressionIR_l '&&' typedExpressionIR_r) '#' _
    : STO_2 value_r
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B true)
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

rule Expr_inst/lor-true:
  p IC STO_0
    |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _
    : STO_1 (_B true)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B true)

rule Expr_inst/lor-false:
  p IC STO_0
    |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _
    : STO_2 value_r
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B false)
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

rule Expr_inst/true:
  p IC STO_0
    |- (typedExpressionIR_cond
        '?'
        typedExpressionIR_true
        ':'
        typedExpressionIR_false)
       '#'
       _
    : STO_2 value_true
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 (_B true)
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true

rule Expr_inst/false:
  p IC STO_0
    |- (typedExpressionIR_cond
        '?'
        typedExpressionIR_true
        ':'
        typedExpressionIR_false)
       '#'
       _
    : STO_2 value_false
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 (_B false)
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false

rule Expr_inst/castExpressionIR:
  p IC STO_0 |- (`(typeIR) typedExpressionIR) '#' _ : STO_1 value_cast
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value
  -- if value_cast = $cast_op(typeIR, value)

rule Expr_inst/invalidHeaderExpressionIR:
  p IC STO |- '{#}' '#' _ : STO '{#}'

rule Expr_inst/non-default:
  p IC STO_0 |- (SEQ `{typedExpressionListIR}) '#' _ : STO_1 (SEQ `(value*))
  -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*

rule Expr_inst/default:
  p IC STO_0
    |- (SEQ `{typedExpressionListIR ',' '...'}) '#' _
    : STO_1 (SEQ `(value* ',' '...'))
  -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*

rule Expr_inst/non-default:
  p IC STO_0
    |- (RECORD `{(nameIR '=' typedExpressionIR)*}) '#' _
    : STO_1 (RECORD `{(value nameIR ';')*})
  -- Exprs_inst: p IC STO_0 |- typedExpressionIR* : STO_1 value*

rule Expr_inst/default:
  p IC STO_0
    |- (RECORD `{(nameIR '=' typedExpressionIR)* ',' '...'}) '#' _
    : STO_1 (RECORD `{(value nameIR ';')* ',' '...'})
  -- Exprs_inst: p IC STO_0 |- typedExpressionIR* : STO_1 value*

rule Expr_inst/errorAccessExpressionIR:
  p IC STO |- (ERROR '.' nameIR) '#' _ : STO value_error
  -- if nameIR_error = "error." ++ nameIR
  -- if value_error = $find_var_i(_NAME nameIR_error, p, IC)

rule Expr_inst/enum:
  p IC STO |- ((TYPE prefixedNameIR) '.' nameIR) '#' _ : STO (typeId '.' nameIR)
  -- if ENUM typeId `{_} = $find_typeDef_i(p, IC, prefixedNameIR)

rule Expr_inst/serenum:
  p IC STO
    |- ((TYPE prefixedNameIR) '.' nameIR) '#' _
    : STO (typeId '.' nameIR '.' value)
  -- if ENUM typeId `<_> `{(id_member '=' value_member ';')*}
        = $find_typeDef_i(p, IC, prefixedNameIR)
  -- if value = $assoc_<nameIR, value>(nameIR, (id_member, value_member)*)

rule Expr_inst/header-stack-size:
  p IC STO |- (typedExpressionIR_base '.' nameIR) '#' _ : STO (D n_size)
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if _ `[n_size] = $unroll_typeIR(typeIR_base)
  -- if nameIR = "size"

rule Expr_inst/struct:
  p IC STO_0 |- (typedExpressionIR_base '.' nameIR) '#' _ : STO_1 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 structValue
  -- if STRUCT _ `{(value_field id_field ';')*} = structValue
  -- if value = $assoc_<id, value>(nameIR, (id_field, value_field)*)

rule Expr_inst/header:
  p IC STO_0 |- (typedExpressionIR_base '.' nameIR) '#' _ : STO_1 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 headerValue
  -- if HEADER _ `{_ ';' (value_field id_field ';')*} = headerValue
  -- if value = $assoc_<id, value>(nameIR, (id_field, value_field)*)

rule Expr_inst/header-union:
  p IC STO_0 |- (typedExpressionIR_base '.' nameIR) '#' _ : STO_1 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 headerUnionValue
  -- if HEADER_UNION _ `{(value_field id_field ';')*} = headerUnionValue
  -- if value = $assoc_<id, value>(nameIR, (id_field, value_field)*)

rule Expr_inst/tuple:
  p IC STO_0
    |- (typedExpressionIR_base `[typedExpressionIR_index]) '#' _
    : STO_2 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_index : STO_2 integerValue_index
  -- if TUPLE `(value_e*) = value_base
  -- if n_index = $nat_of_integerValue(integerValue_index)
  -- if $(n_index < |value_e*|)
  -- if value = value_e*[n_index]

rule Expr_inst/indexAccessExpressionIR-stack:
  p IC STO_0
    |- (typedExpressionIR_base `[typedExpressionIR_index]) '#' _
    : STO_2 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_index : STO_2 integerValue_index
  -- if HEADER_STACK `[value_e* `(_ ';' _)] = value_base
  -- if n_index = $nat_of_integerValue(integerValue_index)
  -- if $(n_index < |value_e*|)
  -- if value = value_e*[n_index]

rule Expr_inst/range:
  p IC STO_0
    |- (typedExpressionIR_base `[typedExpressionIR_hi ':' typedExpressionIR_lo])
       '#'
       _
    : STO_3 $bitacc_range_op(value_base, value_hi, value_lo)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_hi : STO_2 value_hi
  -- Expr_inst: p IC STO_2 |- typedExpressionIR_lo : STO_3 value_lo

rule Expr_inst/offset:
  p IC STO_0
    |- (typedExpressionIR_base `[typedExpressionIR_l ':' typedExpressionIR_w])
       '#'
       _
    : STO_3 $bitacc_offset_op(value_base, value_l, value_w)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_l : STO_2 value_l
  -- Expr_inst: p IC STO_2 |- typedExpressionIR_w : STO_3 value_w

rule Expr_inst/callExpressionIR-constructor:
  p IC STO_0
    |- ((prefixedNameIR `<typeArgumentListIR>) `(argumentListIR)) '#' _
    : STO_2 value_ref
  -- Constructor_inst:
       p IC
         |- prefixedNameIR `<typeArgumentListIR> `(argumentListIR)
         : constructorDef
           `<typeArgumentListIR_inst>
           `('#' id_default* '#' id_optional*)
  -- Constructor_call:
       p IC STO_0
         |- constructorDef
            `<typeArgumentListIR_inst>
            `(argumentListIR '#' id_default* '#' id_optional*)
         : STO_1 object
  -- if STO_2 = $add_store(STO_1, IC.PATH, object)
  -- if value_ref = REF IC.PATH

rule Expr_inst/expression:
  p IC STO
    |- ((typedExpressionIR_base '.' nameIR) `<_> `(_)) '#' _
    : STO $sizeof(typeIR_base, nameIR)
  -- if _ '#' `(typeIR_base _) = typedExpressionIR_base
  -- if nameIR <- ["minSizeInBits",
                   "minSizeInBytes",
                   "maxSizeInBits",
                   "maxSizeInBytes"]

rule Expr_inst/type-monomorphic:
  p IC STO
    |- ((TYPE prefixedNameIR '.' nameIR) `<_> `(_)) '#' _
    : STO $sizeof(typeIR_base, nameIR)
  -- if typeDefIR_base = $find_typeDef_i(p, IC, prefixedNameIR)
  -- if $is_monomorphic_typeDefIR(typeDefIR_base)
  -- if typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base)
  -- if nameIR <- ["minSizeInBits",
                   "minSizeInBytes",
                   "maxSizeInBits",
                   "maxSizeInBytes"]

rule Expr_inst/type-polymorphic:
  p IC STO
    |- ((TYPE prefixedNameIR '.' nameIR) `<_> `(_)) '#' _
    : STO $sizeof(typeIR_base, nameIR)
  -- if typeDefIR_base = $find_typeDef_i(p, IC, prefixedNameIR)
  -- if ~$is_monomorphic_typeDefIR(typeDefIR_base)
  -- if (eps, eps) = $typeParameterListIR_of_typeDefIR(typeDefIR_base)
  -- if typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base)
  -- if nameIR <- ["minSizeInBits",
                   "minSizeInBytes",
                   "maxSizeInBits",
                   "maxSizeInBytes"]

rule Expr_inst/callExpressionIR-parenthesized:
  p IC STO_0
    |- ((`(callableTargetIR)) `<typeArgumentListIR> `(argumentListIR))
       '#'
       expressionNoteIR
    : STO_1 value
  -- Expr_inst:
       p IC STO_0
         |- (callableTargetIR `<typeArgumentListIR> `(argumentListIR))
            '#'
            expressionNoteIR
         : STO_1 value

rule Expr_inst/parenthesizedExpressionIR:
  p IC STO_0 |- (`(typedExpressionIR)) '#' _ : STO_1 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value

rule Exprs_inst/nil:
  p IC STO |- eps : STO eps

rule Exprs_inst/cons:
  p IC STO_0
    |- typedExpressionIR_h :: typedExpressionIR_t*
    : STO_2 (value_h :: value_t*)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_h : STO_1 value_h
  -- Exprs_inst: p IC STO_1 |- typedExpressionIR_t* : STO_2 value_t*
;; === 7-instantiation/7.05-inst-argument.spectec ===
rule Argument_inst/typedExpressionIR:
  p IC STO_0 |- typedExpressionIR : STO_1 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value

rule Argument_inst/nameIR-typedExpressionIR:
  p IC STO_0 |- nameIR '=' typedExpressionIR : STO_1 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value
;; === 7-instantiation/7.06-inst-statement.spectec ===
rule Stmt_inst/emptyStatementIR:
  p IC STO |- emptyStatementIR : IC STO emptyStatementIR

rule Stmt_inst/assignmentStatementIR:
  p IC STO |- assignmentStatementIR : IC STO assignmentStatementIR

rule Stmt_inst/callStatementIR:
  p IC STO |- callStatementIR : IC STO callStatementIR

rule DirectApplicationStmt_inst:
  p IC STO_0
    |- constructorTargetIR '.' APPLY `(argumentListIR) ';'
    : STO_2 constantDeclarationIR callStatementIR
  -- if prefixedNameIR `<typeArgumentListIR> = constructorTargetIR
  -- Constructor_inst:
       p IC
         |- prefixedNameIR `<typeArgumentListIR> `(eps)
         : constructorDef
           `<typeArgumentListIR_inst>
           `('#' id_default* '#' id_optional*)
  -- if typeId = $flatten_prefixedNameIR(prefixedNameIR)
  -- if IC_callee = $enter_path_i(IC, typeId)
  -- Constructor_call:
       p IC_callee STO_0
         |- constructorDef
            `<typeArgumentListIR_inst>
            `(eps '#' id_default* '#' id_optional*)
         : STO_1 object
  -- if typeId_fresh = $fresh_typeId
  -- if typeIR = _NAME typeId
  -- if nameIR = $concat_text([typeId, "_", typeId_fresh])
  -- if objectId = IC.PATH ++ typeId
  -- if STO_2 = $add_store(STO_1, objectId, object)
  -- if constantDeclarationIR
        = _EMPTY CONST typeIR nameIR ('=' _VALUE (REF objectId)) ';'
  -- if typedExpressionIR_base = (_NAME nameIR) '#' `(typeIR CTK)
  -- if callableTargetIR = typedExpressionIR_base '.' "apply"
  -- if callStatementIR
        = callableTargetIR `<typeArgumentListIR_inst> `(argumentListIR) ';'

rule Stmt_inst/directApplicationStatementIR:
  p IC STO_0 |- directApplicationStatementIR : IC STO_1 blockStatementIR
  -- DirectApplicationStmt_inst:
       p IC STO_0
         |- directApplicationStatementIR
         : STO_1 constantDeclarationIR callStatementIR
  -- if blockStatementIR = _EMPTY `{[constantDeclarationIR, callStatementIR]}

rule Stmt_inst/returnStatementIR:
  LOCAL IC STO |- returnStatementIR : IC STO returnStatementIR

rule Stmt_inst/exitStatementIR:
  p IC STO |- exitStatementIR : IC STO exitStatementIR

rule Stmt_inst/blockStatementIR:
  LOCAL IC_0 STO_0
    |- annotationList `{blockElementStatementListIR}
    : IC_3 STO_1 (annotationList `{blockElementStatementListIR_inst})
  -- if IC_1 = $enter_i(IC_0)
  -- Block_inst:
       IC_1 STO_0
         |- annotationList `{blockElementStatementListIR}
         : IC_2 STO_1 (_ `{blockElementStatementListIR_inst})
  -- if IC_3 = $exit_i(IC_2)

rule Stmt_inst/non-else:
  p IC STO_0
    |- IF `(typedExpressionIR_cond) statementIR_then
    : IC STO_1 (IF `(typedExpressionIR_cond) statementIR_then_inst)
  -- Stmt_inst:
       p IC STO_0 |- statementIR_then : IC_then STO_1 statementIR_then_inst

rule Stmt_inst/else:
  p IC STO_0
    |- IF `(typedExpressionIR_cond) statementIR_then ELSE statementIR_else
    : IC
      STO_2
      (IF
       `(typedExpressionIR_cond)
       statementIR_then_inst
       ELSE
       statementIR_else_inst)
  -- Stmt_inst:
       p IC STO_0 |- statementIR_then : IC_then STO_1 statementIR_then_inst
  -- Stmt_inst:
       p IC STO_1 |- statementIR_else : IC_else STO_2 statementIR_else_inst

rule Stmt_inst/forStatementIR-three-clause:
  p IC STO_0
    |- annotationList
       FOR
       `(forInitStatementListIR
         ';'
         typedExpressionIR
         ';'
         forUpdateStatementListIR)
       statementIR
    : IC STO_1 forStatementIR
  -- Stmt_inst: p IC STO_0 |- statementIR : IC_body STO_1 statementIR_body
  -- if forStatementIR
        = annotationList
          FOR
          `(forInitStatementListIR
            ';'
            typedExpressionIR
            ';'
            forUpdateStatementListIR)
          statementIR_body

rule Stmt_inst/no-annotations:
  p IC STO_0
    |- annotationList
       FOR
       `(typeIR nameIR IN forCollectionExpressionIR)
       statementIR
    : IC STO_1 forStatementIR
  -- Stmt_inst: p IC STO_0 |- statementIR : IC_body STO_1 statementIR_body
  -- if forStatementIR
        = annotationList
          FOR
          `(typeIR nameIR IN forCollectionExpressionIR)
          statementIR_body

rule Stmt_inst/annotations:
  p IC STO_0
    |- annotationList
       FOR
       `(annotationList typeIR nameIR IN forCollectionExpressionIR)
       statementIR
    : IC STO_1 forStatementIR
  -- Stmt_inst: p IC STO_0 |- statementIR : IC_body STO_1 statementIR_body
  -- if forStatementIR
        = annotationList
          FOR
          `(annotationList typeIR nameIR IN forCollectionExpressionIR)
          statementIR_body

rule Stmt_inst/breakStatementIR:
  p IC STO |- breakStatementIR : IC STO breakStatementIR

rule Stmt_inst/continueStatementIR:
  p IC STO |- continueStatementIR : IC STO continueStatementIR

relation SwitchCase_inst:
  cursor instContext store |- switchCaseIR : store switchCaseIR
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %4 "and" %5)

rule SwitchCase_inst/blockStatementIR:
  p IC STO_0
    |- switchLabelIR ':' blockStatementIR
    : STO_1 (switchLabelIR ':' blockStatementIR_inst)
  -- Stmt_inst:
       p IC STO_0 |- blockStatementIR : IC_switch STO_1 blockStatementIR_inst

rule SwitchCase_inst/non-blockStatementIR:
  p IC STO |- switchLabelIR ':' : STO (switchLabelIR ':')

relation SwitchCases_inst:
  cursor instContext store |- switchCaseIR* : store switchCaseIR*
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %4 "and" %5)

rule SwitchCases_inst/nil:
  p IC STO |- eps : STO eps

rule SwitchCases_inst/cons:
  p IC STO_0
    |- switchCaseIR_h :: switchCaseIR_t*
    : STO_2 (switchCaseIR_h' :: switchCaseIR_t'*)
  -- SwitchCase_inst: p IC STO_0 |- switchCaseIR_h : STO_1 switchCaseIR_h'
  -- SwitchCases_inst: p IC STO_1 |- switchCaseIR_t* : STO_2 switchCaseIR_t'*

rule Stmt_inst/switchStatementIR:
  p IC STO_0
    |- SWITCH `(typedExpressionIR) `{switchCaseListIR}
    : IC STO_1 (SWITCH `(typedExpressionIR) `{switchCaseListIR_inst})
  -- SwitchCases_inst:
       p IC STO_0 |- switchCaseListIR : STO_1 switchCaseListIR_inst

rule BlockElementStmt_inst/constantDeclarationIR:
  IC_0 STO_0 |- constantDeclarationIR : IC_1 STO_0 constantDeclarationIR
  -- ConstDecl_inst: LOCAL IC_0 |- constantDeclarationIR : IC_1

rule BlockElementStmt_inst/variableDeclarationIR:
  IC STO |- variableDeclarationIR : IC STO variableDeclarationIR

rule BlockElementStmt_inst/statementIR:
  IC_0 STO_0 |- statementIR : IC_1 STO_1 statementIR_inst
  -- Stmt_inst: LOCAL IC_0 STO_0 |- statementIR : IC_1 STO_1 statementIR_inst

rule BlockElementStmtList_inst/nil:
  IC STO |- eps : IC STO eps

rule BlockElementStmtList_inst/cons:
  IC_0 STO_0
    |- blockElementStatementIR_h :: blockElementStatementIR_t*
    : IC_2
      STO_2
      (blockElementStatementIR_h_inst :: blockElementStatementIR_t_inst*)
  -- BlockElementStmt_inst:
       IC_0 STO_0
         |- blockElementStatementIR_h
         : IC_1 STO_1 blockElementStatementIR_h_inst
  -- BlockElementStmtList_inst:
       IC_1 STO_1
         |- blockElementStatementIR_t*
         : IC_2 STO_2 blockElementStatementIR_t_inst*

rule Block_inst:
  IC_0 STO_0
    |- annotationList `{blockElementStatementListIR}
    : IC_1 STO_1 (annotationList `{blockElementStatementListIR_inst})
  -- BlockElementStmtList_inst:
       IC_0 STO_0
         |- blockElementStatementListIR
         : IC_1 STO_1 blockElementStatementListIR_inst
;; === 7-instantiation/7.07-inst-declaration.spectec ===
rule ConstDecl_inst:
  p IC_0 |- annotationList CONST typeIR nameIR ('=' _VALUE value) ';' : IC_1
  -- if IC_1 = $add_var_i(p, IC_0, nameIR, value)

rule Decl_inst/constantDeclarationIR:
  IC_0 STO |- constantDeclarationIR : IC_1 STO
  -- ConstDecl_inst: GLOBAL IC_0 |- constantDeclarationIR : IC_1

dec $merge_frames(frame, frame) : frame
  hint(prose_in "the merged frame of" %0 "and" %1)

def $merge_frames(frame, `{(id ':' value)*})
  = $adds_map<id, value>(frame, id*, value*)

dec $merge_externMethodDefEnvs(externMethodDefEnv, callableDefEnv)
  : externMethodDefEnv
  hint(prose_in "the merged extern method definition environment of" %0 "and" %1)

def $merge_externMethodDefEnvs(externMethodDefEnv, `{eps}) = externMethodDefEnv

def $merge_externMethodDefEnvs(externMethodDefEnv,
                               `{(callableId_h ':' callableDef_h) :: (callableId_t
                                                                      ':'
                                                                      callableDef_t)*})
  = $merge_externMethodDefEnvs(externMethodDefEnv_post,
                               `{(callableId_t ':' callableDef_t)*})
  -- if FUNCTION
        nameIR
        `<typeParameterListIR>
        `(parameterListIR)
        blockStatementIR
        = callableDef_h
  -- if externMethodDef_h
        = EXTERN_METHOD
          nameIR
          `<typeParameterListIR>
          `(parameterListIR)
          blockStatementIR
  -- if externMethodDefEnv_post
        = $update_map<callableId, externMethodDef>(externMethodDefEnv,
                                                   callableId_h,
                                                   externMethodDef_h)

relation ObjectDecl_inst:
  instContext store |- objectDeclarationIR : instContext store
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2 "under instantiation context" %0 "and store" %1)
  hint(prose_out "the updated instantiation context" %3 "and store" %4)

rule ObjectDecl_inst/functionDeclarationIR:
  IC_0 STO |- functionDeclarationIR : IC_1 STO
  -- FuncDecl_inst: BLOCK IC_0 |- functionDeclarationIR : IC_1

rule ObjectDecl_inst/instantiationIR:
  IC_0 STO_0 |- instantiationIR : IC_1 STO_1
  -- InstDecl_inst: GLOBAL IC_0 STO_0 |- instantiationIR : IC_1 STO_1 _

relation ObjectDecls_inst:
  instContext store |- objectDeclarationListIR : instContext store
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2 "under instantiation context" %0 "and store" %1)
  hint(prose_out "the updated instantiation context" %3 "and store" %4)

rule ObjectDecls_inst/nil:
  IC STO |- eps : IC STO

rule ObjectDecls_inst/cons:
  IC_0 STO_0 |- objectDeclarationIR_h :: objectDeclarationIR_t* : IC_2 STO_2
  -- ObjectDecl_inst: IC_0 STO_0 |- objectDeclarationIR_h : IC_1 STO_1
  -- ObjectDecls_inst: IC_1 STO_1 |- objectDeclarationIR_t* : IC_2 STO_2

rule InstDecl_inst/extern:
  p IC_0 STO_0
    |- annotationList
       typeIR
       constructorTargetIR
       `(argumentListIR)
       nameIR
       objectInitializerOptIR
       ';'
    : IC_1 STO_3 constantDeclarationIR
  -- if prefixedNameIR `<typeArgumentListIR> = constructorTargetIR
  -- Constructor_inst:
       p IC_0
         |- prefixedNameIR `<typeArgumentListIR> `(argumentListIR)
         : constructorDef
           `<typeArgumentListIR_inst>
           `('#' id_default* '#' id_optional*)
  -- if IC_inner = $enter_path_i(IC_0, nameIR)
  -- Constructor_call:
       p IC_inner STO_0
         |- constructorDef
            `<typeArgumentListIR_inst>
            `(argumentListIR '#' id_default* '#' id_optional*)
         : STO_1 object
  -- if EXTERN typeId `<theta> `{objectState frame externMethodDefEnv} = object
  -- if IC_decl = $inherit_i(GLOBAL, IC_0)
  -- if objectDeclarationListIR
        = $flatten_objectInitializerOptIR(objectInitializerOptIR)
  -- ObjectDecls_inst:
       IC_decl STO_1 |- objectDeclarationListIR : IC_decl_post STO_2
  -- if frame_merged = $merge_frames(frame, IC_decl_post.BLOCK.FRAME)
  -- if externMethodDefEnv_merged
        = $merge_externMethodDefEnvs(externMethodDefEnv,
                                     IC_decl_post.BLOCK.CALLABLE)
  -- if object_merged
        = EXTERN
          typeId
          `<theta>
          `{objectState frame_merged externMethodDefEnv_merged}
  -- if objectId = IC_0.PATH ++ nameIR
  -- if STO_3 = $add_store(STO_2, objectId, object_merged)
  -- if IC_1 = $add_var_i(p, IC_0, nameIR, REF objectId)
  -- if constantDeclarationIR
        = _EMPTY CONST typeIR nameIR ('=' _VALUE (REF objectId)) ';'

rule InstDecl_inst/non-extern:
  p IC_0 STO_0
    |- annotationList
       typeIR
       constructorTargetIR
       `(argumentListIR)
       nameIR
       objectInitializerOptIR
       ';'
    : IC_1 STO_2 constantDeclarationIR
  -- if prefixedNameIR `<typeArgumentListIR> = constructorTargetIR
  -- Constructor_inst:
       p IC_0
         |- prefixedNameIR `<typeArgumentListIR> `(argumentListIR)
         : constructorDef
           `<typeArgumentListIR_inst>
           `('#' id_default* '#' id_optional*)
  -- if nameIR' = $name_annotation_default(annotationList, nameIR)
  -- if IC_inner = $enter_path_i(IC_0, nameIR')
  -- Constructor_call:
       p IC_inner STO_0
         |- constructorDef
            `<typeArgumentListIR_inst>
            `(argumentListIR '#' id_default* '#' id_optional*)
         : STO_1 object
  -- if ~(object <: externObject)
  -- if objectId = IC_0.PATH ++ nameIR
  -- if STO_2 = $add_store(STO_1, objectId, object)
  -- if IC_1 = $add_var_i(p, IC_0, nameIR, REF objectId)
  -- if constantDeclarationIR
        = _EMPTY CONST typeIR nameIR ('=' _VALUE (REF objectId)) ';'

rule Decl_inst/instantiationIR:
  IC_0 STO_0 |- instantiationIR : IC_1 STO_1
  -- InstDecl_inst: GLOBAL IC_0 STO_0 |- instantiationIR : IC_1 STO_1 _

rule FuncDecl_inst:
  p IC_0
    |- annotationList
       (typeIR
        nameIR
        (`<typeParameterListIR_expl ',' typeParameterListIR_impl>)
        `(parameterListIR))
       blockStatementIR
    : IC_1
  -- if callableId = $callableId_IR(nameIR, parameterListIR)
  -- if typeParameterListIR
        = typeParameterListIR_expl ++ typeParameterListIR_impl
  -- if definedFunctionDef
        = FUNCTION
          nameIR
          `<typeParameterListIR>
          `(parameterListIR)
          blockStatementIR
  -- if IC_1
        = $add_callableDef_overload_i(p, IC_0, callableId, definedFunctionDef)

rule Decl_inst/functionDeclarationIR:
  IC_0 STO |- functionDeclarationIR : IC_1 STO
  -- FuncDecl_inst: GLOBAL IC_0 |- functionDeclarationIR : IC_1

rule ActionDecl_inst:
  p IC_0
    |- annotationList ACTION nameIR `(parameterListIR) blockStatementIR
    : IC_1
  -- if callableId = $callableId_IR(nameIR, parameterListIR)
  -- if actionDef
        = annotationList ACTION nameIR `(parameterListIR) blockStatementIR
  -- if IC_1 = $add_callableDef_non_overload_i(p, IC_0, callableId, actionDef)

rule Decl_inst/actionDeclarationIR:
  IC_0 STO |- actionDeclarationIR : IC_1 STO
  -- ActionDecl_inst: GLOBAL IC_0 |- actionDeclarationIR : IC_1

rule Decl_inst/errorDeclarationIR:
  IC_0 STO |- ERROR `{nameIR*} : IC_1 STO
  -- (if (nameIR_error = $concat_text(["error.", nameIR])))*
  -- (if (value_error = ERROR '.' nameIR))*
  -- if IC_1 = $add_vars_i(GLOBAL, IC_0, nameIR_error*, value_error*)

rule Decl_inst/matchKindDeclarationIR:
  IC_0 STO |- MATCH_KIND `{nameIR*} : IC_1 STO
  -- (if (value_match_kind = MATCH_KIND '.' nameIR))*
  -- if IC_1 = $add_vars_i(GLOBAL, IC_0, nameIR*, value_match_kind*)

rule Decl_inst/externFunctionDeclarationIR:
  IC_0 STO
    |- annotationList
       EXTERN
       (typeIR
        nameIR
        `<typeParameterListIR_expl ',' typeParameterListIR_impl>
        `(parameterListIR))
       ';'
    : IC_1 STO
  -- if callableId = $callableId_IR(nameIR, parameterListIR)
  -- if typeParameterListIR
        = typeParameterListIR_expl ++ typeParameterListIR_impl
  -- if externFunctionDef
        = EXTERN_FUNCTION nameIR `<typeParameterListIR> `(parameterListIR)
  -- if IC_1
        = $add_callableDef_overload_i(GLOBAL,
                                      IC_0,
                                      callableId,
                                      externFunctionDef)

dec $callableId_of_externMethodPrototypeIR(externMethodPrototypeIR) : callableId
  hint(prose_in "the callable id of " %0)

def $callableId_of_externMethodPrototypeIR(_
                                           (_
                                            nameIR
                                            `<_ ',' _>
                                            `(parameterListIR))
                                           ';')
  = $callableId_IR(nameIR, parameterListIR)

def $callableId_of_externMethodPrototypeIR(_
                                           ABSTRACT
                                           (_
                                            nameIR
                                            `<_ ',' _>
                                            `(parameterListIR))
                                           ';')
  = $callableId_IR(nameIR, parameterListIR)

dec $callableId_of_externConstructorPrototypeIR(externConstructorPrototypeIR)
  : callableId
  hint(prose_in "the constructor id of " %0)

def $callableId_of_externConstructorPrototypeIR(_
                                                nameIR
                                                `<',' _>
                                                `(parameterIR*)
                                                ';')
  = $callableId_IR(nameIR, parameterIR*)

dec $constructor_of_externConstructorPrototypeIR(typeParameterListIR,
                                                 externMethodPrototypeListIR,
                                                 externConstructorPrototypeIR)
  : constructorDef
  hint(prose_in "the constructor definition of "
                %2
                "with type parameters "
                %0
                " and methods "
                %1)

def $constructor_of_externConstructorPrototypeIR(typeParameterListIR_expl,
                                                 externMethodPrototypeListIR,
                                                 _
                                                 nameIR
                                                 `<',' typeParameterListIR_impl>
                                                 `(parameterIR*)
                                                 ';')
  = constructorDef
  -- if typeParameterListIR
        = typeParameterListIR_expl ++ typeParameterListIR_impl
  -- if constructorDef
        = EXTERN
          nameIR
          `<typeParameterListIR>
          `(parameterIR*)
          `{externMethodPrototypeListIR}

rule Decl_inst/non-constructor:
  IC_0 STO
    |- annotationList
       EXTERN
       nameIR
       `<typeParameterListIR ','>
       `{eps externMethodPrototypeIR*}
    : IC_2 STO
  -- (if (callableId_method
         = $callableId_of_externMethodPrototypeIR(externMethodPrototypeIR)))*
  -- (if (externMethodTypeDefIR
         = $type_of_externMethodPrototypeIR(externMethodPrototypeIR)))*
  -- if externMethodTypeDefEnv
        = `{(callableId_method ':' externMethodTypeDefIR)*}
  -- if externObjectTypeDefIR
        = EXTERN nameIR `<typeParameterListIR ',' eps> externMethodTypeDefEnv
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, externObjectTypeDefIR)
  -- if callableId_constructor = $callableId_IR(nameIR, eps)
  -- if constructorDef
        = EXTERN
          nameIR
          `<typeParameterListIR>
          `(eps)
          `{externMethodPrototypeIR*}
  -- if IC_2
        = $add_constructorDef_i(IC_1, callableId_constructor, constructorDef)

rule Decl_inst/constructor:
  IC_0 STO
    |- annotationList
       EXTERN
       nameIR
       `<typeParameterListIR ','>
       `{externConstructorPrototypeIR* externMethodPrototypeIR*}
    : IC_2 STO
  -- if externConstructorPrototypeIR* =/= eps
  -- (if (callableId_method
         = $callableId_of_externMethodPrototypeIR(externMethodPrototypeIR)))*
  -- (if (externMethodTypeDefIR
         = $type_of_externMethodPrototypeIR(externMethodPrototypeIR)))*
  -- if externMethodTypeDefEnv
        = `{(callableId_method ':' externMethodTypeDefIR)*}
  -- if externObjectTypeDefIR
        = EXTERN nameIR `<typeParameterListIR ',' eps> externMethodTypeDefEnv
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, externObjectTypeDefIR)
  -- (if (callableId_constructor
         = $callableId_of_externConstructorPrototypeIR(externConstructorPrototypeIR)))*
  -- (if (constructorDef
         = $constructor_of_externConstructorPrototypeIR(typeParameterListIR,
                                                        externMethodPrototypeIR*,
                                                        externConstructorPrototypeIR)))*
  -- if IC_2
        = $add_constructorDefs_i(IC_1, callableId_constructor*, constructorDef*)

rule Decl_inst/parserDeclarationIR:
  IC_0 STO
    |- annotationList
       PARSER
       nameIR
       `<typeParameterListIR_expl ',' typeParameterListIR_impl>
       `(parameterListIR)
       `(constructorParameterListIR)
       `{parserLocalDeclarationListIR parserStateListIR}
    : IC_1 STO
  -- if callableId = $callableId_IR(nameIR, constructorParameterListIR)
  -- if typeParameterListIR
        = typeParameterListIR_expl ++ typeParameterListIR_impl
  -- if constructorDef
        = PARSER
          `<typeParameterListIR>
          `(parameterListIR)
          `(constructorParameterListIR)
          `{parserLocalDeclarationListIR parserStateListIR}
  -- if IC_1 = $add_constructorDef_i(IC_0, callableId, constructorDef)

rule Decl_inst/controlDeclarationIR:
  IC_0 STO
    |- annotationList
       CONTROL
       nameIR
       `<typeParameterListIR_expl ',' typeParameterListIR_impl>
       `(parameterListIR)
       `(constructorParameterListIR)
       `{controlLocalDeclarationListIR APPLY controlBodyIR}
    : IC_1 STO
  -- if callableId = $callableId_IR(nameIR, constructorParameterListIR)
  -- if typeParameterListIR
        = typeParameterListIR_expl ++ typeParameterListIR_impl
  -- if constructorDef
        = CONTROL
          `<typeParameterListIR>
          `(parameterListIR)
          `(constructorParameterListIR)
          `{controlLocalDeclarationListIR APPLY controlBodyIR}
  -- if IC_1 = $add_constructorDef_i(IC_0, callableId, constructorDef)

rule Decl_inst/enumTypeDeclarationIR-non-serializable:
  IC_0 STO |- annotationList ENUM nameIR `{nameIR_field*} : IC_2 STO
  -- (if (nameIR_enum_field = nameIR ++ "." ++ nameIR_field))*
  -- (if (value_enum_field = nameIR '.' nameIR_field))*
  -- if IC_1 = $add_vars_i(GLOBAL, IC_0, nameIR_enum_field*, value_enum_field*)
  -- if enumTypeDefIR = ENUM nameIR `{nameIR_field*}
  -- if IC_2 = $add_typeDef_i(GLOBAL, IC_1, nameIR, enumTypeDefIR)

rule Decl_inst/enumTypeDeclarationIR-serializable:
  IC_0 STO
    |- annotationList ENUM typeIR nameIR `{(nameIR_field '=' value_field)*}
    : IC_2 STO
  -- (if (nameIR_serenum_field = nameIR ++ "." ++ nameIR_field))*
  -- (if (value_serenum_field = nameIR '.' nameIR_field '.' value_field))*
  -- if IC_1
        = $add_vars_i(GLOBAL, IC_0, nameIR_serenum_field*, value_serenum_field*)
  -- if enumTypeDefIR
        = ENUM nameIR `<typeIR> `{(nameIR_field '=' value_field ';')*}
  -- if IC_2 = $add_typeDef_i(GLOBAL, IC_1, nameIR, enumTypeDefIR)

rule Decl_inst/structTypeDeclarationIR:
  IC_0 STO
    |- annotationList STRUCT nameIR `<typeParameterListIR> `{typeFieldIR*}
    : IC_1 STO
  -- (if (annotationList_field typeIR_field nameIR_field ';' = typeFieldIR))*
  -- if structTypeDefIR
        = STRUCT
          nameIR
          `<typeParameterListIR>
          `{(annotationList_field typeIR_field nameIR_field ';')*}
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, structTypeDefIR)

rule Decl_inst/headerTypeDeclarationIR:
  IC_0 STO
    |- annotationList HEADER nameIR `<typeParameterListIR> `{typeFieldIR*}
    : IC_1 STO
  -- (if (annotationList_field typeIR_field nameIR_field ';' = typeFieldIR))*
  -- if headerTypeDefIR
        = HEADER
          nameIR
          `<typeParameterListIR>
          `{(annotationList_field typeIR_field nameIR_field ';')*}
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, headerTypeDefIR)

rule Decl_inst/headerUnionTypeDeclarationIR:
  IC_0 STO
    |- annotationList HEADER_UNION nameIR `<typeParameterListIR> `{typeFieldIR*}
    : IC_1 STO
  -- (if (annotationList_field typeIR_field nameIR_field ';' = typeFieldIR))*
  -- if headerUnionTypeDefIR
        = HEADER_UNION
          nameIR
          `<typeParameterListIR>
          `{(annotationList_field typeIR_field nameIR_field ';')*}
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, headerUnionTypeDefIR)

rule Decl_inst/typeIR:
  IC_0 STO |- annotationList TYPEDEF typeIR nameIR ';' : IC_1 STO
  -- if aliasTypeDefIR = TYPEDEF nameIR typeIR
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, aliasTypeDefIR)

rule Decl_inst/derivedTypeDeclarationIR-monomorphic:
  IC_0 STO
    |- annotationList TYPEDEF derivedTypeDeclarationIR nameIR ';'
    : IC_1 STO
  -- Decl_inst: IC_0 $empty_store |- derivedTypeDeclarationIR : IC_local _
  -- if `{typeId_newtype}
        = $diff_set<typeId>($dom_map<typeId, typeDefIR>(IC_local.GLOBAL.TYPE),
                            $dom_map<typeId, typeDefIR>(IC_0.GLOBAL.TYPE))
  -- if typeDefIR = $find_typeDef_i(GLOBAL, IC_local, '.' typeId_newtype)
  -- if $is_monomorphic_typeDefIR(typeDefIR)
  -- if typeIR = $typeIR_of_typeDefIR(typeDefIR)
  -- if aliasTypeDefIR = TYPEDEF nameIR typeIR
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, aliasTypeDefIR)

rule Decl_inst/derivedTypeDeclaration-poly:
  IC_0 STO
    |- annotationList TYPEDEF derivedTypeDeclarationIR nameIR ';'
    : IC_1 STO
  -- Decl_inst: IC_0 $empty_store |- derivedTypeDeclarationIR : IC_local _
  -- if `{typeId_newtype}
        = $diff_set<typeId>($dom_map<typeId, typeDefIR>(IC_local.GLOBAL.TYPE),
                            $dom_map<typeId, typeDefIR>(IC_0.GLOBAL.TYPE))
  -- if typeDefIR = $find_typeDef_i(GLOBAL, IC_local, '.' typeId_newtype)
  -- if ~$is_monomorphic_typeDefIR(typeDefIR)
  -- if (eps, eps) = $typeParameterListIR_of_typeDefIR(typeDefIR)
  -- if typeIR = $specialize_typeDefIR(typeDefIR, eps)
  -- if typedefTypeIR = TYPEDEF nameIR typeIR
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, typedefTypeIR)

rule Decl_inst/typedefDeclarationIR-newtype:
  IC_0 STO |- annotationList TYPE typeIR nameIR ';' : IC_1 STO
  -- if aliasTypeDefIR = TYPE nameIR typeIR
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, aliasTypeDefIR)

rule Decl_inst/parserTypeDeclarationIR:
  IC_0 STO
    |- annotationList
       PARSER
       nameIR
       `<typeParameterListIR ',' typeParameterListIR_inferred>
       `(parameterIR*)
       ';'
    : IC_1 STO
  -- if parserObjectTypeDefIR
        = PARSER
          nameIR
          `<typeParameterListIR ',' typeParameterListIR_inferred>
          `(parameterIR*)
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, parserObjectTypeDefIR)

rule Decl_inst/controlTypeDeclarationIR:
  IC_0 STO
    |- annotationList
       CONTROL
       nameIR
       `<typeParameterListIR ',' typeParameterListIR_inferred>
       `(parameterIR*)
       ';'
    : IC_1 STO
  -- if controlObjectTypeDefIR
        = CONTROL
          nameIR
          `<typeParameterListIR ',' typeParameterListIR_inferred>
          `(parameterIR*)
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, controlObjectTypeDefIR)

rule Decl_inst/packageTypeDeclarationIR:
  IC_0 STO
    |- annotationList
       PACKAGE
       nameIR
       `<typeParameterListIR ',' typeParameterListIR_inferred>
       `(parameterIR*)
       ';'
    : IC_2 STO
  -- (if (_ _ typeIR _ _ = parameterIR))*
  -- if packageObjectTypeDefIR
        = PACKAGE
          nameIR
          `<typeParameterListIR ',' typeParameterListIR_inferred>
          `{typeIR*}
  -- if IC_1 = $add_typeDef_i(GLOBAL, IC_0, nameIR, packageObjectTypeDefIR)
  -- if callableId = $callableId_IR(nameIR, parameterIR*)
  -- if constructorDef
        = PACKAGE
          `<typeParameterListIR ++ typeParameterListIR_inferred>
          `(parameterIR*)
  -- if IC_2 = $add_constructorDef_i(IC_1, callableId, constructorDef)

rule Decls_inst/nil:
  IC STO |- eps : IC STO

rule Decls_inst/cons:
  IC_0 STO_0 |- declarationIR_h :: declarationIR_t* : IC_2 STO_2
  -- Decl_inst: IC_0 STO_0 |- declarationIR_h : IC_1 STO_1
  -- Decls_inst: IC_1 STO_1 |- declarationIR_t* : IC_2 STO_2

rule Program_inst:
  |- p4program : IC_1.GLOBAL STO_1
  -- Program_ok: |- p4program : (declarationIR* ';')
  -- if IC_0 = $empty_instContext
  -- if STO_0 = $empty_store
  -- Decls_inst: IC_0 STO_0 |- declarationIR* : IC_1 STO_1
;; === 7-instantiation/7.08-inst-extern-method.spectec ===
rule ExternMethod_inst/non-abstract:
  IC_0
    |- annotationList
       (typeIR
        nameIR
        `<typeParameterListIR ',' typeParameterListIR_inferred>
        `(parameterListIR))
       ';'
    : IC_1
  -- if callableId = $callableId_IR(nameIR, parameterListIR)
  -- if externMethodDef
        = EXTERN_METHOD
          nameIR
          `<typeParameterListIR ++ typeParameterListIR_inferred>
          `(parameterListIR)
          eps
  -- if IC_1
        = $add_callableDef_overload_i(BLOCK, IC_0, callableId, externMethodDef)

rule ExternMethod_inst/abstract:
  IC_0
    |- annotationList
       ABSTRACT
       (typeIR
        nameIR
        `<typeParameterListIR ',' typeParameterListIR_inferred>
        `(parameterListIR))
       ';'
    : IC_1
  -- if callableId = $callableId_IR(nameIR, parameterListIR)
  -- if externMethodDef
        = EXTERN_METHOD
          ABSTRACT
          nameIR
          `<typeParameterListIR ++ typeParameterListIR_inferred>
          `(parameterListIR)
  -- if IC_1
        = $add_callableDef_overload_i(BLOCK, IC_0, callableId, externMethodDef)

rule ExternMethods_inst/nil:
  IC |- eps : IC

rule ExternMethods_inst/cons:
  IC_0 |- externMethodPrototypeIR_h :: externMethodPrototypeIR_t* : IC_2
  -- ExternMethod_inst: IC_0 |- externMethodPrototypeIR_h : IC_1
  -- ExternMethods_inst: IC_1 |- externMethodPrototypeIR_t* : IC_2
;; === 7-instantiation/7.09.1-inst-parser-statement.spectec ===
rule ParserStmt_inst/constantDeclarationIR:
  IC_0 STO |- constantDeclarationIR : IC_1 STO constantDeclarationIR
  -- ConstDecl_inst: LOCAL IC_0 |- constantDeclarationIR : IC_1

rule ParserStmt_inst/variableDeclarationIR:
  IC STO |- variableDeclarationIR : IC STO variableDeclarationIR

rule ParserStmt_inst/emptyStatementIR:
  IC_0 STO_0 |- emptyStatementIR : IC_1 STO_1 emptyStatementIR_inst
  -- Stmt_inst:
       LOCAL IC_0 STO_0 |- emptyStatementIR : IC_1 STO_1 emptyStatementIR_inst

rule ParserStmt_inst/assignmentStatementIR:
  IC_0 STO_0 |- assignmentStatementIR : IC_1 STO_1 assignmentStatementIR_inst
  -- Stmt_inst:
       LOCAL IC_0 STO_0
         |- assignmentStatementIR
         : IC_1 STO_1 assignmentStatementIR_inst

rule ParserStmt_inst/callStatementIR:
  IC_0 STO_0 |- callStatementIR : IC_1 STO_1 callStatementIR_inst
  -- Stmt_inst:
       LOCAL IC_0 STO_0 |- callStatementIR : IC_1 STO_1 callStatementIR_inst

rule ParserStmt_inst/directApplicationStatementIR:
  IC STO_0 |- directApplicationStatementIR : IC STO_1 parserBlockStatementIR
  -- DirectApplicationStmt_inst:
       LOCAL IC STO_0
         |- directApplicationStatementIR
         : STO_1 constantDeclarationIR callStatementIR
  -- if parserBlockStatementIR
        = _EMPTY `{[constantDeclarationIR, callStatementIR]}

rule ParserStmt_inst/parserBlockStatementIR:
  IC_0 STO_0
    |- annotationList `{parserStatementListIR}
    : IC_1 STO_1 parserBlockStatementIR_inst
  -- ParserStmts_inst:
       IC_0 STO_0
         |- parserStatementListIR
         : IC_1 STO_1 parserStatementListIR_inst
  -- if parserBlockStatementIR_inst
        = annotationList `{parserStatementListIR_inst}

rule ParserStmt_inst/non-else:
  IC STO_0
    |- IF `(typedExpressionIR_cond) parserStatementIR_then
    : IC STO_1 (IF `(typedExpressionIR_cond) parserStatementIR_then_inst)
  -- ParserStmt_inst:
       IC STO_0
         |- parserStatementIR_then
         : IC_then STO_1 parserStatementIR_then_inst

rule ParserStmt_inst/else:
  IC STO_0
    |- IF
       `(typedExpressionIR_cond)
       parserStatementIR_then
       ELSE
       parserStatementIR_else
    : IC
      STO_2
      (IF
       `(typedExpressionIR_cond)
       parserStatementIR_then_inst
       ELSE
       parserStatementIR_else_inst)
  -- ParserStmt_inst:
       IC STO_0
         |- parserStatementIR_then
         : IC_then STO_1 parserStatementIR_then_inst
  -- ParserStmt_inst:
       IC STO_1
         |- parserStatementIR_else
         : IC_else STO_2 parserStatementIR_else_inst

rule ParserStmts_inst/nil:
  IC STO |- eps : IC STO eps

rule ParserStmts_inst/cons:
  IC_0 STO_0
    |- parserStatementIR_h :: parserStatementIR_t*
    : IC_2 STO_2 (parserStatementIR_h_inst :: parserStatementIR_t_inst*)
  -- ParserStmt_inst:
       IC_0 STO_0 |- parserStatementIR_h : IC_1 STO_1 parserStatementIR_h_inst
  -- ParserStmts_inst:
       IC_1 STO_1 |- parserStatementIR_t* : IC_2 STO_2 parserStatementIR_t_inst*
;; === 7-instantiation/7.09.2-inst-parser-state.spectec ===
rule ParserState_inst:
  IC_0 STO_0 |- parserStateIR : IC_2 STO_1
  -- if annotationList
        STATE
        nameIR
        `{parserStatementListIR transitionStatementIR}
        = parserStateIR
  -- ParserStmts_inst:
       IC_0 STO_0
         |- parserStatementListIR
         : IC_1 STO_1 parserStatementListIR_inst
  -- if parserStateIR_inst
        = annotationList
          STATE
          nameIR
          `{parserStatementListIR_inst transitionStatementIR}
  -- if IC_2 = $add_parserState_i(IC_1, nameIR, parserStateIR_inst)

rule ParserStates_inst/nil:
  IC STO |- eps : IC STO

rule ParserStates_inst/cons:
  IC_0 STO_0 |- parserStateIR_h :: parserStateIR_t* : IC_2 STO_2
  -- ParserState_inst: IC_0 STO_0 |- parserStateIR_h : IC_1 STO_1
  -- ParserStates_inst: IC_1 STO_1 |- parserStateIR_t* : IC_2 STO_2
;; === 7-instantiation/7.09.3-parser-declaration.spectec ===
rule ParserLocalDecl_inst/constantDeclarationIR:
  IC_0 STO |- constantDeclarationIR : IC_1 STO constantDeclarationIR
  -- ConstDecl_inst: BLOCK IC_0 |- constantDeclarationIR : IC_1

rule ParserLocalDecl_inst/instantiationIR:
  IC_0 STO_0 |- instantiationIR : IC_1 STO_1 constantDeclarationIR_inst
  -- InstDecl_inst:
       BLOCK IC_0 STO_0
         |- instantiationIR
         : IC_1 STO_1 constantDeclarationIR_inst

rule ParserLocalDecl_inst/variableDeclarationIR:
  IC STO |- variableDeclarationIR : IC STO variableDeclarationIR

rule ParserLocalDecl_inst/valueSetDeclarationIR:
  IC STO_0
    |- annotationList VALUE_SET `<typeIR> `(typedExpressionIR_size) nameIR ';'
    : IC STO_2 constantDeclarationIR
  -- Expr_inst:
       BLOCK IC STO_0 |- typedExpressionIR_size : STO_1 integerValue_size
  -- if n_size = $nat_of_integerValue(integerValue_size)
  -- if typeIR_subst = $subst_type_i(BLOCK, IC, typeIR)
  -- if valueSetObject = VALUE_SET `{eps `(n_size)}
  -- if objectId = IC.PATH ++ nameIR
  -- if STO_2 = $add_store(STO_1, objectId, valueSetObject)
  -- if typeIR_set = SET `<typeIR>
  -- if constantDeclarationIR
        = _EMPTY CONST typeIR_set nameIR ('=' _VALUE (REF objectId)) ';'

rule ParserLocalDecls_inst/nil:
  IC STO |- eps : IC STO eps

rule ParserLocalDecls_inst/cons:
  IC_0 STO_0
    |- parserLocalDeclarationIR_h :: parserLocalDeclarationIR_t*
    : IC_2
      STO_2
      (parserLocalDeclarationIR_h_inst :: parserLocalDeclarationIR_t_inst*)
  -- ParserLocalDecl_inst:
       IC_0 STO_0
         |- parserLocalDeclarationIR_h
         : IC_1 STO_1 parserLocalDeclarationIR_h_inst
  -- ParserLocalDecls_inst:
       IC_1 STO_1
         |- parserLocalDeclarationIR_t*
         : IC_2 STO_2 parserLocalDeclarationIR_t_inst*
;; === 7-instantiation/7.10.1-inst-control-table.spectec ===
rule TableAction_inst/name-annotation-dot-prefix:
  IC STO
    |- annotationList
       tableActionReferenceIR
       '#'
       `(parameterListIR ',' parameterListIR_control)
       ';'
    : STO tableActionIR
  -- if tableActionReferenceIR = prefixedNameIR _ `(argumentListIR)
  -- if (cursor, _, actionDef)
        = $find_callableDef_non_overload_i(LOCAL, IC, prefixedNameIR)
  -- if annotationList_actionDef ACTION nameIR `(_) _ = actionDef
  -- if nameIR_anno = $name_annotation(annotationList_actionDef)
  -- if $starts_with(nameIR_anno, ".")
  -- if controlPlaneNameIR = $strip_prefix(nameIR_anno, ".")
  -- if tableActionReferenceIR'
        = prefixedNameIR controlPlaneNameIR `(argumentListIR)
  -- if tableActionIR
        = annotationList
          tableActionReferenceIR'
          '#'
          `(parameterListIR ',' parameterListIR_control)
          ';'

rule TableAction_inst/name-annotation:
  IC STO
    |- annotationList
       tableActionReferenceIR
       '#'
       `(parameterListIR ',' parameterListIR_control)
       ';'
    : STO tableActionIR
  -- if tableActionReferenceIR = prefixedNameIR _ `(argumentListIR)
  -- if (cursor, _, actionDef)
        = $find_callableDef_non_overload_i(LOCAL, IC, prefixedNameIR)
  -- if annotationList_actionDef ACTION nameIR `(_) _ = actionDef
  -- if nameIR_anno = $name_annotation(annotationList_actionDef)
  -- if ~$starts_with(nameIR_anno, ".")
  -- if controlPlaneNameIR
        = $ite<controlPlaneNameIR>(cursor = GLOBAL,
                                   nameIR_anno,
                                   $join_text(IC.PATH ++ nameIR_anno, "."))
  -- if tableActionReferenceIR'
        = prefixedNameIR controlPlaneNameIR `(argumentListIR)
  -- if tableActionIR
        = annotationList
          tableActionReferenceIR'
          '#'
          `(parameterListIR ',' parameterListIR_control)
          ';'

rule TableAction_inst/no-name-annotation:
  IC STO
    |- annotationList
       tableActionReferenceIR
       '#'
       `(parameterListIR ',' parameterListIR_control)
       ';'
    : STO tableActionIR
  -- if tableActionReferenceIR = prefixedNameIR _ `(argumentListIR)
  -- if (cursor, _, actionDef)
        = $find_callableDef_non_overload_i(LOCAL, IC, prefixedNameIR)
  -- if annotationList_actionDef ACTION nameIR `(_) _ = actionDef
  -- if eps = $name_annotation(annotationList_actionDef)
  -- if controlPlaneNameIR
        = $ite<controlPlaneNameIR>(cursor = GLOBAL,
                                   nameIR,
                                   $join_text(IC.PATH ++ nameIR, "."))
  -- if tableActionReferenceIR'
        = prefixedNameIR controlPlaneNameIR `(argumentListIR)
  -- if tableActionIR
        = annotationList
          tableActionReferenceIR'
          '#'
          `(parameterListIR ',' parameterListIR_control)
          ';'

rule TableActions_inst/nil:
  IC STO |- eps : STO eps

rule TableActions_inst/cons:
  IC STO_0
    |- tableActionIR_h :: tableActionIR_t*
    : STO_1 (tableActionIR_h_inst :: tableActionIR_t_inst*)
  -- TableAction_inst: IC STO_0 |- tableActionIR_h : STO_1 tableActionIR_h_inst
  -- TableActions_inst:
       IC STO_1 |- tableActionIR_t* : STO_2 tableActionIR_t_inst*

rule TableProperty_inst/tableKeysPropertyIR:
  IC STO |- tableKeysPropertyIR : STO tableKeysPropertyIR

rule TableProperty_inst/tableActionsPropertyIR:
  IC STO_0 |- ACTIONS '=' `{tableActionListIR} : STO_1 tableActionsPropertyIR
  -- TableActions_inst:
       IC STO_0 |- tableActionListIR : STO_1 tableActionListIR_inst
  -- if tableActionsPropertyIR = ACTIONS '=' `{tableActionListIR_inst}

rule TableProperty_inst/tableDefaultActionPropertyIR:
  IC STO |- tableDefaultActionPropertyIR : STO tableDefaultActionPropertyIR

rule TableProperty_inst/tableEntriesPropertyIR:
  IC STO |- tableEntriesPropertyIR : STO tableEntriesPropertyIR

rule TableProperty_inst/custom:
  IC STO_0
    |- annotationList constOptIR CUSTOM nameIR ('=' typedExpressionIR) ';'
    : STO_1 tableCustomPropertyIR_inst
  -- if IC_inner = $enter_path_i(IC, nameIR)
  -- Expr_inst: LOCAL IC_inner STO_0 |- typedExpressionIR : STO_1 value
  -- if tableCustomPropertyIR_inst
        = annotationList constOptIR CUSTOM_CONST nameIR ('=' _VALUE value) ';'

rule TableProperty_inst/custom-const:
  IC STO
    |- annotationList constOptIR CUSTOM_CONST nameIR constantInitializerIR ';'
    : STO tableCustomPropertyIR_inst
  -- if tableCustomPropertyIR_inst
        = annotationList
          constOptIR
          CUSTOM_CONST
          nameIR
          constantInitializerIR
          ';'

rule TableProperties_inst/nil:
  IC STO |- eps : STO eps

rule TableProperties_inst/cons:
  IC STO_0
    |- tablePropertyIR_h :: tablePropertyIR_t*
    : STO_2 (tablePropertyIR_h_inst :: tablePropertyIR_t_inst*)
  -- TableProperty_inst:
       IC STO_0 |- tablePropertyIR_h : STO_1 tablePropertyIR_h_inst
  -- TableProperties_inst:
       IC STO_1 |- tablePropertyIR_t* : STO_2 tablePropertyIR_t_inst*

dec $init_table(tablePropertyListIR) : tableObjectProperty

dec $init_tableKeys(tablePropertyListIR) : tableKeysPropertyIR

dec $init_tableEntries(tablePropertyListIR) : tableEntriesPropertyIR

def $init_tableKeys(tablePropertyIR*) = tableKeysPropertyIR
  -- if [tableKeysPropertyIR]
        = $filter_<tablePropertyIR>(tablePropertyIR*,
                                    (tablePropertyIR <: tableKeysPropertyIR)*)

def $init_tableKeys(tablePropertyIR*) = KEY '=' `{eps}
  -- if eps
        = $filter_<tablePropertyIR>(tablePropertyIR*,
                                    (tablePropertyIR <: tableKeysPropertyIR)*)

def $init_tableEntries(tablePropertyIR*) = tableEntriesPropertyIR
  -- if [tableEntriesPropertyIR]
        = $filter_<tablePropertyIR>(tablePropertyIR*,
                                    (tablePropertyIR <: tableEntriesPropertyIR)*)

def $init_tableEntries(tablePropertyIR*) = _EMPTY eps ENTRIES '=' `{eps}
  -- if eps
        = $filter_<tablePropertyIR>(tablePropertyIR*,
                                    (tablePropertyIR <: tableEntriesPropertyIR)*)

def $init_table(tablePropertyIR*) = TBL
  -- if tableKeysPropertyIR = $init_tableKeys(tablePropertyIR*)
  -- if [tableActionsPropertyIR]
        = $filter_<tablePropertyIR>(tablePropertyIR*,
                                    (tablePropertyIR <: tableActionsPropertyIR)*)
  -- if [tableDefaultActionPropertyIR]
        = $filter_<tablePropertyIR>(tablePropertyIR*,
                                    (tablePropertyIR <: tableDefaultActionPropertyIR)*)
  -- if tableEntriesPropertyIR = $init_tableEntries(tablePropertyIR*)
  -- if tableCustomPropertyIR*
        = $filter_<tablePropertyIR>(tablePropertyIR*,
                                    (tablePropertyIR <: tableCustomPropertyIR)*)
  -- if TBL
        = {KEYS tableKeysPropertyIR,
           ACTIONS tableActionsPropertyIR,
           DEFAULT_ACTION tableDefaultActionPropertyIR,
           ENTRIES tableEntriesPropertyIR,
           CUSTOMS tableCustomPropertyIR*}
;; === 7-instantiation/7.10.2-inst-control-declaration.spectec ===
rule ControlLocalDecl_inst/constantDeclarationIR:
  IC_0 STO |- constantDeclarationIR : IC_1 STO constantDeclarationIR
  -- ConstDecl_inst: BLOCK IC_0 |- constantDeclarationIR : IC_1

rule ControlLocalDecl_inst/instantiationIR:
  IC_0 STO_0 |- instantiationIR : IC_1 STO_1 constantDeclarationIR
  -- InstDecl_inst:
       BLOCK IC_0 STO_0 |- instantiationIR : IC_1 STO_1 constantDeclarationIR

rule ControlLocalDecl_inst/variableDeclarationIR:
  IC STO |- variableDeclarationIR : IC STO variableDeclarationIR

rule ControlLocalDecl_inst/actionDeclarationIR:
  IC_0 STO |- actionDeclarationIR : IC_1 STO eps
  -- ActionDecl_inst: BLOCK IC_0 |- actionDeclarationIR : IC_1

rule ControlLocalDecl_inst/tableDeclarationIR-no-name-annotation:
  IC_0 STO_0
    |- annotationList TABLE typeIR nameIR `{tablePropertyListIR}
    : IC_1 STO_2 constantDeclarationIR
  -- if IC_callee_0 = $inherit_i(BLOCK, IC_0)
  -- if IC_frame = $enter_i(IC_callee_0)
  -- TableProperties_inst:
       IC_frame STO_0 |- tablePropertyListIR : STO_1 tablePropertyListIR_inst
  -- if TBL = $init_table(tablePropertyListIR_inst)
  -- if frame :: _ = IC_frame.LOCAL.FRAMES
  -- if object_table = TABLE nameIR `{frame TBL}
  -- if nameIR_object = $name_annotation_default(annotationList, nameIR)
  -- if objectId = IC_0.PATH ++ nameIR_object
  -- if STO_2 = $add_store(STO_1, objectId, object_table)
  -- if eps = $name_annotation(annotationList)
  -- if IC_1 = $add_var_i(BLOCK, IC_0, nameIR, REF objectId)
  -- if constantDeclarationIR
        = _EMPTY CONST typeIR nameIR ('=' _VALUE (REF objectId)) ';'

rule ControlLocalDecl_inst/tableDeclarationIR-name-annotation:
  IC_0 STO_0
    |- annotationList TABLE typeIR nameIR `{tablePropertyListIR}
    : IC_1 STO_3 constantDeclarationIR
  -- if IC_callee_0 = $inherit_i(BLOCK, IC_0)
  -- if IC_frame = $enter_i(IC_callee_0)
  -- TableProperties_inst:
       IC_frame STO_0 |- tablePropertyListIR : STO_1 tablePropertyListIR_inst
  -- if TBL = $init_table(tablePropertyListIR_inst)
  -- if frame :: _ = IC_frame.LOCAL.FRAMES
  -- if object_table = TABLE nameIR `{frame TBL}
  -- if nameIR_object = $name_annotation_default(annotationList, nameIR)
  -- if objectId = IC_0.PATH ++ nameIR_object
  -- if STO_2 = $add_store(STO_1, objectId, object_table)
  -- if nameIR_annotation = $name_annotation(annotationList)
  -- if objectId_annotation = IC_0.PATH ++ nameIR_annotation
  -- if STO_3 = $add_store(STO_2, objectId_annotation, object_table)
  -- if IC_1 = $add_var_i(BLOCK, IC_0, nameIR, REF objectId)
  -- if constantDeclarationIR
        = _EMPTY CONST typeIR nameIR ('=' _VALUE (REF objectId)) ';'

rule ControlLocalDecls_inst/nil:
  IC STO |- eps : IC STO eps

rule ControlLocalDecls_inst/cons-none:
  IC_0 STO_0
    |- controlLocalDeclarationIR_h :: controlLocalDeclarationIR_t*
    : IC_2 STO_2 controlLocalDeclarationIR_t_inst*
  -- ControlLocalDecl_inst:
       IC_0 STO_0 |- controlLocalDeclarationIR_h : IC_1 STO_1 eps
  -- ControlLocalDecls_inst:
       IC_1 STO_1
         |- controlLocalDeclarationIR_t*
         : IC_2 STO_2 controlLocalDeclarationIR_t_inst*

rule ControlLocalDecls_inst/cons-some:
  IC_0 STO_0
    |- controlLocalDeclarationIR_h :: controlLocalDeclarationIR_t*
    : IC_2
      STO_2
      (controlLocalDeclarationIR_h_inst :: controlLocalDeclarationIR_t_inst*)
  -- ControlLocalDecl_inst:
       IC_0 STO_0
         |- controlLocalDeclarationIR_h
         : IC_1 STO_1 controlLocalDeclarationIR_h_inst
  -- ControlLocalDecls_inst:
       IC_1 STO_1
         |- controlLocalDeclarationIR_t*
         : IC_2 STO_2 controlLocalDeclarationIR_t_inst*
;; === 7-instantiation/7.11.1-inst-constructor.spectec ===
rule Constructor_inst/non-aliased-none-type:
  p IC
    |- prefixedNameIR `<typeArgumentIR*> `(argumentIR*)
    : constructorDef `<typeArgumentIR*> `('#' id_default* '#' id_optional*)
  -- if eps = $find_typeDef_i(p, IC, prefixedNameIR)
  -- if _ ':' constructorDef '#' id_default* '#' id_optional*
        = $find_constructorDef_i(IC, prefixedNameIR, argumentIR*)

rule Constructor_inst/non-aliased-some-type:
  p IC
    |- prefixedNameIR `<typeArgumentIR*> `(argumentIR*)
    : constructorDef `<typeArgumentIR*> `('#' id_default* '#' id_optional*)
  -- if typeDefIR = $find_typeDef_i(p, IC, prefixedNameIR)
  -- if ~(typeDefIR <: typedefTypeIR)
  -- if _ ':' constructorDef '#' id_default* '#' id_optional*
        = $find_constructorDef_i(IC, prefixedNameIR, argumentIR*)

rule Constructor_inst/aliased:
  p IC
    |- prefixedNameIR `<eps> `(argumentIR*)
    : constructorDef `<typeArgumentIR*> `('#' id_default* '#' id_optional*)
  -- if TYPEDEF nameIR_alias typeIR_alias
        = $find_typeDef_i(p, IC, prefixedNameIR)
  -- if (nameIR, typeArgumentIR*) = $resolve_type_alias(typeIR_alias)
  -- if _ ':' constructorDef '#' id_default* '#' id_optional*
        = $find_constructorDef_i(IC, _NAME nameIR, argumentIR*)
;; === 7-instantiation/7.11.2-inst-constructor-call.spectec ===
rule Copy_in_argument_inst:
  STO_0 p_caller IC_caller argumentIR '@' p_callee IC_callee_0 id
    ~> STO_1 IC_callee_1
  -- if IC_caller_inner = $enter_path_i(IC_caller, id)
  -- Argument_inst: p_caller IC_caller_inner STO_0 |- argumentIR : STO_1 value
  -- if IC_callee_1 = $add_var_i(p_callee, IC_callee_0, id, value)

rule Copy_in_inst/nil:
  STO p_caller IC_caller eps '@' p_callee IC_callee eps ~> STO IC_callee

rule Copy_in_inst/cons:
  STO_0
  p_caller
  IC_caller
  (argumentIR_h :: argumentIR_t*)
  '@'
  p_callee
  IC_callee_0
  (id_h :: id_t*)
    ~> STO_2 IC_callee_2
  -- Copy_in_argument_inst:
       STO_0 p_caller IC_caller argumentIR_h '@' p_callee IC_callee_0 id_h
         ~> STO_1 IC_callee_1
  -- Copy_in_inst:
       STO_1 p_caller IC_caller argumentIR_t* '@' p_callee IC_callee_1 id_t*
         ~> STO_2 IC_callee_2

rule Copy_in_argument_inst_default/initializerIR:
  STO_0 p_caller IC_caller '@' p_callee IC_callee_0 parameterIR
    ~> STO_1 IC_callee_1
  -- if _ _ _ id ('=' typedExpressionIR) = parameterIR
  -- if IC_caller_inner = $enter_path_i(IC_caller, id)
  -- Expr_inst:
       p_caller IC_caller_inner STO_0 |- typedExpressionIR : STO_1 value
  -- if IC_callee_1 = $add_var_i(p_callee, IC_callee_0, id, value)

rule Copy_in_argument_inst_default/constantInitializerIR:
  STO p_caller IC_caller '@' p_callee IC_callee_0 parameterIR ~> STO IC_callee_1
  -- if _ _ _ id ('=' _VALUE value) = parameterIR
  -- if IC_callee_1 = $add_var_i(p_callee, IC_callee_0, id, value)

rule Copy_in_inst_default/nil:
  STO p_caller IC_caller '@' p_callee IC_callee eps ~> STO IC_callee

rule Copy_in_inst_default/cons:
  STO_0
  p_caller
  IC_caller
  '@'
  p_callee
  IC_callee_0
  (parameterIR_h :: parameterIR_t*)
    ~> STO_2 IC_callee_2
  -- Copy_in_argument_inst_default:
       STO_0 p_caller IC_caller '@' p_callee IC_callee_0 parameterIR_h
         ~> STO_1 IC_callee_1
  -- Copy_in_inst_default:
       STO_1 p_caller IC_caller '@' p_callee IC_callee_1 parameterIR_t*
         ~> STO_2 IC_callee_2

rule Constructor_call/externConstructorDef:
  p IC STO_0
    |- externObjectConstructorDef
       `<typeArgumentIR*>
       `(argumentIR* '#' id_default* '#' id_optional*)
    : STO_2 object_extern
  -- if EXTERN
        nameIR
        `<typeParameterIR*>
        `(constructorParameterIR*)
        `{externMethodPrototypeIR*}
        = externObjectConstructorDef
  -- if p_callee = BLOCK
  -- if IC_callee_0 = $inherit_i(GLOBAL, IC)
  -- if theta = `{(typeParameterIR ':' typeArgumentIR)*}
  -- if IC_callee_1 = IC_callee_0[.BLOCK.TYPE = theta]
  -- if GIVEN
        constructorParameterIR_aligned*
        DEFAULT
        constructorParameterIR_default*
        = $align_parameterListIR(constructorParameterIR*,
                                 argumentIR*,
                                 id_default*,
                                 id_optional*)
  -- (if (_ _ _ id_aligned _ = constructorParameterIR_aligned))*
  -- Copy_in_inst:
       STO_0 p IC argumentIR* '@' p_callee IC_callee_1 id_aligned*
         ~> STO_1 IC_callee_2
  -- Copy_in_inst_default:
       STO_0 p IC '@' p_callee IC_callee_2 constructorParameterIR_default*
         ~> STO_2 IC_callee_3
  -- ExternMethods_inst: IC_callee_3 |- externMethodPrototypeIR* : IC_callee_4
  -- if `{(callableId ':' externMethodDef)*} = IC_callee_4.BLOCK.CALLABLE
  -- (if (_ _ _ id_cparam _ = constructorParameterIR))*
  -- (if (value_cparam
         = $find_map<id, value>(IC_callee_4.BLOCK.FRAME, id_cparam)))*
  -- if objectState = $init_objectState(nameIR, typeArgumentIR*, value_cparam*)
  -- if theta_extern = IC_callee_4.BLOCK.TYPE
  -- if frame_extern = IC_callee_4.BLOCK.FRAME
  -- if externMethodDefEnv_extern = `{(callableId ':' externMethodDef)*}
  -- if object_extern
        = EXTERN
          nameIR
          `<theta_extern>
          `{objectState frame_extern externMethodDefEnv_extern}

rule Constructor_call/parserConstructorDef:
  p IC STO_0
    |- parserObjectConstructorDef
       `<typeArgumentIR*>
       `(argumentIR* '#' id_default* '#' id_optional*)
    : STO_4 object_parser
  -- if PARSER
        `<typeParameterIR*>
        `(parameterIR*)
        `(constructorParameterIR*)
        `{parserLocalDeclarationIR* parserStateIR*}
        = parserObjectConstructorDef
  -- if p_callee = BLOCK
  -- if IC_callee_0 = $inherit_i(GLOBAL, IC)
  -- if theta_parser = `{(typeParameterIR ':' typeArgumentIR)*}
  -- if IC_callee_1 = IC_callee_0[.BLOCK.TYPE = theta_parser]
  -- if GIVEN
        constructorParameterIR_aligned*
        DEFAULT
        constructorParameterIR_default*
        = $align_parameterListIR(constructorParameterIR*,
                                 argumentIR*,
                                 id_default*,
                                 id_optional*)
  -- (if (_ _ _ id_aligned _ = constructorParameterIR_aligned))*
  -- Copy_in_inst:
       STO_0 p IC argumentIR* '@' p_callee IC_callee_1 id_aligned*
         ~> STO_1 IC_callee_2
  -- Copy_in_inst_default:
       STO_0 p IC '@' p_callee IC_callee_2 constructorParameterIR_default*
         ~> STO_2 IC_callee_3
  -- ParserLocalDecls_inst:
       IC_callee_3 STO_2
         |- parserLocalDeclarationIR*
         : IC_local STO_3 parserLocalDeclarationIR_inst*
  -- ParserStates_inst: IC_local STO_3 |- parserStateIR* : IC_state STO_4
  -- if frame_parser = IC_callee_3.BLOCK.FRAME
  -- if stateEnv_parser = IC_state.BLOCK.STATE
  -- if object_parser
        = PARSER
          `<theta_parser>
          `(parameterIR*)
          `{frame_parser parserLocalDeclarationIR_inst* stateEnv_parser}

rule Constructor_call/controlConstructorDef:
  p IC STO_0
    |- controlObjectConstructorDef
       `<typeArgumentIR*>
       `(argumentIR* '#' id_default* '#' id_optional*)
    : STO_4 object_control
  -- if CONTROL
        `<typeParameterIR*>
        `(parameterIR*)
        `(constructorParameterIR*)
        `{controlLocalDeclarationIR* APPLY controlBodyIR}
        = controlObjectConstructorDef
  -- if p_callee = BLOCK
  -- if IC_callee_0 = $inherit_i(GLOBAL, IC)
  -- if theta_control = `{(typeParameterIR ':' typeArgumentIR)*}
  -- if IC_callee_1 = IC_callee_0[.BLOCK.TYPE = theta_control]
  -- if GIVEN
        constructorParameterIR_aligned*
        DEFAULT
        constructorParameterIR_default*
        = $align_parameterListIR(constructorParameterIR*,
                                 argumentIR*,
                                 id_default*,
                                 id_optional*)
  -- (if (_ _ _ id_aligned _ = constructorParameterIR_aligned))*
  -- Copy_in_inst:
       STO_0 p IC argumentIR* '@' p_callee IC_callee_1 id_aligned*
         ~> STO_1 IC_callee_2
  -- Copy_in_inst_default:
       STO_0 p IC '@' p_callee IC_callee_2 constructorParameterIR_default*
         ~> STO_2 IC_callee_3
  -- ControlLocalDecls_inst:
       IC_callee_3 STO_2
         |- controlLocalDeclarationIR*
         : IC_local_0 STO_3 controlLocalDeclarationIR_inst*
  -- Block_inst:
       IC_local_0 STO_3 |- controlBodyIR : IC_local_1 STO_4 controlBodyIR_inst
  -- if frame_control = IC_callee_3.BLOCK.FRAME
  -- if `{(callableId ':' actionDef)*} = IC_local_1.BLOCK.CALLABLE
  -- if actionDefEnv_control = `{(callableId ':' actionDef)*}
  -- if object_control
        = CONTROL
          `<theta_control>
          `(parameterIR*)
          `{frame_control
            controlLocalDeclarationIR_inst*
            `{(callableId ':' actionDef)*}
            controlBodyIR_inst}

rule Constructor_call/packageConstructorDef:
  p IC STO_0
    |- packageObjectConstructorDef
       `<typeArgumentIR*>
       `(argumentIR* '#' id_default* '#' id_optional*)
    : STO_2 object_package
  -- if PACKAGE `<typeParameterIR*> `(constructorParameterIR*)
        = packageObjectConstructorDef
  -- if p_callee = BLOCK
  -- if IC_callee_0 = $inherit_i(GLOBAL, IC)
  -- if IC_callee_1
        = IC_callee_0[.BLOCK.TYPE = `{(typeParameterIR ':' typeArgumentIR)*}]
  -- if GIVEN
        constructorParameterIR_aligned*
        DEFAULT
        constructorParameterIR_default*
        = $align_parameterListIR(constructorParameterIR*,
                                 argumentIR*,
                                 id_default*,
                                 id_optional*)
  -- (if (_ _ _ id_aligned _ = constructorParameterIR_aligned))*
  -- Copy_in_inst:
       STO_0 p IC argumentIR* '@' p_callee IC_callee_1 id_aligned*
         ~> STO_1 IC_callee_2
  -- Copy_in_inst_default:
       STO_1 p IC '@' p_callee IC_callee_2 constructorParameterIR_default*
         ~> STO_2 IC_callee_3
  -- if theta_package = IC_callee_3.BLOCK.TYPE
  -- if frame_package = IC_callee_3.BLOCK.FRAME
  -- if object_package = PACKAGE `<theta_package> `{frame_package}
