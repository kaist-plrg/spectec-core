;; === 4-p4-ir/4.4-ir-subexpression.spectec ===
dec $subexpressions_of_typedExpressionIR(typedExpressionIR)
  : typedExpressionListIR
  hint(prose_in "the sub-expressions of" %0)

dec $subexpressions_of_typedExpressionListIR(typedExpressionListIR)
  : typedExpressionListIR
  hint(prose_in "the sub-expressions of" %0)

dec $subexpressions_of_expressionIR(expressionIR) : typedExpressionListIR
  hint(prose_in "the sub-expressions of" %0)

dec $subexpressions_of_argumentIR(argumentIR) : typedExpressionListIR
  hint(prose_in "the sub-expressions of" %0)

dec $subexpressions_of_argumentListIR(argumentListIR) : typedExpressionListIR
  hint(prose_in "the sub-expressions of" %0)

def $subexpressions_of_typedExpressionIR(typedExpressionIR)
  = typedExpressionIR :: $subexpressions_of_expressionIR(expressionIR)
  -- if expressionIR '#' _ = typedExpressionIR

def $subexpressions_of_expressionIR(unop typedExpressionIR)
  = $subexpressions_of_typedExpressionIR(typedExpressionIR)

def $subexpressions_of_expressionIR(typedExpressionIR_l
                                    binop
                                    typedExpressionIR_r)
  = $subexpressions_of_typedExpressionIR(typedExpressionIR_l) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_r)

def $subexpressions_of_expressionIR(typedExpressionIR_cond
                                    '?'
                                    typedExpressionIR_then
                                    ':'
                                    typedExpressionIR_else)
  = $subexpressions_of_typedExpressionIR(typedExpressionIR_cond) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_then) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_else)

def $subexpressions_of_expressionIR(`(typeIR) typedExpressionIR)
  = $subexpressions_of_typedExpressionIR(typedExpressionIR)

def $subexpressions_of_expressionIR(SEQ `{typedExpressionListIR})
  = $subexpressions_of_typedExpressionListIR(typedExpressionListIR)

def $subexpressions_of_expressionIR(SEQ `{typedExpressionListIR ',' '...'})
  = $subexpressions_of_typedExpressionListIR(typedExpressionListIR)

def $subexpressions_of_expressionIR(RECORD `{(nameIR '=' typedExpressionIR)*})
  = $subexpressions_of_typedExpressionListIR(typedExpressionIR*)

def $subexpressions_of_expressionIR(RECORD
                                    `{(nameIR '=' typedExpressionIR)* ',' '...'})
  = $subexpressions_of_typedExpressionListIR(typedExpressionIR*)

def $subexpressions_of_expressionIR(typedExpressionIR '.' nameIR)
  = $subexpressions_of_typedExpressionIR(typedExpressionIR)

def $subexpressions_of_expressionIR(typedExpressionIR_base
                                    `[typedExpressionIR_index])
  = $subexpressions_of_typedExpressionIR(typedExpressionIR_base) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_index)

def $subexpressions_of_expressionIR(typedExpressionIR_base
                                    `[typedExpressionIR_hi
                                      ':'
                                      typedExpressionIR_lo])
  = $subexpressions_of_typedExpressionIR(typedExpressionIR_base) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_hi) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_lo)

def $subexpressions_of_expressionIR(constructorTargetIR `(argumentIR*))
  = $subexpressions_of_argumentListIR(argumentIR*)

def $subexpressions_of_expressionIR(callableTargetIR
                                    `<typeArgumentIR*>
                                    `(argumentIR*))
  = $subexpressions_of_argumentListIR(argumentIR*)

def $subexpressions_of_expressionIR(`(typedExpressionIR))
  = $subexpressions_of_typedExpressionIR(typedExpressionIR)

def $subexpressions_of_expressionIR(_) = eps
  -- otherwise

def $subexpressions_of_typedExpressionListIR(typedExpressionIR*)
  = $concat_<typedExpressionIR>($subexpressions_of_typedExpressionIR(typedExpressionIR)*)

def $subexpressions_of_argumentIR(typedExpressionIR)
  = $subexpressions_of_typedExpressionIR(typedExpressionIR)

def $subexpressions_of_argumentIR(nameIR '=' typedExpressionIR)
  = $subexpressions_of_typedExpressionIR(typedExpressionIR)

def $subexpressions_of_argumentIR(_) = eps
  -- otherwise

def $subexpressions_of_argumentListIR(argumentIR*)
  = $concat_<typedExpressionIR>($subexpressions_of_argumentIR(argumentIR)*)
;; === 5-typing/5.00-flow.spectec ===
syntax flow =
  | CONT
  | RET

var f : flow

dec $join_flow(flow, flow) : flow
  hint(prose_in "the merged control flow of" %0 "and" %1)

def $join_flow(RET, RET) = RET

def $join_flow(f_a, f_b) = CONT
  -- otherwise
;; === 5-typing/5.01-static-env.spectec ===
syntax varTypeIR =
  | direction typeIR ctk value?
  hint(prose_fields "direction" "type" "compile-time known-ness" "default value")

syntax typeFrame = map<id, varTypeIR>

dec $empty_typeFrame : typeFrame

def $empty_typeFrame = $empty_map<id, varTypeIR>

syntax typeDefEnv = map<typeId, typeDefIR>

dec $empty_typeDefEnv : typeDefEnv

def $empty_typeDefEnv = $empty_map<typeId, typeDefIR>

syntax callableTypeDefEnv = map<callableId, callableTypeDefIR>

dec $empty_callableTypeDefEnv : callableTypeDefEnv

def $empty_callableTypeDefEnv = $empty_map<callableId, callableTypeDefIR>

syntax constructorTypeDefEnv = map<constructorId, constructorTypeDefIR>

dec $empty_constructorTypeDefEnv : constructorTypeDefEnv

def $empty_constructorTypeDefEnv
  = $empty_map<constructorId, constructorTypeDefIR>
;; === 5-typing/5.02.1-typing-context.spectec ===
syntax globalTypingLayer =
  {CONSTRUCTOR constructorTypeDefEnv,
   TYPE typeDefEnv,
   CALLABLE callableTypeDefEnv,
   FRAME typeFrame}

syntax blockKind =
  | _EMPTY
  | EXTERN
  | PARSER
  | CONTROL
  | PACKAGE

syntax blockTypingLayer =
  {KIND blockKind, TYPE typeDefEnv, CALLABLE callableTypeDefEnv, FRAME typeFrame}

syntax actionLocalKind =
  | ACTION

syntax definedFunctionLocalKind =
  | FUNCTION ':' typeIR

syntax externFunctionLocalKind =
  | EXTERN_FUNCTION ':' typeIR

syntax functionLocalKind =
  | definedFunctionLocalKind
  | externFunctionLocalKind

syntax externMethodLocalKind =
  | EXTERN_METHOD ':' typeIR
  | EXTERN_METHOD ABSTRACT ':' typeIR

syntax methodLocalKind =
  | externMethodLocalKind
  | PARSER_STATE
  | CONTROL_APPLY_METHOD
  | TABLE_APPLY_METHOD

syntax localKind =
  | _EMPTY
  | actionLocalKind
  | functionLocalKind
  | methodLocalKind

syntax localTypingLayer = {KIND localKind, TYPE typeDefEnv, FRAMES typeFrame*}

syntax typingContext =
  {GLOBAL globalTypingLayer, BLOCK blockTypingLayer, LOCAL localTypingLayer}

var TC : typingContext

dec $empty_typingContext : typingContext
  hint(prose_in "an empty typing context")

def $empty_typingContext = TC
  -- if globalTypingLayer
        = {CONSTRUCTOR $empty_constructorTypeDefEnv,
           TYPE $empty_typeDefEnv,
           CALLABLE $empty_callableTypeDefEnv,
           FRAME $empty_typeFrame}
  -- if blockTypingLayer
        = {KIND _EMPTY,
           TYPE $empty_typeDefEnv,
           CALLABLE $empty_callableTypeDefEnv,
           FRAME $empty_typeFrame}
  -- if localTypingLayer
        = {KIND _EMPTY, TYPE $empty_typeDefEnv, FRAMES ([$empty_typeFrame])}
  -- if TC
        = {GLOBAL globalTypingLayer,
           BLOCK blockTypingLayer,
           LOCAL localTypingLayer}

dec $bound(cursor, typingContext) : bound
  hint(prose_in "bound type variables from the" %0 "layer of" %1)

def $bound(GLOBAL, TC) = `{eps}

def $bound(BLOCK, TC) = $dom_map<typeId, typeDefIR>(TC.BLOCK.TYPE)

def $bound(LOCAL, TC) = $union_set<typeId>(B_block, B_local)
  -- if B_block = $bound(BLOCK, TC)
  -- if B_local = $dom_map<typeId, typeDefIR>(TC.LOCAL.TYPE)

dec $enter_t(typingContext) : typingContext
  hint(prose_in %0 "with a new local frame")

def $enter_t(TC) = TC[.LOCAL.FRAMES = $empty_typeFrame :: TC.LOCAL.FRAMES]

dec $exit_t(typingContext) : typingContext
  hint(prose_in %0 "with the innermost frame removed")

def $exit_t(TC) = TC[.LOCAL.FRAMES = typeFrame_t*]
  -- if typeFrame_h :: typeFrame_t* = TC.LOCAL.FRAMES

dec $add_var_t(cursor, typingContext, id, varTypeIR) : typingContext
  hint(prose_in %1 "where" %2 "to" %3 "is added to the" %0 "layer")

dec $add_vars_t(cursor, typingContext, id*, varTypeIR*) : typingContext
  hint(prose_in %1
                "where each of"
                %2
                "to each of"
                %3
                "are added to the"
                %0
                "layer")

def $add_var_t(GLOBAL, TC, id, varTypeIR) = TC'
  -- if typeFrame = TC.GLOBAL.FRAME
  -- if ~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame))
  -- if _ typeIR _ _ = varTypeIR
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if (id = "main") => (typeIR_unroll <: packageObjectTypeIR)
  -- if typeFrame_update = $add_map<nameIR, varTypeIR>(typeFrame, id, varTypeIR)
  -- if TC' = TC[.GLOBAL.FRAME = typeFrame_update]

def $add_var_t(BLOCK, TC, id, varTypeIR) = TC'
  -- if typeFrame = TC.BLOCK.FRAME
  -- if ~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame))
  -- if id =/= "main"
  -- if typeFrame_update
        = $add_map<nameIR, varTypeIR>(TC.BLOCK.FRAME, id, varTypeIR)
