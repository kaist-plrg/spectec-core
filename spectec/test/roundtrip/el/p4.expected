syntax externMethodPrototype =
  | annotationList functionPrototype ';'
  | annotationList ABSTRACT functionPrototype ';'

syntax externConstructorOrMethodPrototype =
  | externConstructorPrototype
  | externMethodPrototype

dec $is_externConstructorPrototype(externConstructorOrMethodPrototype) : bool

def $is_externConstructorPrototype(externConstructorPrototype) = true

def $is_externConstructorPrototype(externConstructorOrMethodPrototype) = false
  -- otherwise

dec $is_externMethodPrototype(externConstructorOrMethodPrototype) : bool

def $is_externMethodPrototype(externConstructorOrMethodPrototype)
  = ~$is_externConstructorPrototype(externConstructorOrMethodPrototype)

syntax externConstructorOrMethodPrototypeList =
  | _EMPTY
