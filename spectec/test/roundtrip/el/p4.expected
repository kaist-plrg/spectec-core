def $cast_invalid_header(headerUnionTypeIR) = $default(headerUnionTypeIR)

def $cast_op(typeIR, invalidHeaderValue) = $cast_invalid_header(typeIR_unroll)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_set(typeIR, setValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_set(SET `<typeIR>, SET `{value}) = SET `{$cast_op(typeIR, value)}

def $cast_set(SET `<typeIR>, SET `{value_b '&&&' value_m})
  = SET `{value_b_cast '&&&' value_m_cast}
  -- if value_b_cast = $cast_op(typeIR, value_b)
  -- if value_m_cast = $cast_op(typeIR, value_m)

def $cast_set(SET `<typeIR>, SET `{value_l '..' value_u})
  = SET `{value_l_cast '..' value_u_cast}
  -- if value_l_cast = $cast_op(typeIR, value_l)
  -- if value_u_cast = $cast_op(typeIR, value_u)

def $cast_op(typeIR, setValue) = $cast_set(typeIR_unroll, setValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

def $default(BOOL) = _B false

def $default(ERROR) = ERROR '.' "NoError"

def $default(STRING) = '"' text_empty '"'
  -- if text_empty = ""

def $default(INT) = D 0

def $default(BIT `<w>) = w W 0

def $default(INT `<w>) = w S 0

def $default(VARBIT `<w>) = w '.' 0 V 0

def $default(TYPEDEF _ typeIR) = $default(typeIR)

def $default(TYPE _ typeIR) = $default(typeIR)

def $default(TUPLE `<typeIR*>) = TUPLE `($default(typeIR)*)

def $default(typeIR `[n_s]) = HEADER_STACK `[value* `(0 ';' n_s)]
  -- if value* = $repeat_<value>($default(typeIR), n_s)

def $default(STRUCT typeId `<_> `{(_ typeIR_f id_f ';')*})
  = STRUCT typeId `{($default(typeIR_f) id_f ';')*}

def $default(HEADER typeId `<_> `{(_ typeIR_f id_f ';')*})
  = HEADER typeId `{false ';' ($default(typeIR_f) id_f ';')*}

def $default(HEADER_UNION typeId `<_> `{(_ typeIR_f id_f ';')*})
  = HEADER_UNION typeId `{($default(typeIR_f) id_f ';')*}

def $default(ENUM typeId `{id_f_h :: _}) = typeId '.' id_f_h

def $default(ENUM typeId `<typeIR> `{(nameIR_field '=' value_field ';')*})
  = typeId '.' id_zero '.' value_zero
  -- if value_zero = $cast_int(typeIR, D 0)
  -- if id_zero = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*)

def $default(ENUM typeId `<typeIR> `{(nameIR_field '=' value_field ';')*})
  = typeId '.' id_zero '.' value_zero
  -- if value_zero = $cast_int(typeIR, D 0)
  -- if eps = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*)
  -- if id_zero = "__UNSPECIFIED"

dec $bitacc_range_op(value, value, value) : value
  hint(testgen_ignore)
  hint(prose_in %0 `[%1 ':' %2])

def $bitacc_range_op(integerValue_b, integerValue_h, integerValue_l) = w W i
  -- if i_b = $int_of_integerValue(integerValue_b)
  -- if i_h = $int_of_integerValue(integerValue_h)
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if w = $(i_h + 1 - i_l)
  -- if i = $bitacc(i_b, i_h, i_l)

dec $bitacc_offset_op(value, value, value) : value
  hint(testgen_ignore)
  hint(prose_in %0 `[%1 '+' : %2])

def $bitacc_offset_op(integerValue_b, integerValue_l, integerValue_w) = w W i
  -- if i_b = $int_of_integerValue(integerValue_b)
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if w = $nat_of_integerValue(integerValue_w)
  -- if i_h = $(i_l + w - 1)
  -- if i = $bitacc(i_b, i_h, i_l)

dec $bitacc_range_replace_op(value, value, value, value) : value
  hint(testgen_ignore)
  hint(prose_in %0 `[%1 ':' %2] "replaced with" %3)

def $bitacc_range_replace_op(integerValue_b,
                             integerValue_h,
                             integerValue_l,
                             integerValue_r)
  = w W i
  -- if w W i_b = integerValue_b
  -- if i_h = $int_of_integerValue(integerValue_h)
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if _ W i_r = integerValue_r
  -- if i = $bitacc_replace(i_b, i_h, i_l, i_r)

dec $bitacc_offset_replace_op(value, value, value, value) : value
  hint(testgen_ignore)
  hint(prose_in %0 `[%1 '+' : %2] "replaced with" %3)

def $bitacc_offset_replace_op(integerValue_b,
                              integerValue_l,
                              integerValue_w,
                              integerValue_r)
  = w W i
  -- if w W i_b = integerValue_b
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if n_w = $nat_of_integerValue(integerValue_w)
  -- if i_h = $(i_l + n_w - 1)
  -- if _ W i_r = integerValue_r
  -- if i = $bitacc_replace(i_b, i_h, i_l, i_r)

dec $sizeof(typeIR, id) : value
  hint(testgen_ignore)

dec $sizeof_minSizeInBits(typeIR) : value
  hint(testgen_ignore)

dec $sizeof_minSizeInBits'(typeIR) : nat
  hint(testgen_ignore)

dec $sizeof_minSizeInBytes(typeIR) : value
  hint(testgen_ignore)

dec $sizeof_maxSizeInBits(typeIR) : value
  hint(testgen_ignore)

dec $sizeof_maxSizeInBits'(typeIR) : nat
  hint(testgen_ignore)

dec $sizeof_maxSizeInBytes(typeIR) : value
  hint(testgen_ignore)

def $sizeof_minSizeInBits(typeIR) = D $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(BOOL) = 1

def $sizeof_minSizeInBits'(INT `<w>) = w

def $sizeof_minSizeInBits'(BIT `<w>) = w

def $sizeof_minSizeInBits'(VARBIT `<_>) = 0

def $sizeof_minSizeInBits'(TYPEDEF _ typeIR) = $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(TYPE _ typeIR) = $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(ENUM _ `<typeIR> `{_})
  = $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(TUPLE `<typeIR*>)
  = $sum_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof_minSizeInBits'(typeIR `[n_size])
  = $($sizeof_minSizeInBits'(typeIR) * n_size)

def $sizeof_minSizeInBits'(STRUCT _ `<_> `{(_ typeIR _ ';')*})
  = $sum_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof_minSizeInBits'(HEADER _ `<_> `{(_ typeIR _ ';')*})
  = $sum_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof_minSizeInBits'(HEADER_UNION _ `<_> `{(_ typeIR _ ';')*})
  = $min_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof(typeIR, "minSizeInBits") = $sizeof_minSizeInBits(typeIR)

def $sizeof_minSizeInBytes(typeIR) = D $(n_size / 8)
  -- if n_size = $sizeof_minSizeInBits'(typeIR)

def $sizeof(typeIR, "minSizeInBytes") = $sizeof_minSizeInBytes(typeIR)

def $sizeof_maxSizeInBits(typeIR) = D $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(BOOL) = 1

def $sizeof_maxSizeInBits'(INT `<w>) = w

def $sizeof_maxSizeInBits'(BIT `<w>) = w

def $sizeof_maxSizeInBits'(VARBIT `<w>) = w

def $sizeof_maxSizeInBits'(TYPEDEF _ typeIR) = $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(TYPE _ typeIR) = $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(ENUM _ `<typeIR> `{_})
  = $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(TUPLE `<typeIR*>)
  = $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof_maxSizeInBits'(typeIR `[n_size])
  = $($sizeof_maxSizeInBits'(typeIR) * n_size)

def $sizeof_maxSizeInBits'(STRUCT _ `<_> `{(_ typeIR _ ';')*})
  = $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof_maxSizeInBits'(HEADER _ `<_> `{(_ typeIR _ ';')*})
  = $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof_maxSizeInBits'(HEADER_UNION _ `<_> `{(_ typeIR _ ';')*})
  = $max_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof(typeIR, "maxSizeInBits") = $sizeof_maxSizeInBits(typeIR)

def $sizeof_maxSizeInBytes(typeIR) = D $(n_size / 8)
  -- if n_size = $sizeof_maxSizeInBits'(typeIR)

def $sizeof(typeIR, "maxSizeInBytes") = $sizeof_maxSizeInBytes(typeIR)
;; === 4-p4-ir/4.0-ir-syntax.spectec ===
syntax prefixedNameIR =
  | _NAME nameIR
  | '.' nameIR

dec $prefixedNonTypeName(prefixedNonTypeName) : prefixedNameIR
  hint(prose_in "the prefixed name of " %0)

def $prefixedNonTypeName(nonTypeName) = _NAME $name(nonTypeName)

def $prefixedNonTypeName(_ID '.' nonTypeName) = '.' $name(nonTypeName)

dec $prefixedTypeName(prefixedTypeName) : prefixedNameIR
  hint(prose_in "the prefixed name of " %0)

def $prefixedTypeName(typeName) = _NAME $name(typeName)

def $prefixedTypeName(_TID '.' typeName) = '.' $name(typeName)

dec $flatten_prefixedNameIR(prefixedNameIR) : nameIR
  hint(prose_in "the string form of " %0)

def $flatten_prefixedNameIR(_NAME nameIR) = nameIR

def $flatten_prefixedNameIR('.' nameIR) = "." ++ nameIR

syntax nameListIR = nameIR*

syntax typeParameterListIR = typeParameterIR*

syntax parameterListIR = parameterIR*

syntax constructorParameterListIR = parameterIR*

syntax namedValueIR =
  | nameIR '=' value

syntax namedValueListIR = namedValueIR*

syntax namedExpressionIR =
  | nameIR '=' typedExpressionIR

syntax namedExpressionListIR = namedExpressionIR*

syntax literalExpressionIR = literalExpression

syntax referenceExpressionIR = prefixedNameIR

syntax defaultExpressionIR = defaultExpression

syntax unaryExpressionIR =
  | unop typedExpressionIR

syntax binaryExpressionIR =
  | typedExpressionIR binop typedExpressionIR

syntax ternaryExpressionIR =
  | typedExpressionIR '?' typedExpressionIR ':' typedExpressionIR

syntax castExpressionIR =
  | `(typeIR) typedExpressionIR

syntax typedExpressionListIR

syntax invalidHeaderExpressionIR = invalidHeaderExpression

syntax sequenceExpressionIR =
  | SEQ `{typedExpressionListIR}
  | SEQ `{typedExpressionListIR ',' '...'}

syntax recordExpressionIR =
  | RECORD `{namedExpressionListIR}
  | RECORD `{namedExpressionListIR ',' '...'}

syntax dataExpressionIR =
  | invalidHeaderExpressionIR
  | sequenceExpressionIR
  | recordExpressionIR

syntax memberAccessBaseIR

syntax errorAccessExpressionIR =
  | ERROR '.' nameIR

syntax memberAccessExpressionIR =
  | memberAccessBaseIR '.' nameIR

syntax indexAccessExpressionIR =
  | typedExpressionIR `[typedExpressionIR]

syntax sliceAccessExpressionIR =
  | typedExpressionIR `[typedExpressionIR ':' typedExpressionIR]
  | typedExpressionIR `[typedExpressionIR '+' : typedExpressionIR]

syntax accessExpressionIR =
  | errorAccessExpressionIR
  | memberAccessExpressionIR
  | indexAccessExpressionIR
  | sliceAccessExpressionIR

syntax typedLvalueIR

syntax typeArgumentListIR

syntax argumentListIR

syntax callableTargetIR =
  | referenceExpressionIR
  | typedExpressionIR '.' nameIR
  | TYPE prefixedNameIR '.' nameIR
  | `(callableTargetIR)

syntax constructorTargetIR =
  | prefixedNameIR `<typeArgumentListIR>

syntax callExpressionIR =
  | constructorTargetIR `(argumentListIR)
  | callableTargetIR `<typeArgumentListIR> `(argumentListIR)

syntax parenthesizedExpressionIR =
  | `(typedExpressionIR)

syntax expressionIR =
  | literalExpressionIR
  | referenceExpressionIR
  | defaultExpressionIR
  | unaryExpressionIR
  | binaryExpressionIR
  | ternaryExpressionIR
  | castExpressionIR
  | dataExpressionIR
  | accessExpressionIR
  | callExpressionIR
  | parenthesizedExpressionIR

syntax expressionNoteIR =
  | `(typeIR ctk)
  hint(prose "a pair of type" %0 "and compile-time known-ness" %1)
  hint(prose_fields "type" "compile-time known-ness")

syntax typedExpressionIR =
  | expressionIR '#' expressionNoteIR
  hint(print %0)
  hint(prose %0 "annotated with" %1)
  hint(prose_fields "expression" "note")

syntax typedExpressionListIR = typedExpressionIR*

syntax memberAccessBaseIR =
  | TYPE prefixedNameIR
  | typedExpressionIR

dec $type_of_typedExpressionIR(typedExpressionIR) : typeIR
  hint(prose_in "the type of" %0)

