;; === 2-static-runtime/2.0-domain.spectec ===
syntax cursor =
  | GLOBAL
  | BLOCK
  | LOCAL

var p : cursor

syntax nameIR = text

dec $name(name) : nameIR
  hint(prose_in "the name of" %0)

def $name(_ID text) = text

def $name(_TID text) = text

def $name(APPLY) = "apply"

def $name(KEY) = "key"

def $name(ACTIONS) = "actions"

def $name(STATE) = "state"

def $name(ENTRIES) = "entries"

def $name(TYPE) = "type"

def $name(PRIORITY) = "priority"

def $name(LIST) = "list"

dec $tableCustomName(tableCustomName) : nameIR
  hint(prose_in "the name of" %0)

def $tableCustomName(_ID text) = text

def $tableCustomName(_TID text) = text

def $tableCustomName(APPLY) = "apply"

def $tableCustomName(STATE) = "state"

def $tableCustomName(TYPE) = "type"

def $tableCustomName(PRIORITY) = "priority"

syntax id = nameIR

syntax typeId = nameIR

builtin dec $fresh_typeId : typeId
  hint(prose_in "a fresh type variable")

dec $fresh_typeIds(nat) : typeId*
  hint(prose_in %0 "fresh type variables")

def $fresh_typeIds(0) = eps

def $fresh_typeIds(n) = $fresh_typeId :: $fresh_typeIds(n')
  -- if n =/= 0
  -- if n' = $(n - 1)

syntax callTargetId =
  | nameIR `(id*)

syntax callableId = callTargetId

syntax constructorId = callTargetId

dec $callableId(name, parameterList) : callableId
  hint(prose_in "the callable identifier for" %0 `(%1))

dec $callableId'(parameterList) : id*

dec $constructorId(name, constructorParameterListOpt) : constructorId
  hint(prose_in "the constructor identifier for" %0 %1)

def $callableId(name, parameterList)
  = $name(name) `($callableId'(parameterList))

def $constructorId(name, _EMPTY) = $name(name) `(eps)

def $constructorId(name, `(parameterList)) = $callableId(name, parameterList)

def $callableId'(_EMPTY) = eps

def $callableId'(_ _ _ name _) = $name(name)

def $callableId'(nonEmptyParameterList ',' (_ _ _ name _))
  = $callableId'(nonEmptyParameterList) ++ [$name(name)]

syntax objectId = nameIR*

dec $objectId_ends_with(objectId, nameIR) : bool
  hint(prose_true %0 "is an object name that ends with" %1)
  hint(prose_false %0 "is an object name that does not end with" %1)

def $objectId_ends_with(objectId, nameIR) = true
  -- if nameIR :: _ = $rev_<id>(objectId)

def $objectId_ends_with(objectId, nameIR) = false
  -- otherwise
;; === 2-static-runtime/2.1.1-value.spectec ===
syntax boolValue =
  | _B bool

syntax errorValue =
  | ERROR '.' nameIR

syntax matchKindValue =
  | MATCH_KIND '.' nameIR

syntax stringValue = stringLiteral

syntax integerValue =
  | integerLiteral
  | nat '.' nat V int

syntax baseValue =
  | boolValue
  | errorValue
  | matchKindValue
  | stringValue
  | integerValue

syntax value

syntax listValue =
  | LIST `[value*]

syntax tupleValue =
  | TUPLE `(value*)

syntax headerStackValue =
  | HEADER_STACK `[value* `(nat ';' nat)]

syntax fieldValue =
  | value nameIR ';'

syntax structValue =
  | STRUCT typeId `{fieldValue*}

syntax headerValue =
  | HEADER typeId `{bool ';' fieldValue*}

syntax headerUnionValue =
  | HEADER_UNION typeId `{fieldValue*}

syntax enumValue =
  | typeId '.' nameIR
  | typeId '.' nameIR '.' value

syntax dataValue =
  | listValue
  | tupleValue
  | headerStackValue
  | structValue
  | headerValue
  | headerUnionValue
  | enumValue

syntax objectReferenceValue =
  | REF objectId

syntax defaultValue =
  | DEFAULT

syntax invalidHeaderValue =
  | '{#}'

syntax sequenceValue =
  | SEQ `(value*)
  | SEQ `(value* ',' '...')

syntax recordValue =
  | RECORD `{fieldValue*}
  | RECORD `{fieldValue* ',' '...'}

syntax setValue =
  | SET `{value}
  | SET `{value* `(nat)}
  | SET `{value '&&&' value}
  | SET `{value '..' value}
  | SET `{'...'}

syntax tableMetadataEnumValue =
  | TABLE_ENUM typeId '.' nameIR

syntax tableMetadataStructValue =
  | TABLE_STRUCT
    typeId
    `{HIT boolValue ';' MISS boolValue ';' ACTION_RUN tableMetadataEnumValue ';'}

syntax tableMetadataValue =
  | tableMetadataEnumValue
  | tableMetadataStructValue

syntax synthesizedValue =
  | defaultValue
  | invalidHeaderValue
  | sequenceValue
  | recordValue
  | setValue
  | tableMetadataValue

syntax value =
  | baseValue
  | dataValue
  | objectReferenceValue
  | synthesizedValue
;; === 2-static-runtime/2.1.2-value-aux.spectec ===
builtin dec $bitstr_to_int(int, int) : int
  hint(prose_in "the two's complement representation of bitstring"
                %1
                "of width"
                %0)

builtin dec $int_to_bitstr(int, int) : int
  hint(prose_in "the bitstring of width" %0 "representing the integer" %1)

syntax bits = bool*

builtin dec $bits_to_int_unsigned(bits) : int

builtin dec $bits_to_int_signed(bits) : int

builtin dec $int_to_bits_unsigned(nat, int) : bits

builtin dec $int_to_bits_signed(nat, int) : bits

dec $int_of_integerValue(integerValue) : int
  hint(prose_in "the integer representation of " %0)

def $int_of_integerValue(D i) = i

def $int_of_integerValue(w S i) = $bitstr_to_int(w, i)

def $int_of_integerValue(w W i) = i

def $int_of_integerValue(_ '.' _ V i) = i

dec $nat_of_integerValue(integerValue) : nat?
  hint(prose_in "the natural number representation of " %0)

def $nat_of_integerValue(integerValue) = n
  -- if n = $int_of_integerValue(integerValue)

def $nat_of_integerValue(integerValue) = eps
  -- otherwise

dec $update_fieldValue(fieldValue*, nameIR, value) : fieldValue*

def $update_fieldValue(eps, nameIR, value) = eps

def $update_fieldValue((value_field_h nameIR_field_h ';') :: fieldValue_t*,
                       nameIR,
                       value)
  = (value nameIR ';') :: fieldValue_t*
  -- if nameIR_field_h = nameIR

def $update_fieldValue((value_field_h nameIR_field_h ';') :: fieldValue_t*,
                       nameIR,
                       value)
  = (value_field_h nameIR_field_h ';') :: $update_fieldValue(fieldValue_t*,
                                                             nameIR,
                                                             value)
  -- if nameIR_field_h =/= nameIR

dec $update_headerUnion(fieldValue*, nameIR) : fieldValue*

def $update_headerUnion(eps, nameIR) = eps

def $update_headerUnion((value_field_h nameIR_field_h ';') :: fieldValue_t*,
                        nameIR)
  = (value_field_h nameIR_field_h ';') :: $update_headerUnion(fieldValue_t*,
                                                              nameIR)
  -- if nameIR_field_h = nameIR

def $update_headerUnion((value_field_h nameIR_field_h ';') :: fieldValue_t*,
                        nameIR)
  = (value_field_h_update nameIR_field_h ';') :: $update_headerUnion(fieldValue_t*,
                                                                     nameIR)
  -- if nameIR_field_h =/= nameIR
  -- if HEADER typeId `{_ ';' fieldValue*} = value_field_h
  -- if value_field_h_update = HEADER typeId `{false ';' fieldValue*}

dec $isValid_header(value) : bool

def $isValid_header(headerValue) = b_valid
  -- if HEADER _ `{b_valid ';' _} = headerValue

dec $invalidate_value(value) : value

dec $invalidate_header(headerValue) : headerValue

dec $invalidate_headerUnion(headerUnionValue) : headerUnionValue

def $invalidate_header(HEADER typeId `{_ ';' fieldValue*})
  = HEADER typeId `{false ';' fieldValue*}

def $invalidate_headerUnion(HEADER_UNION
                            typeId
                            `{(value_field nameIR_field ';')*})
  = HEADER_UNION typeId `{(value_field_invalidated nameIR_field ';')*}
  -- (if (value_field_invalidated = $invalidate_value(value_field)))*

def $invalidate_value(headerValue) = $invalidate_header(headerValue)

def $invalidate_value(headerUnionValue)
  = $invalidate_headerUnion(headerUnionValue)

dec $write_value_from_bits(value, nat, bool*) : value

dec $write_value_from_bits'(value, nat, bool*) : (value, bool*)

dec $write_values_from_bits'(value*, nat, bool*) : (value*, bool*)

dec $write_value_fields_from_bits'(fieldValue*, nat, bool*)
  : (fieldValue*, bool*)

dec $write_value_field_from_bits'(fieldValue, nat, bool*) : (fieldValue, bool*)

def $write_value_from_bits(value, n_var, b*) = value_updated
  -- if (value_updated, eps) = $write_value_from_bits'(value, n_var, b*)

def $write_value_from_bits'(_B _, n_var, b_h :: b_t*) = (_B b_h, b_t*)

def $write_value_from_bits'(w W _, n_var, b*) = (w W i, b_t*)
  -- if $(|b*| >= w)
  -- if b_h* = b*[0 : w]
  -- if n_t = $(|b*| - w)
  -- if b_t* = b*[w : n_t]
  -- if i = $int_to_bitstr(w, $bits_to_int_unsigned(b_h*))

def $write_value_from_bits'(w S _, n_var, b*) = (w S i, b_t*)
  -- if $(|b*| >= w)
  -- if b_h* = b*[0 : w]
  -- if n_t = $(|b*| - w)
  -- if b_t* = b*[w : n_t]
  -- if i = $int_to_bitstr(w, $bits_to_int_signed(b_h*))

def $write_value_from_bits'(n_max '.' _ V i, 0, b*) = (n_max '.' 0 V i, b*)

def $write_value_from_bits'(n_max '.' _ V _, n_var, b*)
  = (n_max '.' n_var V i, b_t*)
  -- if $(|b*| >= n_var)
  -- if b_h* = b*[0 : n_var]
  -- if n_t = $(|b*| - n_var)
  -- if b_t* = b*[n_var : n_t]
  -- if i = $int_to_bitstr(n_var, $bits_to_int_signed(b_h*))

def $write_values_from_bits'(eps, n_var, b*) = (eps, b*)

def $write_values_from_bits'(value_h :: value_t*, n_var, b*)
  = (value_h_updated :: value_t_updated*, b_rest*)
  -- if (value_h_updated, b_t*) = $write_value_from_bits'(value_h, n_var, b*)
  -- if (value_t_updated*, b_rest*)
        = $write_values_from_bits'(value_t*, n_var, b_t*)

def $write_value_fields_from_bits'(eps, n_var, b*) = (eps, b*)

def $write_value_fields_from_bits'(fieldValue_h :: fieldValue_t*, n_var, b*)
  = (fieldValue_h_updated :: fieldValue_t_updated*, b_rest*)
  -- if (fieldValue_h_updated, b_t*)
        = $write_value_field_from_bits'(fieldValue_h, n_var, b*)
  -- if (fieldValue_t_updated*, b_rest*)
        = $write_value_fields_from_bits'(fieldValue_t*, n_var, b_t*)

def $write_value_field_from_bits'(value id ';', n_var, b*)
  = (value_updated id ';', b_rest*)
  -- if (value_updated, b_rest*) = $write_value_from_bits'(value, n_var, b*)

def $write_value_from_bits'(STRUCT typeId `{fieldValue*}, n_var, b*)
  = (STRUCT typeId `{fieldValue_updated*}, b_rest*)
  -- if (fieldValue_updated*, b_rest*)
        = $write_value_fields_from_bits'(fieldValue*, n_var, b*)

def $write_value_from_bits'(HEADER typeId `{_ ';' fieldValue*}, n_var, b*)
  = (HEADER typeId `{true ';' fieldValue_updated*}, b_rest*)
  -- if (fieldValue_updated*, b_rest*)
        = $write_value_fields_from_bits'(fieldValue*, n_var, b*)

def $write_value_from_bits'(typeId '.' nameIR '.' value, n_var, b*)
  = (typeId '.' "__UNSPECIFIED" '.' value_updated, b_rest*)
  -- if (value_updated, b_rest*) = $write_value_from_bits'(value, n_var, b*)

def $write_value_from_bits'(HEADER_STACK `[value* `(n_idx ';' n_size)],
                            n_var,
                            b*)
  = (HEADER_STACK `[value_updated* `(n_idx ';' n_size)], b_rest*)
  -- if (value_updated*, b_rest*) = $write_values_from_bits'(value*, n_var, b*)

dec $write_bits_from_value(value) : bool*

def $write_bits_from_value(_B b) = [b]

def $write_bits_from_value(w S i) = $int_to_bits_signed(w, i)

def $write_bits_from_value(w W i) = $int_to_bits_unsigned(w, i)

def $write_bits_from_value(_ '.' w V i) = $int_to_bits_unsigned(w, i)

def $write_bits_from_value(HEADER_STACK `[value_element* `(_ ';' _)])
  = $concat_<bool>($write_bits_from_value(value_element)*)

def $write_bits_from_value(STRUCT _ `{(value_field id_field ';')*})
  = $concat_<bool>($write_bits_from_value(value_field)*)

def $write_bits_from_value(HEADER _ `{true ';' (value_field id_field ';')*})
  = $concat_<bool>($write_bits_from_value(value_field)*)

def $write_bits_from_value(HEADER _ `{false ';' _}) = eps

def $write_bits_from_value(HEADER_UNION _ `{(value id ';')*})
  = $concat_<bool>($write_bits_from_value(value)*)

def $write_bits_from_value(typeId '.' id '.' value)
  = $write_bits_from_value(value)
;; === 2-static-runtime/2.2.1-type.spectec ===
syntax typeIR

syntax typeArgumentIR

syntax voidTypeIR =
  | VOID

syntax boolTypeIR =
  | BOOL

syntax errorTypeIR =
  | ERROR

syntax matchKindTypeIR =
  | MATCH_KIND

syntax stringTypeIR =
  | STRING

syntax intTypeIR =
  | INT

syntax fixedIntTypeIR =
  | INT `<nat>

syntax fixedBitTypeIR =
  | BIT `<nat>

syntax varBitTypeIR =
  | VARBIT `<nat>

syntax integerTypeIR =
  | intTypeIR
  | fixedIntTypeIR
  | fixedBitTypeIR
  | varBitTypeIR

syntax baseTypeIR =
  | voidTypeIR
  | boolTypeIR
  | errorTypeIR
  | matchKindTypeIR
  | stringTypeIR
  | integerTypeIR

syntax nameTypeIR =
  | _NAME typeId

syntax typedefTypeIR =
  | TYPEDEF typeId typeIR hint(print %0)

syntax newTypeIR =
  | TYPE typeId typeIR hint(print %0)

syntax aliasTypeIR =
  | typedefTypeIR
  | newTypeIR

syntax listTypeIR =
  | LIST `<typeIR>

syntax tupleTypeIR =
  | TUPLE `<typeIR*>

syntax headerStackTypeIR =
  | typeIR `[nat]

syntax fieldTypeIR =
  | annotationList typeIR nameIR ';'

syntax structTypeIR =
  | STRUCT typeId `<typeArgumentIR*> `{fieldTypeIR*} hint(print %0#"<"#%1#">")

syntax headerTypeIR =
  | HEADER typeId `<typeArgumentIR*> `{fieldTypeIR*} hint(print %0#"<"#%1#">")

syntax headerUnionTypeIR =
  | HEADER_UNION typeId `<typeArgumentIR*> `{fieldTypeIR*}
  hint(print %0#"<"#%1#">")

syntax valueFieldIR =
  | nameIR '=' value ';'

syntax simpleEnumTypeIR =
  | ENUM typeId `{nameIR*} hint(print %0)

syntax serializableEnumTypeIR =
  | ENUM typeId `<typeIR> `{valueFieldIR*} hint(print %0)

syntax enumTypeIR =
  | simpleEnumTypeIR
  | serializableEnumTypeIR

syntax dataTypeIR =
  | listTypeIR
  | tupleTypeIR
  | headerStackTypeIR
  | structTypeIR
  | headerTypeIR
  | headerUnionTypeIR
  | enumTypeIR

syntax parameterIR

syntax externMethodTypeDefIR

syntax tableMetadataStructTypeIR

syntax externMethodTypeDefEnv = map<callableId, externMethodTypeDefIR>

syntax externObjectTypeIR =
  | EXTERN typeId `<typeArgumentIR*> externMethodTypeDefEnv
  hint(print %0#"<"#%1#">")

syntax parserObjectTypeIR =
  | PARSER typeId `<typeArgumentIR*> `(parameterIR*) hint(print %0#"<"#%1#">")

syntax controlObjectTypeIR =
  | CONTROL typeId `<typeArgumentIR*> `(parameterIR*) hint(print %0#"<"#%1#">")

syntax packageObjectTypeIR =
  | PACKAGE typeId `<typeArgumentIR*> `{typeIR*} hint(print %0#"<"#%1#">")

syntax tableObjectTypeIR =
  | TABLE typeId `{tableMetadataStructTypeIR} hint(print %0)

syntax objectTypeIR =
  | externObjectTypeIR
  | parserObjectTypeIR
  | controlObjectTypeIR
  | packageObjectTypeIR
  | tableObjectTypeIR

syntax defaultTypeIR =
  | DEFAULT

syntax invalidHeaderTypeIR =
  | HEADER_INVALID

syntax sequenceTypeIR =
  | SEQ `<typeIR*>
  | SEQ `<typeIR* ',' '...'>

syntax recordTypeIR =
  | RECORD `{fieldTypeIR*}
  | RECORD `{fieldTypeIR* ',' '...'}

syntax setTypeIR =
  | SET `<typeIR>

syntax tableMetadataEnumTypeIR =
  | TABLE_ENUM typeId `{nameIR*} hint(print %0)

syntax tableMetadataStructTypeIR =
  | TABLE_STRUCT
    typeId
    `{HIT
      boolTypeIR
      ';'
      MISS
      boolTypeIR
      ';'
      ACTION_RUN
      tableMetadataEnumTypeIR
      ';'}
  hint(print %0)

syntax tableMetadataTypeIR =
  | tableMetadataEnumTypeIR
  | tableMetadataStructTypeIR

syntax synthesizedTypeIR =
  | defaultTypeIR
  | invalidHeaderTypeIR
  | sequenceTypeIR
  | recordTypeIR
  | setTypeIR
  | tableMetadataTypeIR

syntax typeIR =
  | baseTypeIR
  | nameTypeIR
  | aliasTypeIR
  | dataTypeIR
  | objectTypeIR
  | synthesizedTypeIR

syntax typeArgumentIR = typeIR
;; === 2-static-runtime/2.2.2-type-def.spectec ===
syntax typeParameterIR = typeId

syntax nameTypeDefIR = nameTypeIR

syntax aliasTypeDefIR = aliasTypeIR

syntax structTypeDefIR =
  | STRUCT typeId `<typeParameterIR*> `{fieldTypeIR*}

syntax headerTypeDefIR =
  | HEADER typeId `<typeParameterIR*> `{fieldTypeIR*}

syntax headerUnionTypeDefIR =
  | HEADER_UNION typeId `<typeParameterIR*> `{fieldTypeIR*}

syntax enumTypeDefIR = enumTypeIR

syntax dataTypeDefIR =
  | structTypeDefIR
  | headerTypeDefIR
  | headerUnionTypeDefIR
  | enumTypeDefIR

syntax externObjectTypeDefIR =
  | EXTERN
    typeId
    `<typeParameterIR* ',' typeParameterIR*>
    externMethodTypeDefEnv

syntax parserObjectTypeDefIR =
  | PARSER typeId `<typeParameterIR* ',' typeParameterIR*> `(parameterIR*)

syntax controlObjectTypeDefIR =
  | CONTROL typeId `<typeParameterIR* ',' typeParameterIR*> `(parameterIR*)

syntax packageObjectTypeDefIR =
  | PACKAGE typeId `<typeParameterIR* ',' typeParameterIR*> `{typeIR*}

syntax tableObjectTypeDefIR = tableObjectTypeIR

syntax objectTypeDefIR =
  | externObjectTypeDefIR
  | parserObjectTypeDefIR
  | controlObjectTypeDefIR
  | packageObjectTypeDefIR
  | tableObjectTypeDefIR

syntax typeDefIR =
  | nameTypeDefIR
  | aliasTypeDefIR
  | dataTypeDefIR
  | objectTypeDefIR
