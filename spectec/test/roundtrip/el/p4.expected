dec $callableId_of_externMethodPrototype(externMethodPrototype) : callableId
  hint(prose_in "callable id of " %0)

def $callableId_of_externMethodPrototype(_ (_ name _ `(parameterList)) ';')
  = $callableId(name, parameterList)

def $callableId_of_externMethodPrototype(_
                                         ABSTRACT
                                         (_ name _ `(parameterList))
                                         ';')
  = $callableId(name, parameterList)

dec $type_of_externMethodPrototypeIR(externMethodPrototypeIR)
  : externMethodTypeDefIR
  hint(prose_in "callable type definition of " %0)

def $type_of_externMethodPrototypeIR(_
                                     (typeIR_ret
                                      nameIR
                                      `<typeParameterListIR_expl
                                        ','
                                        typeParameterListIR_impl>
                                      `(parameterIR*))
                                     ';')
  = externMethodTypeDefIR
  -- if externMethodTypeDefIR
        = EXTERN_METHOD
          nameIR
          `<typeParameterListIR_expl ',' typeParameterListIR_impl>
          `(parameterIR*)
          ':'
          typeIR_ret

def $type_of_externMethodPrototypeIR(_
                                     ABSTRACT
                                     (typeIR_ret
                                      nameIR
                                      `<typeParameterListIR_expl
                                        ','
                                        typeParameterListIR_impl>
                                      `(parameterIR*))
                                     ';')
  = externMethodTypeDefIR
  -- if externMethodTypeDefIR
        = EXTERN_METHOD
          ABSTRACT
          nameIR
          `<typeParameterListIR_expl ',' typeParameterListIR_impl>
          `(parameterIR*)
          ':'
          typeIR_ret

