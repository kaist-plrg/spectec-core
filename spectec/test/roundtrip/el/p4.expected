rule ParserLocalDecl_ok/instantiation:
  TC_0 |- instantiation : TC_1 instantiationIR
  -- InstDecl_ok: BLOCK TC_0 |- instantiation : TC_1 instantiationIR

rule ParserLocalDecl_ok/variableDeclaration:
