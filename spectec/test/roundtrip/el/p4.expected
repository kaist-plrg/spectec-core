  -- ParserTransition_ok:
       TC_2 nameIR_state* |- transitionStatement : transitionStatementIR
  -- if TC_3 = $exit_t(TC_2)
  -- if parserStateIR
        = annotationList
          STATE
          nameIR
          `{parserStatementIR* transitionStatementIR}

rule ParserStateList_ok:
  TC |- parserStateList : parserStateIR*
