  -- if TC_1 = $add_var_t(BLOCK, TC_0, nameIR, varTypeIR)
  -- if valueSetDeclarationIR
        = annotationList VALUE_SET `<typeIR> `(typedExpressionIR) nameIR ';'

relation ParserLocalDecls_ok:
