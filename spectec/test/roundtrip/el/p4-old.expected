  -- if (functionTypeIR, tid_impl*)
        = $specialize_routineTypeDef(routineTypeDefIR, typeArgumentIR*)
  -- if bound = $union_set<tid>($bound(p, TC), `{tid_impl*}`)
  -- RoutineType_wf: bound |- functionTypeIR

