  -- if $sub_set<id>(`{id_a*}`, `{id_b*}`)
  -- (if (typeIR_a_aligned
         = $find_map<id, typeIR>(`{(id_a ':' typeIR_a)*}`, id_a)))*
  -- (if (typeIR_b_non_default_aligned
