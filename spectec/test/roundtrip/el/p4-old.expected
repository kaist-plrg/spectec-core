;; === 5.13.2-typing-parser-state.spectec ===
rule ParserState_ok:
  TC_0 nameIR_state*
    |- annotationList STATE name `{parserStatementList transitionStatement}`
    : parserStateIR
  -- if nameIR = $name(name)
  -- if TC_1 = $enter(TC_0)
  -- if parserStatement* = $flatten_parserStatementList(parserStatementList)
  -- ParserStmts_ok: TC_1 |- parserStatement* : TC_2 parserStatementIR*
  -- ParserTransition_ok:
       TC_2 nameIR_state* |- transitionStatement : transitionStatementIR
  -- if TC_3 = $exit(TC_2)
  -- if parserStateIR
        = annotationList
          STATE
          nameIR
          `{parserStatementIR* transitionStatementIR}`

rule ParserStates_ok:
  TC |- parserState* : parserStateIR*
  -- (if (_ STATE name_state `{_ _}` = parserState))*
