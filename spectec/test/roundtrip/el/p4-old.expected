  -- if EXTERN_METHOD '->' typeIR_ret = TC.LOCAL.KIND

def $find_return_type(TC) = typeIR_ret
  -- if EXTERN_METHOD ABSTRACT '->' typeIR_ret = TC.LOCAL.KIND

