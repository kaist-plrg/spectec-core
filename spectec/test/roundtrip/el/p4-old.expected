builtin dec $to_int(int, int) : int

builtin dec $to_bitstr(int, int) : int

dec $to_number(value) : int

def $to_number(D i) = i

def $to_number(w S i) = $to_int(w, i)

def $to_number(w W i) = i

def $to_number(w V i '#' _) = i
;; === 2.2.1-type.spectec ===
syntax primitiveTypeIR =
  | VOID
  | BOOL
  | ERROR
  | MATCH_KIND
  | STRING

syntax numberTypeIR =
  | INT
  | INT `<nat>`
  | BIT `<nat>`
  | VARBIT `<nat>`

