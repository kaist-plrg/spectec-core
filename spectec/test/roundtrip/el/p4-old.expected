rule Cast_impl_canon_neq/seq-list:
  SEQ `<typeIR_a*>` -> LIST `<typeIR_b>`
  -- (Cast_impl: typeIR_a -> typeIR_b)*

rule Cast_impl_canon_neq/seq-tuple:
  SEQ `<typeIR_a*>` -> TUPLE `<typeIR_b*>`
  -- (Cast_impl: typeIR_a -> typeIR_b)*

rule Cast_impl_canon_neq/seq-stack:
