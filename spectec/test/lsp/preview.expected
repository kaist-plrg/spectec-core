--- SL ---
;; <test>/relation/eval.spectec:2:1-4:17:
syntax expr = 
   | enum nat (from expr)
   | eadd expr expr (from expr)
   | emul expr expr (from expr)

;; <test>/relation/eval.spectec:9:1-11:17:
relation Eval: expr

1. Case analysis on expr

  1. Case (% matches pattern `ENum %`)

    1. (Let (enum n) be expr)

    2. Result in n

  2. Case (% matches pattern `EAdd % %`)

    1. (Let (eadd e_1 e_2) be expr)

    2. (Eval: e_1 ==> n_1)

    3. (Eval: e_2 ==> n_2)

    4. Result in (n_1 + n_2)

  3. Case (% matches pattern `EMul % %`)

    1. (Let (emul e_1 e_2) be expr)

    2. (Eval: e_1 ==> n_1)

    3. (Eval: e_2 ==> n_2)

    4. Result in (n_1 * n_2)
