;; <test>/relation/eval.spectec:2:1-4:17:
syntax expr = 
   | enum nat (from expr)
   | eadd expr expr (from expr)
   | emul expr expr (from expr)

;; <test>/relation/eval.spectec:9:1-11:17:
relation Eval: expr==>%

1. Case analysis on expr

  1. Case (let enum n = % matches pattern `ENum %`)

    1. Result in n

  2. Case (let eadd e_1 e_2 = % matches pattern `EAdd % %`)

    1. (Eval: e_1 ==> n_1)

    2. (Eval: e_2 ==> n_2)

    3. Result in (n_1 + n_2)

  3. Case (let emul e_1 e_2 = % matches pattern `EMul % %`)

    1. (Eval: e_1 ==> n_1)

    2. (Eval: e_2 ==> n_2)

    3. Result in (n_1 * n_2)
