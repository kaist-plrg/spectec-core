;; <test>/relation/eval.spectec:2:1-4:17:
syntax expr = 
   | enum nat (from expr)
   | eadd expr expr (from expr)
   | emul expr expr (from expr)

;; <test>/relation/eval.spectec:9:1-11:17:
relation Eval: expr ==> nat

   ;; <test>/relation/eval.spectec:13:1-14:15:
   rule ENum: expr ==> n
      -- if expr matches `ENum %`
      -- let enum n = expr

   ;; <test>/relation/eval.spectec:16:1-19:23:
   rule EAdd: expr ==> (n_1 + n_2)
      -- if expr matches `EAdd % %`
      -- let eadd e_1 e_2 = expr
      -- rel Eval: e_1 ==> n_1
      -- rel Eval: e_2 ==> n_2

   ;; <test>/relation/eval.spectec:21:1-24:23:
   rule EMul: expr ==> (n_1 * n_2)
      -- if expr matches `EMul % %`
      -- let emul e_1 e_2 = expr
      -- rel Eval: e_1 ==> n_1
      -- rel Eval: e_2 ==> n_2
