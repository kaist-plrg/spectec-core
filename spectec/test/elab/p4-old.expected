   ;; ../../../../../spectec/specs/p4-old/6.08-instantiation-declaration.spectec:111:1-111:70:
   clause 0(nameIR, parameterIR*{parameterIR <- parameterIR*}) = nameIR ( $pid_IR(parameterIR)*{parameterIR <- parameterIR*} )

