 (target impty-recursion-il-pos.actual)
 (deps
  (source_tree ../../specs/impty/recursion)
  (source_tree ../../testdata/interp/impty/base)
  (source_tree ../../testdata/interp/impty/closure)
  (source_tree ../../testdata/interp/impty/recursion))
 (action
  (with-stdout-to
   %{target}
   (with-stderr-to
    impty-recursion-il-pos.err
    (run
     ./main.exe
     --impty
     --variant
     recursion
     -d
     ../../../../../spectec/testdata/interp/impty/base
     -d
     ../../../../../spectec/testdata/interp/impty/closure
     -d
     ../../../../../spectec/testdata/interp/impty/recursion)))))

(rule
 (alias impty-recursion-il-pos)
 (deps impty-recursion-il-pos.err impty-recursion-il-pos.actual)
 (action
  (diff impty-recursion-il-pos.expected impty-recursion-il-pos.actual)))

