(executable
 (name main)
 (preprocess
  (pps ppx_let))
 (libraries test_lib core core_unix core_unix.command_unix))

(rule
 (target impty-base.actual)
 (deps
  (source_tree ../../specs/impty/base))
 (action
  (with-stdout-to
   %{target}
   (with-stderr-to
    impty-base.err
    (run ./main.exe -s ../../../../../spectec/specs/impty/base)))))

(rule
 (alias runtest)
 (action
  (diff impty-base.expected impty-base.actual)))

