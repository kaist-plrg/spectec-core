# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.0.1"
synopsis: "Impty target for SpecTecX"
maintainer: ["kunjeong99@naver.com"]
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "5.1.0"}
  "spectec" {= version}
  "core" {>= "0.17.1"}
  "dune-site"
  "ppx_let"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@spectec/test/package/impty/runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
