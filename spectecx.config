# Project-local CLI defaults, read from the directory spectecx runs in.
# Keys are namespaced by target. See lib/cli/config_file.mli.

# Default corpus for each target's `batch` (overridable with --batch-dir).
p4.batch_dir = spectec/testdata/interp/p4/p4c
impty.batch_dir = spectec/testdata/interp/impty/base
